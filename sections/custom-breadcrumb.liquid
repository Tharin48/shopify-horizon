<section class="custom-blog-breadcrumb" {{ section.shopify_attributes }}>
  <div class="custom-blog-breadcrumb__inner">
    <nav aria-label="Breadcrumb">
      <ol class="custom-blog-breadcrumb__list" role="list">
        {% if section.settings.show_home %}
          <li class="custom-blog-breadcrumb__item">
            <a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a>
          </li>
        {% endif %}
        <li class="custom-blog-breadcrumb__item">
          <span aria-current="page">{{ page.title | escape }}</span>
        </li>
      </ol>
    </nav>
  </div>
</section>

{% stylesheet %}
  .custom-blog-breadcrumb {
    padding: 1.25rem 0 0;
    background: rgb(var(--color-background-rgb));
  }

  .custom-blog-breadcrumb__inner {
    width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .custom-blog-breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: rgb(var(--color-foreground-rgb) / 0.62);
    font-size: 0.9rem;
  }

  .custom-blog-breadcrumb__item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .custom-blog-breadcrumb__item:not(:last-child)::after {
    content: '/';
    color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  .custom-blog-breadcrumb__item a {
    color: inherit;
    text-decoration: none;
  }

  .custom-blog-breadcrumb__item a:hover,
  .custom-blog-breadcrumb__item a:focus-visible {
    color: rgb(var(--color-foreground-heading-rgb));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom breadcrumb",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_home",
      "label": "Show home link",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    }
  ],
  "presets": [
    {
      "name": "Custom breadcrumb"
    }
  ]
}
{% endschema %}
