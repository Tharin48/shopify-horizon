{% liquid
  assign products_limit = section.settings.products_limit
  assign active_tab_index = blank

  for block in section.blocks
    if block.type == 'teamakers-pick-tab' and block.settings.default_active and active_tab_index == blank
      assign active_tab_index = forloop.index0
    endif
  endfor

  if active_tab_index == blank
    for block in section.blocks
      if block.type == 'teamakers-pick-tab'
        assign active_tab_index = forloop.index0
        break
      endif
    endfor
  endif

%}

<section
  class="section section--{{ section.settings.section_width }} teamakers-pick"
  style="
    --tp-bg: {{ section.settings.background_color }};
    --tp-heading: {{ section.settings.heading_color }};
    --tp-tab-active: {{ section.settings.active_tab_color }};
    --tp-tab-inactive: {{ section.settings.inactive_tab_color }};
    --tp-card-text: {{ section.settings.card_text_color }};
    --tp-label-color: {{ section.settings.product_label_color }};
    --tp-title-color: {{ section.settings.product_title_color }};
    --tp-price-color: {{ section.settings.product_price_color }};
    --tp-review-color: {{ section.settings.review_text_color }};
    --tp-star-color: {{ section.settings.rating_star_color }};
    --tp-badge-bg: {{ section.settings.sale_badge_color }};
    --tp-columns-desktop: {{ section.settings.products_per_row_desktop }};
    --tp-columns-mobile: {{ section.settings.products_per_row_mobile }};
    --tp-img-radius: {{ section.settings.image_border_radius }}px;
    --tp-image-ratio: {{ section.settings.image_ratio }};
    --tp-image-border-color: {{ section.settings.product_image_border_color }};
    --tp-image-border-width: {{ section.settings.product_image_border_width }}px;
    --tp-decor-opacity: {{ section.settings.decorative_artwork_opacity | default: 35 }};
    --tp-decor-max-w: {{ section.settings.decorative_artwork_max_width | default: 140 }}px;
    --tp-mobile-tab-divider: {{ section.settings.mobile_tab_divider_color | default: '#c4c4c4' }};
    --tp-pad-top: {{ section.settings.padding-block-start }}px;
    --tp-pad-bottom: {{ section.settings.padding-block-end }}px;
    --tp-pad-x: {{ section.settings.padding_x_desktop }}px;
    --tp-pad-x-mobile: {{ section.settings.padding_x_mobile }}px;
  "
  data-teamakers-pick
  data-section-id="{{ section.id }}"
>
  <div class="teamakers-pick__container">
    <div class="teamakers-pick__top-row">

      <div class="teamakers-pick__header">
        {% if section.settings.heading != blank %}
          <h2 class="teamakers-pick__title">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>

      <div class="teamakers-pick__tabs-wrap">
        <div class="teamakers-pick__tabs" role="tablist" aria-label="Collection filters">
          {% for block in section.blocks %}
            {% if block.type == 'teamakers-pick-tab' %}
              {% assign tab_label = block.settings.label | strip %}
              {% if tab_label == blank %}
                {% assign tab_label = block.settings.collection.title %}
              {% endif %}
              {% if tab_label == blank %}
                {% assign tab_label = 'Tab ' | append: forloop.index %}
              {% endif %}
              {% assign tab_index = forloop.index0 %}
              <button
                type="button"
                class="teamakers-pick__tab{% if tab_index == active_tab_index %} is-active{% endif %}"
                role="tab"
                aria-selected="{% if tab_index == active_tab_index %}true{% else %}false{% endif %}"
                aria-controls="teamakers-pick-panel-{{ section.id }}-{{ tab_index }}"
                id="teamakers-pick-tab-{{ section.id }}-{{ tab_index }}"
                data-tab-target="{{ tab_index }}"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.icon != blank %}
                  {{
                    block.settings.icon
                    | image_url: width: 32
                    | image_tag: loading: 'lazy', widths: '16,24,32', sizes: '16px', class: 'teamakers-pick__tab-icon', alt: ''
                  }}
                {% endif %}
                <span>{{ tab_label | escape }}</span>
                {% if block.settings.badge_text != blank %}
                  <span class="teamakers-pick__tab-badge">{{ block.settings.badge_text | escape }}</span>
                {% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="teamakers-pick__panels">
      {% for block in section.blocks %}
        {% if block.type == 'teamakers-pick-tab' %}
          {% assign tab_collection = block.settings.collection %}
          {% assign panel_index = forloop.index0 %}
          <div
            id="teamakers-pick-panel-{{ section.id }}-{{ panel_index }}"
            class="teamakers-pick__panel{% if panel_index == active_tab_index %} is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="teamakers-pick-tab-{{ section.id }}-{{ panel_index }}"
            data-panel="{{ panel_index }}"
            {% unless panel_index == active_tab_index %}
              hidden
            {% endunless %}
          >
            <div class="teamakers-pick__products">
              {% if tab_collection != blank and tab_collection.products_count > 0 %}
                {% for product in tab_collection.products limit: products_limit %}
                  {% assign first_variant = product.selected_or_first_available_variant %}
                  <article class="teamakers-pick__card">
                    <a class="teamakers-pick__card-link" href="{{ product.url }}">
                      <div class="teamakers-pick__image-wrap">
                        {% if product.available == false %}
                          <span class="teamakers-pick__pill teamakers-pick__pill--oos">Out of stock</span>
                        {% elsif section.settings.show_sale_badge and product.compare_at_price > product.price %}
                          <span class="teamakers-pick__pill teamakers-pick__pill--sale">Sale</span>
                        {% endif %}

                        {% if product.featured_media != blank %}
                          {{
                            product.featured_media
                            | image_url: width: 900
                            | image_tag:
                              loading: 'lazy',
                              widths: '320,480,640,800,900',
                              sizes: '(max-width: 989px) 44vw, 20vw',
                              class: 'teamakers-pick__image',
                              alt: product.title
                          }}
                        {% else %}
                          {{ 'product-apparel-1' | placeholder_svg_tag: 'teamakers-pick__image teamakers-pick__image-placeholder' }}
                        {% endif %}

                        {% if section.settings.show_quick_add and first_variant != blank %}
                          <form method="post" action="{{ routes.cart_add_url }}" class="teamakers-pick__quick-add-form">
                            <input type="hidden" name="id" value="{{ first_variant.id }}">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="teamakers-pick__quick-add" aria-label="Add {{ product.title | escape }} to cart">
                              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M6.5 7.5h11l-1.2 10.2a1 1 0 0 1-1 .8H8.7a1 1 0 0 1-1-.8L6.5 7.5Z" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M9 7.5V6a3 3 0 1 1 6 0v1.5" stroke="currentColor" stroke-width="1.5"/>
                              </svg>
                            </button>
                          </form>
                        {% endif %}
                      </div>
                    </a>

                    <div class="teamakers-pick__meta">
                      {% if section.settings.show_vendor and product.vendor != blank %}
                        <p class="teamakers-pick__vendor">{{ product.vendor }}</p>
                      {% endif %}

                      <h3 class="teamakers-pick__name">
                        <a href="{{ product.url }}">{{ product.title }}</a>
                      </h3>

                      {% if section.settings.show_ratings %}
                        {% assign rating_value = product.metafields.reviews.rating.value %}
                        {% assign rating_count = product.metafields.reviews.rating_count %}
                        {% if rating_value != blank %}
                        <p class="teamakers-pick__rating">
                          <span class="teamakers-pick__rating-stars" aria-hidden="true">★★★★★</span>
                          <span class="teamakers-pick__rating-value">{{ rating_value }}</span>
                          {% if rating_count != blank %}
                            <span class="teamakers-pick__rating-count">({{ rating_count }})</span>
                          {% endif %}
                        </p>
                        {% endif %}
                      {% endif %}

                      <p class="teamakers-pick__price">
                        {{ product.price | money }}
                        {% if product.compare_at_price > product.price %}
                          <s class="teamakers-pick__compare">{{ product.compare_at_price | money }}</s>
                        {% endif %}
                      </p>
                    </div>
                  </article>
                {% endfor %}
              {% else %}
                {% for i in (1..products_limit) %}
                  <article class="teamakers-pick__card">
                    <div class="teamakers-pick__image-wrap">
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'teamakers-pick__image teamakers-pick__image-placeholder' }}
                    </div>
                    <div class="teamakers-pick__meta">
                      <p class="teamakers-pick__vendor">Tea label</p>
                      <p class="teamakers-pick__name">Product title</p>
                      <p class="teamakers-pick__rating">
                        <span class="teamakers-pick__rating-stars" aria-hidden="true">★★★★★</span>
                        <span class="teamakers-pick__rating-value">4.5</span>
                        <span class="teamakers-pick__rating-count">(0)</span>
                      </p>
                      <p class="teamakers-pick__price">{{ 5000 | money }}</p>
                    </div>
                  </article>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>

  {% if section.settings.show_decorative_artwork and section.settings.decorative_artwork != blank %}
    <div
      class="teamakers-pick__decor{% if section.settings.decorative_artwork_position == 'center-right' %} teamakers-pick__decor--center-right{% endif %}"
      aria-hidden="true"
    >
      {{
        section.settings.decorative_artwork
        | image_url: width: 360
        | image_tag: loading: 'lazy', widths: '120,180,240,300,360', sizes: '(max-width: 989px) 28vw, 12vw', alt: ''
      }}
    </div>
  {% endif %}
</section>

<script>
  (() => {
    const root = document.querySelector('[data-teamakers-pick][data-section-id="{{ section.id }}"]');
    if (!root) return;

    const tabs = root.querySelectorAll('[data-tab-target]');
    const panels = root.querySelectorAll('[data-panel]');
    const tabsWrap = root.querySelector('.teamakers-pick__tabs-wrap');
    if (!tabs.length || !panels.length) return;

    const activate = (tabId) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.tabTarget === tabId;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const isActive = panel.dataset.panel === tabId;
        panel.classList.toggle('is-active', isActive);
        panel.hidden = !isActive;
      });
    };

    tabs.forEach((tab) => tab.addEventListener('click', () => activate(tab.dataset.tabTarget)));

    /* Mouse-drag scroll for desktop (touch scroll is handled natively by CSS) */
    if (tabsWrap) {
      let mouseDown = false;
      let startX = 0;
      let startScrollLeft = 0;
      let moved = false;

      tabsWrap.addEventListener('mousedown', (e) => {
        mouseDown = true;
        moved = false;
        startX = e.clientX;
        startScrollLeft = tabsWrap.scrollLeft;
        tabsWrap.style.cursor = 'grabbing';
      });

      window.addEventListener('mousemove', (e) => {
        if (!mouseDown) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 3) {
          moved = true;
          tabsWrap.scrollLeft = startScrollLeft - dx;
        }
      });

      window.addEventListener('mouseup', () => {
        mouseDown = false;
        tabsWrap.style.cursor = '';
      });

      /* Prevent click on tab if we were dragging */
      tabs.forEach((tab) => {
        tab.addEventListener('click', (e) => {
          if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
        });
      });
    }
  })();
</script>

{% stylesheet %}

  /* ─────────────────────────────────────────
     SECTION SHELL
     overflow-x: clip stops decorative artwork
     causing a page scrollbar WITHOUT creating
     a Block Formatting Context (unlike hidden).
     This means child overflow-x: auto scroll
     containers work freely inside this section.
  ───────────────────────────────────────── */
  .teamakers-pick {
    background: var(--tp-bg, #faf8f5);
    position: relative;
    overflow-x: clip;
    padding-top: var(--tp-pad-top, 32px);
    padding-bottom: var(--tp-pad-bottom, 32px);
  }

  /* Container — plain block, no grid */
  .teamakers-pick__container {
    padding-inline: var(--tp-pad-x, clamp(1rem, 2.5vw, 2.5rem));
    position: relative;
    z-index: 1;
  }

  /* ── TOP ROW — flex row: title left, tabs right ── */
  .teamakers-pick__top-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .teamakers-pick__header {
    flex-shrink: 0;
  }

  .teamakers-pick__title {
    margin: 0;
    color: var(--tp-heading, rgb(var(--color-foreground-heading)));
    text-align: left;
  }

  /* ─────────────────────────────────────────
     TABS WRAPPER — desktop
     Flex item inside top-row. min-width:0 lets
     it shrink so overflow-x:auto can scroll.
  ───────────────────────────────────────── */
  .teamakers-pick__tabs-wrap {
    min-width: 0;
    overflow-x: auto;
    padding-bottom: 0.2rem;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground)) rgb(var(--color-foreground) / 0.16);
  }

  .teamakers-pick__tabs-wrap::-webkit-scrollbar { height: 0.2rem; }
  .teamakers-pick__tabs-wrap::-webkit-scrollbar-track { background: rgb(var(--color-foreground) / 0.16); }
  .teamakers-pick__tabs-wrap::-webkit-scrollbar-thumb { background: rgb(var(--color-foreground)); }

  .teamakers-pick__tabs {
    display: inline-flex;
    gap: 1rem;
    min-width: max-content;
  }

  .teamakers-pick__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    background: transparent;
    color: var(--tp-tab-inactive, rgb(var(--color-foreground)));
    cursor: pointer;
    white-space: nowrap;
    font: inherit;
    padding: 0.25rem 0;
  }

  .teamakers-pick__tab.is-active {
    color: var(--tp-tab-active, rgb(var(--color-primary)));
  }

  .teamakers-pick__tab-icon {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }

  .teamakers-pick__tab-badge {
    font-size: 0.72rem;
    border-radius: 999px;
    background: rgb(var(--color-foreground) / 0.08);
    padding: 0.1rem 0.45rem;
  }

  /* ─────────────────────────────────────────
     PANELS
  ───────────────────────────────────────── */
  .teamakers-pick__panel {
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .teamakers-pick__panel.is-active {
    opacity: 1;
  }

  /* ─────────────────────────────────────────
     PRODUCT GRID
  ───────────────────────────────────────── */
  .teamakers-pick__products {
    display: grid;
    grid-template-columns: repeat(var(--tp-columns-desktop, 5), minmax(0, 1fr));
    gap: 1rem;
  }

  .teamakers-pick__card {
    min-width: 0;
    color: var(--tp-card-text, rgb(var(--color-foreground)));
  }

  .teamakers-pick__card-link {
    text-decoration: none;
    color: inherit;
  }

  .teamakers-pick__image-wrap {
    position: relative;
    border-radius: var(--tp-img-radius, 10px);
    overflow: hidden;
    background: rgb(var(--color-foreground) / 0.04);
    aspect-ratio: var(--tp-image-ratio, 4 / 5);
    border: var(--tp-image-border-width, 1px) solid var(--tp-image-border-color, rgb(var(--color-foreground) / 0.14));
  }

  .teamakers-pick__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .teamakers-pick__card:hover .teamakers-pick__image {
    transform: scale(1.04);
  }

  .teamakers-pick__pill {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 2;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
  }

  .teamakers-pick__pill--sale {
    background: var(--tp-badge-bg, #b08a2f);
    color: #fff;
  }

  .teamakers-pick__pill--oos {
    background: #2e2e2e;
    color: #fff;
  }

  .teamakers-pick__quick-add-form {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 2;
  }

  .teamakers-pick__quick-add {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    border: 0;
    background: #fff;
    color: #111;
    display: grid;
    place-items: center;
    box-shadow: 0 0.2rem 0.6rem rgb(0 0 0 / 0.12);
    cursor: pointer;
  }

  .teamakers-pick__quick-add svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* ─────────────────────────────────────────
     CARD META
  ───────────────────────────────────────── */
  .teamakers-pick__meta {
    margin-top: 0.65rem;
  }

  .teamakers-pick__vendor {
    margin: 0 0 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
    color: var(--tp-label-color, var(--tp-tab-active, #b08a2f));
    font-weight: 400;
  }

  .teamakers-pick__name {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.3;
    min-height: 2.5em;
    color: var(--tp-title-color, var(--tp-card-text, rgb(var(--color-foreground))));
  }

  .teamakers-pick__name a {
    color: inherit;
    text-decoration: none;
  }

  .teamakers-pick__rating {
    margin: 0.35rem 0 0;
    font-size: 0.74rem;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    color: var(--tp-review-color, rgb(var(--color-foreground) / 0.62));
  }

  .teamakers-pick__rating-stars,
  .teamakers-pick__rating-value {
    color: var(--tp-star-color, var(--tp-tab-active, #b08a2f));
  }

  .teamakers-pick__price {
    margin: 0.32rem 0 0;
    font-weight: 600;
    color: var(--tp-price-color, var(--tp-card-text, rgb(var(--color-foreground))));
  }

  .teamakers-pick__compare {
    margin-inline-start: 0.35rem;
    opacity: 0.65;
    font-weight: 400;
  }

  /* ─────────────────────────────────────────
     DECORATIVE ARTWORK
  ───────────────────────────────────────── */
  .teamakers-pick__decor {
    position: absolute;
    right: 0;
    bottom: -0.2rem;
    width: min(12vw, var(--tp-decor-max-w, 140px));
    max-width: 100%;
    opacity: calc(var(--tp-decor-opacity, 35) / 100);
    pointer-events: none;
  }

  .teamakers-pick__decor--center-right {
    top: 50%;
    bottom: auto;
    transform: translateY(-50%);
  }

  .teamakers-pick__decor img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ─────────────────────────────────────────
     MOBILE  ≤ 989px
  ───────────────────────────────────────── */
  @media screen and (max-width: 989px) {

    .teamakers-pick__container {
      padding-inline: var(--tp-pad-x-mobile, clamp(1rem, 2.5vw, 2.5rem));
    }

    /* ── top-row: stack title above tabs on mobile ── */
    .teamakers-pick__top-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 0;
    }

    .teamakers-pick__header {
      margin-bottom: 0;
    }

    /* tabs-wrap: flex item in a COLUMN flex → align-self:stretch
       fills full width, min-width:0 prevents growing beyond parent,
       overflow-x:scroll scrolls the pills that exceed that width    */
    .teamakers-pick__tabs-wrap {
      align-self: stretch;
      min-width: 0;
      width: 100%;
      overflow-x: scroll;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x;
      overscroll-behavior-x: contain;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--tp-mobile-tab-divider, #c4c4c4);
      margin-bottom: 1rem;
      scrollbar-width: none;
      scrollbar-color: unset;
      -ms-overflow-style: none;
    }

    .teamakers-pick__tabs-wrap::-webkit-scrollbar { display: none; }

    .teamakers-pick__tabs {
      display: flex;
      flex-wrap: nowrap;
      gap: 0.6rem;
      min-width: max-content;
      padding-inline-end: 1rem;
    }

    .teamakers-pick__tab {
      flex: 0 0 auto;
      border: 1.5px solid #d7d7d7;
      border-radius: 999px;
      padding: 6px 14px;
      line-height: 1.3;
      background: #fff;
      font-size: 0.875rem;
      font-weight: 500;
      white-space: nowrap;
      color: var(--tp-tab-inactive, #3f3f3f);
    }

    .teamakers-pick__tab.is-active {
      color: var(--tp-tab-active, #b08a2f);
      border-color: #c9b87a;
      background: #fffdf5;
      font-weight: 600;
    }

    .teamakers-pick__tab-icon,
    .teamakers-pick__tab-badge { display: none; }

    /* ── PRODUCT GRID — horizontal 2-card swipe ─────────────────────
       Cards are sized as a % of the container's content box (which
       already has the correct padding-inline applied). No negative-
       margin breakout needed — the container padding is naturally
       respected and the first card aligns with all other content.
    ────────────────────────────────────────────────────────────────── */
    .teamakers-pick__products {
      grid-template-columns: none;       /* ← CRITICAL: clear desktop value */
      grid-auto-flow: column;
      grid-auto-columns: calc(50% - 0.375rem); /* 2 cards, gap 0.75rem */
      gap: 0.75rem;
      overflow-x: auto;
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      padding-bottom: 2.5rem;
      scrollbar-width: thin;
      scrollbar-color: #000000 transparent;
    }

    .teamakers-pick__products::-webkit-scrollbar { height: 2px; }
    .teamakers-pick__products::-webkit-scrollbar-track { background: transparent; }
    .teamakers-pick__products::-webkit-scrollbar-thumb {
      background: #000000;
      border-radius: 999px;
    }

    .teamakers-pick__card {
      scroll-snap-align: start;
      min-width: 0;
    }

    .teamakers-pick__name {
      font-size: 0.88rem;
      min-height: 0;
      line-clamp: 3;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .teamakers-pick__vendor { font-size: 0.65rem; }
    .teamakers-pick__rating { font-size: 0.72rem; gap: 0.25rem; }
    .teamakers-pick__price  { font-size: 1rem; }
  }

  /* card-width is computed via 100vw in the 989px block, so no override needed */

{% endstylesheet %}

{% schema %}
{
  "name": "Teamaker's pick",
  "class": "teamakers-pick-section",
  "tag": "section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "teamakers-pick-tab",
      "name": "Filter tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Filter name", "default": "Best Sellers" },
        { "type": "collection", "id": "collection", "label": "Filter collection" },
        { "type": "text", "id": "badge_text", "label": "Optional badge text" },
        { "type": "image_picker", "id": "icon", "label": "Optional tab icon" },
