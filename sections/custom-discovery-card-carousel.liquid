<section
  class="
    custom-discovery-card-carousel
    custom-discovery-card-carousel--{{ section.settings.section_width_mode }}
    {% if section.settings.show_desktop_peek %}custom-discovery-card-carousel--desktop-peek{% else %}custom-discovery-card-carousel--desktop-no-peek{% endif %}
  "
  {% if section.settings.range_tab_key != blank %}data-range-panel-key="{{ section.settings.range_tab_key | escape }}"{% endif %}
  style="
    --custom-discovery-card-carousel-max-width: {{ section.settings.max_width }}px;
    --custom-discovery-card-carousel-background: {{ section.settings.background_color }};
    --custom-discovery-card-carousel-card-background: {{ section.settings.card_background_color }};
    --custom-discovery-card-carousel-heading: {{ section.settings.heading_color }};
    --custom-discovery-card-carousel-body: {{ section.settings.body_color }};
    --custom-discovery-card-carousel-accent: {{ section.settings.accent_color }};
    --custom-discovery-card-carousel-border: {{ section.settings.border_color }};
    --custom-discovery-card-carousel-card-width: {{ section.settings.desktop_card_width }}px;
    --custom-discovery-card-carousel-card-width-mobile: {{ section.settings.mobile_card_width }}px;
    --custom-discovery-card-carousel-card-height: {{ section.settings.card_height }}px;
    --custom-discovery-card-carousel-card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --custom-discovery-card-carousel-radius: {{ section.settings.card_radius }}px;
    --custom-discovery-card-carousel-gap: {{ section.settings.desktop_gap }}px;
    --custom-discovery-card-carousel-gap-mobile: {{ section.settings.mobile_gap }}px;
    --custom-discovery-card-carousel-padding-top: {{ section.settings.padding_top }}px;
    --custom-discovery-card-carousel-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-discovery-card-carousel-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-discovery-card-carousel-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-discovery-card-carousel-content-padding: {{ section.settings.card_content_padding }}px;
    --custom-discovery-card-carousel-content-padding-mobile: {{ section.settings.card_content_padding_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-discovery-card-carousel__inner">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <header class="custom-discovery-card-carousel__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-discovery-card-carousel__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="custom-discovery-card-carousel__intro">
            {{ section.settings.intro | escape | newline_to_br }}
          </div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="custom-discovery-card-carousel__viewport" aria-label="{{ section.settings.heading | default: 'Carousel' | escape }}">
      <div class="custom-discovery-card-carousel__track">
        {%- for block in section.blocks -%}
          <article class="custom-discovery-card-carousel__card" {{ block.shopify_attributes }}>
            <div class="custom-discovery-card-carousel__media">
              {%- if block.settings.mobile_image != blank -%}
                <picture>
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ block.settings.mobile_image | image_url: width: 480 }} 480w,
                      {{ block.settings.mobile_image | image_url: width: 720 }} 720w,
                      {{ block.settings.mobile_image | image_url: width: 960 }} 960w
                    "
                    sizes="100vw"
                  >
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 2200
                      | image_tag:
                        loading: 'lazy',
                        widths: '320,480,640,800,960,1200,1600,2000,2200',
                        sizes: '(min-width: 1200px) 26vw, (min-width: 750px) 34vw, 78vw',
                        class: 'custom-discovery-card-carousel__image',
                        alt: block.settings.image.alt
                    }}
                  {%- else -%}
                    {{
                      block.settings.mobile_image
                      | image_url: width: 2200
                      | image_tag:
                        loading: 'lazy',
                        widths: '320,480,640,800,960,1200,1600,2000,2200',
                        sizes: '(min-width: 1200px) 26vw, (min-width: 750px) 34vw, 78vw',
                        class: 'custom-discovery-card-carousel__image',
                        alt: block.settings.mobile_image.alt
                    }}
                  {%- endif -%}
                </picture>
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 2200
                  | image_tag:
                    loading: 'lazy',
                    widths: '320,480,640,800,960,1200,1600,2000,2200',
                    sizes: '(min-width: 1200px) 26vw, (min-width: 750px) 34vw, 78vw',
                    class: 'custom-discovery-card-carousel__image',
                    alt: block.settings.image.alt
                }}
              {%- else -%}
                <div class="custom-discovery-card-carousel__empty">Choose an image</div>
              {%- endif -%}
            </div>

            <div class="custom-discovery-card-carousel__overlay"></div>

            <div class="custom-discovery-card-carousel__content">
              <div class="custom-discovery-card-carousel__copy">
                {%- if block.settings.heading != blank -%}
                  <h3 class="custom-discovery-card-carousel__card-heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="custom-discovery-card-carousel__card-subheading">{{ block.settings.subheading | escape }}</p>
                {%- endif -%}
              </div>

              {%- if block.settings.button_label != blank -%}
                {%- if block.settings.link_url != blank -%}
                  <a class="custom-discovery-card-carousel__button" href="{{ block.settings.link_url }}">
                    <span>{{ block.settings.button_label | escape }}</span>
                    <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
                      {% render 'icon', icon: 'arrow' %}
                    </svg>
                  </a>
                {%- else -%}
                  <span class="custom-discovery-card-carousel__button custom-discovery-card-carousel__button--static">
                    <span>{{ block.settings.button_label | escape }}</span>
                    <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
                      {% render 'icon', icon: 'arrow' %}
                    </svg>
                  </span>
                {%- endif -%}
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}

        {%- if section.blocks.size == 0 and request.design_mode -%}
          <div class="custom-discovery-card-carousel__empty custom-discovery-card-carousel__empty--section">
            Add card blocks to build this carousel.
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-discovery-card-carousel {
    background: var(--custom-discovery-card-carousel-background);
  }

  .custom-discovery-card-carousel__inner {
    margin: 0 auto;
    max-width: var(--custom-discovery-card-carousel-max-width);
    padding:
      var(--custom-discovery-card-carousel-padding-top-mobile)
      16px
      var(--custom-discovery-card-carousel-padding-bottom-mobile);
  }

  .custom-discovery-card-carousel--full-width .custom-discovery-card-carousel__inner {
    max-width: none;
  }

  .custom-discovery-card-carousel__header {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .custom-discovery-card-carousel__heading {
    color: var(--custom-discovery-card-carousel-heading);
    margin: 0;
  }

  .custom-discovery-card-carousel__intro {
    color: var(--custom-discovery-card-carousel-body);
    line-height: 1.55;
    margin: 0.75rem auto 0;
    max-width: 44rem;
  }

  .custom-discovery-card-carousel__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    margin-inline-end: -16px;
    padding-inline: 0 16px;
    scroll-padding-inline-start: 0;
    scrollbar-width: none;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
  }

  .custom-discovery-card-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .custom-discovery-card-carousel__track {
    display: flex;
    gap: var(--custom-discovery-card-carousel-gap-mobile);
    min-width: max-content;
    padding-inline-end: 0;
  }

  .custom-discovery-card-carousel__card {
    background: var(--custom-discovery-card-carousel-card-background);
    border-radius: var(--custom-discovery-card-carousel-radius);
    flex: 0 0 clamp(190px, calc(100vw - 84px), 280px);
    height: var(--custom-discovery-card-carousel-card-height-mobile);
    max-width: clamp(190px, calc(100vw - 84px), 280px);
    overflow: hidden;
    position: relative;
    scroll-snap-align: start;
  }

  .custom-discovery-card-carousel__media,
  .custom-discovery-card-carousel__overlay,
  .custom-discovery-card-carousel__content {
    inset: 0;
    position: absolute;
  }

  .custom-discovery-card-carousel__overlay {
    background:
      linear-gradient(180deg, rgb(255 253 248 / 0.07) 0%, rgb(255 253 248 / 0) 28%, rgb(31 24 18 / 0.12) 100%),
      linear-gradient(180deg, rgb(255 253 248 / 0.04), rgb(255 253 248 / 0));
    z-index: 1;
  }

  .custom-discovery-card-carousel__content {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--custom-discovery-card-carousel-content-padding-mobile);
    text-align: center;
    z-index: 2;
  }

  .custom-discovery-card-carousel__copy {
    min-height: 3.35rem;
  }

  .custom-discovery-card-carousel__card-heading {
    color: var(--custom-discovery-card-carousel-heading);
    font-size: 16px;
    line-height: 1.2;
    margin: 0;
  }

  .custom-discovery-card-carousel__card-subheading {
    color: var(--custom-discovery-card-carousel-body);
    font-size: 0.58rem;
    line-height: 1.3;
    margin: 0.25rem 0 0;
  }

  .custom-discovery-card-carousel__media {
    background: var(--custom-discovery-card-carousel-card-background);
  }

  .custom-discovery-card-carousel__media picture,
  .custom-discovery-card-carousel__image {
    display: block;
    height: 100%;
    width: 100%;
  }

  .custom-discovery-card-carousel__image {
    object-fit: cover;
    transform: scale(1);
    transition: transform 320ms ease;
  }

  .custom-discovery-card-carousel__button {
    align-items: center;
    border: 1px solid var(--custom-discovery-card-carousel-border);
    border-radius: 999px;
    color: var(--custom-discovery-card-carousel-heading);
    display: inline-flex;
    font-size: 0.7rem;
    gap: 0.35rem;
    justify-content: center;
    min-height: 2rem;
    min-width: 4.75rem;
    padding: 0.3rem 0.72rem;
    text-decoration: none;
    width: fit-content;
    margin-inline: auto;
    background: rgb(255 253 248 / 0.84);
  }

  .custom-discovery-card-carousel__button svg {
    display: block;
    height: 0.9rem;
    width: 0.9rem;
  }

  .custom-discovery-card-carousel__button--static {
    cursor: default;
  }

  .custom-discovery-card-carousel__empty {
    align-items: center;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.18);
    color: rgb(var(--color-foreground-rgb) / 0.66);
    display: flex;
    justify-content: center;
    height: 100%;
    padding: 1rem;
    width: 100%;
  }

  .custom-discovery-card-carousel__empty--section {
    min-width: min(100%, 24rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .custom-discovery-card-carousel__card:hover .custom-discovery-card-carousel__image,
    .custom-discovery-card-carousel__card:focus-within .custom-discovery-card-carousel__image {
      transform: scale(1.06);
    }
  }

  @media screen and (min-width: 750px) {
    .custom-discovery-card-carousel__inner {
      padding:
        var(--custom-discovery-card-carousel-padding-top)
        48px
        var(--custom-discovery-card-carousel-padding-bottom);
    }

    .custom-discovery-card-carousel__viewport {
      padding-inline: max(32px, calc((100vw - var(--custom-discovery-card-carousel-max-width)) / 2 + 32px));
    }

    .custom-discovery-card-carousel__track {
      gap: var(--custom-discovery-card-carousel-gap);
      padding-inline-end: 0;
    }

    .custom-discovery-card-carousel__card {
      flex-basis: calc(
        (
          min(100vw, var(--custom-discovery-card-carousel-max-width))
          - 64px
          - (var(--custom-discovery-card-carousel-gap) * 3)
        ) / 4
      );
      height: var(--custom-discovery-card-carousel-card-height);
      max-width: none;
    }

    .custom-discovery-card-carousel--desktop-no-peek .custom-discovery-card-carousel__viewport {
      overflow-x: hidden;
      padding-inline: 0;
    }

    .custom-discovery-card-carousel--desktop-no-peek .custom-discovery-card-carousel__track {
      min-width: 0;
      width: 100%;
    }

    .custom-discovery-card-carousel--desktop-no-peek .custom-discovery-card-carousel__card {
      flex: 1 1 calc((100% - (var(--custom-discovery-card-carousel-gap) * 3)) / 4);
    }

    .custom-discovery-card-carousel--desktop-peek .custom-discovery-card-carousel__card {
      flex-basis: calc(
        (
          min(100vw, var(--custom-discovery-card-carousel-max-width))
          - 64px
          - (var(--custom-discovery-card-carousel-gap) * 4)
          - 84px
        ) / 4
      );
    }

    .custom-discovery-card-carousel__content {
      padding: var(--custom-discovery-card-carousel-content-padding);
    }

    .custom-discovery-card-carousel__card-heading {
      font-size: 20px;
    }
  }

  @media screen and (min-width: 750px) {
    .custom-discovery-card-carousel--full-width .custom-discovery-card-carousel__viewport {
      padding-inline: 32px;
    }

    .custom-discovery-card-carousel--full-width .custom-discovery-card-carousel__card {
      flex-basis: var(--custom-discovery-card-carousel-card-width);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Discovery card carousel",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "text",
      "id": "range_tab_key",
      "label": "Range tab key",
      "info": "Match a tab target key from the Range Hero to show this section when that pill is selected."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "section_width_mode",
      "label": "Section width",
      "default": "contained",
      "options": [
        { "value": "contained", "label": "Contained" },
        { "value": "full-width", "label": "Full width" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_desktop_peek",
      "label": "Show clipped next card on desktop",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#f7ede6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1f1812"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#4b4137"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#b08a2f"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Button border color",
      "default": "#7f7468"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "desktop_card_width",
      "label": "Desktop card width",
      "min": 160,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Mobile card width",
      "min": 160,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Desktop card height",
      "min": 240,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "label": "Mobile card height",
      "min": 220,
      "max": 460,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_content_padding",
      "label": "Card padding",
      "min": 12,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_content_padding_mobile",
      "label": "Card padding mobile",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card title"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Short supporting text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Discover"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discovery card carousel",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
