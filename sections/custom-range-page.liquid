{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign intro_content = section.settings.intro

  if intro_content == blank and page.content != blank
    assign intro_content = page.content
  endif

  assign hero_image = section.settings.hero_image
  assign hero_mobile_image = section.settings.hero_mobile_image
  assign hero_image_alt = hero_image.alt | default: heading
-%}

<section
  class="custom-range-page section-wrapper"
  style="
    --custom-range-page-max-width: {{ section.settings.max_width }}px;
    --custom-range-page-padding-top: {{ section.settings.padding_top }}px;
    --custom-range-page-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-range-page-padding-inline: {{ section.settings.padding_inline }}px;
    --custom-range-page-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-range-page-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-range-page-padding-inline-mobile: {{ section.settings.padding_inline_mobile }}px;
    --custom-range-page-accent: {{ section.settings.accent_color }};
    --custom-range-page-background: {{ section.settings.background_color }};
    --custom-range-page-text: {{ section.settings.text_color }};
    --custom-range-page-hero-radius: {{ section.settings.hero_radius }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-range-page__inner page-width">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="custom-range-page__breadcrumb" aria-label="Breadcrumb">
        <ol class="custom-range-page__breadcrumb-list" role="list">
          <li class="custom-range-page__breadcrumb-item">
            <a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a>
          </li>
          <li class="custom-range-page__breadcrumb-item" aria-current="page">
            <span>{{ page.title | escape }}</span>
          </li>
        </ol>
      </nav>
    {%- endif -%}

    <div class="custom-range-page__hero">
      <div class="custom-range-page__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="custom-range-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if heading != blank -%}
          <h1 class="custom-range-page__title">{{ heading | escape }}</h1>
        {%- endif -%}

        {%- if intro_content != blank -%}
          <div class="custom-range-page__intro rte">
            {{ intro_content }}
          </div>
        {%- elsif request.design_mode -%}
          <div class="custom-range-page__placeholder">
            Add an intro or page content to start building the Range page hero.
          </div>
        {%- endif -%}
      </div>

      <div class="custom-range-page__media">
        {%- if hero_image != blank -%}
          <picture>
            {%- if hero_mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ hero_mobile_image | image_url: width: 480 }} 480w,
                  {{ hero_mobile_image | image_url: width: 720 }} 720w,
                  {{ hero_mobile_image | image_url: width: 960 }} 960w
                "
                sizes="100vw"
              >
            {%- endif -%}
            {{
              hero_image
              | image_url: width: 1800
              | image_tag:
                class: 'custom-range-page__media-image',
                loading: 'eager',
                widths: '600,900,1200,1500,1800',
                sizes: '(min-width: 990px) 58vw, 100vw',
                alt: hero_image_alt
            }}
          </picture>
        {%- elsif request.design_mode -%}
          <div class="custom-range-page__media-placeholder">
            Select a hero image for the Range page.
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-range-page {
    background: var(--custom-range-page-background);
    color: var(--custom-range-page-text);
  }

  .custom-range-page__inner {
    max-width: var(--custom-range-page-max-width);
    padding-block: var(--custom-range-page-padding-top) var(--custom-range-page-padding-bottom);
    padding-inline: var(--custom-range-page-padding-inline);
  }

  .custom-range-page__breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.8125rem;
  }

  .custom-range-page__breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .custom-range-page__breadcrumb-item {
    align-items: center;
    color: rgba(43, 42, 40, 0.74);
    display: inline-flex;
    gap: 0.375rem;
  }

  .custom-range-page__breadcrumb-item + .custom-range-page__breadcrumb-item::before {
    color: var(--custom-range-page-accent);
    content: "/";
  }

  .custom-range-page__breadcrumb a {
    color: var(--custom-range-page-accent);
    text-decoration: none;
  }

  .custom-range-page__hero {
    align-items: center;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .custom-range-page__copy {
    max-width: 34rem;
  }

  .custom-range-page__eyebrow {
    color: var(--custom-range-page-accent);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    margin: 0 0 0.875rem;
    text-transform: uppercase;
  }

  .custom-range-page__title {
    font-size: clamp(2rem, 2.4vw, 3.5rem);
    line-height: 1.08;
    margin: 0;
  }

  .custom-range-page__intro {
    font-size: 1rem;
    line-height: 1.7;
    margin-top: 1rem;
    max-width: 32rem;
  }

  .custom-range-page__media,
  .custom-range-page__media-placeholder {
    background: linear-gradient(180deg, rgba(255, 250, 241, 0.9), rgba(248, 240, 227, 0.95));
    border-radius: var(--custom-range-page-hero-radius);
    min-height: 24rem;
    overflow: hidden;
  }

  .custom-range-page__media {
    position: relative;
  }

  .custom-range-page__media-image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .custom-range-page__placeholder,
  .custom-range-page__media-placeholder {
    align-items: center;
    border: 1px dashed rgba(176, 138, 47, 0.35);
    color: rgba(43, 42, 40, 0.72);
    display: flex;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .custom-range-page__hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .custom-range-page__copy {
      max-width: none;
    }
  }

  @media screen and (max-width: 749px) {
    .custom-range-page__inner {
      padding-block: var(--custom-range-page-padding-top-mobile) var(--custom-range-page-padding-bottom-mobile);
      padding-inline: var(--custom-range-page-padding-inline-mobile);
    }

    .custom-range-page__breadcrumb {
      margin-bottom: 1.25rem;
    }

    .custom-range-page__title {
      font-size: clamp(1.8rem, 8vw, 2.6rem);
    }

    .custom-range-page__media,
    .custom-range-page__media-placeholder {
      min-height: 16rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Range Page",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "info": "Leave blank to use the page content."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_mobile_image",
      "label": "Hero mobile image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2b2a28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#b08a2f"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 1200,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "hero_radius",
      "label": "Hero image radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Padding inline",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "Padding inline mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Custom Range Page"
    }
  ]
}
{% endschema %}
