{{ 'section-custom-editorial-purpose-banner.css' | asset_url | stylesheet_tag }}
<section
  class="custom-editorial-purpose-banner color-{{ section.settings.color_scheme }}"
  style="
    --custom-editorial-purpose-banner-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-purpose-banner-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-purpose-banner-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-purpose-banner-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-purpose-banner-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-purpose-banner-padding-inline: {{ section.settings.padding_inline }}px;
    --custom-editorial-purpose-banner-padding-inline-mobile: {{ section.settings.padding_inline_mobile }}px;
    --custom-editorial-purpose-banner-pattern-width: {{ section.settings.pattern_width_desktop }}px;
    --custom-editorial-purpose-banner-pattern-width-mobile: {{ section.settings.pattern_width_mobile }}px;
    --custom-editorial-purpose-banner-pattern-offset-y: {{ section.settings.pattern_offset_y_desktop }}px;
    --custom-editorial-purpose-banner-pattern-offset-y-mobile: {{ section.settings.pattern_offset_y_mobile }}px;
    --custom-editorial-purpose-banner-pattern-opacity: {{ section.settings.pattern_opacity | divided_by: 100.0 }};
    --custom-editorial-purpose-banner-content-max-width: {{ section.settings.content_max_width }}px;
    --custom-editorial-purpose-banner-content-gap: {{ section.settings.content_gap }}px;
    --custom-editorial-purpose-banner-heading-size: {{ section.settings.heading_size_desktop }}px;
    --custom-editorial-purpose-banner-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --custom-editorial-purpose-banner-body-size: {{ section.settings.body_size_desktop }}px;
    --custom-editorial-purpose-banner-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --custom-editorial-purpose-banner-button-gap: {{ section.settings.button_gap }}px;
    --custom-editorial-purpose-banner-button-min-width: {{ section.settings.button_min_width_desktop }}px;
    --custom-editorial-purpose-banner-button-min-width-mobile: {{ section.settings.button_min_width_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-purpose-banner__inner">
    {%- if section.settings.decorative_pattern != blank -%}
      <div class="custom-editorial-purpose-banner__pattern" aria-hidden="true">
        <picture>
          {%- if section.settings.decorative_pattern_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.decorative_pattern_mobile | image_url: width: 1600 }}">
          {%- endif -%}
          {{
            section.settings.decorative_pattern
            | image_url: width: 2600
            | image_tag:
              loading: 'lazy',
              widths: '600,900,1200,1600,2000,2600',
              sizes: '100vw',
              class: 'custom-editorial-purpose-banner__pattern-image',
              alt: ''
          }}
        </picture>
      </div>
    {%- endif -%}

    <div class="custom-editorial-purpose-banner__content">
      {%- if section.settings.heading != blank -%}
        <div class="custom-editorial-purpose-banner__heading rte">
          {{ section.settings.heading }}
        </div>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="custom-editorial-purpose-banner__text rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank -%}
        <div class="custom-editorial-purpose-banner__actions">
          {%- if section.settings.primary_button_label != blank and section.settings.primary_button_url != blank -%}
            <a class="button custom-editorial-purpose-banner__button" href="{{ section.settings.primary_button_url }}">
              {{ section.settings.primary_button_label | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank and section.settings.secondary_button_url != blank -%}
            <a class="button button-secondary custom-editorial-purpose-banner__button" href="{{ section.settings.secondary_button_url }}">
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Editorial purpose banner",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>“A Purpose Beyond Profit”</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>“When you choose Dilmah, you choose a tea that cares. You support the people who grew it and the land that nurtured it.”</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Discover Our Commitment"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    },
    {
      "type": "image_picker",
      "id": "decorative_pattern",
      "label": "Decorative top pattern"
    },
    {
      "type": "image_picker",
      "id": "decorative_pattern_mobile",
      "label": "Decorative top pattern mobile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1560
    },
    {
      "type": "header",
      "content": "Pattern"
    },
    {
      "type": "range",
      "id": "pattern_width_desktop",
      "label": "Pattern width desktop",
      "min": 600,
      "max": 2600,
      "step": 20,
      "unit": "px",
      "default": 2200
    },
    {
      "type": "range",
      "id": "pattern_width_mobile",
      "label": "Pattern width mobile",
      "min": 280,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "pattern_offset_y_desktop",
      "label": "Pattern vertical offset desktop",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pattern_offset_y_mobile",
      "label": "Pattern vertical offset mobile",
      "min": -120,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "label": "Pattern opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 24,
      "max": 88,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Body size desktop",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body size mobile",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "range",
      "id": "button_min_width_desktop",
      "label": "Button min width desktop",
      "min": 120,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "button_min_width_mobile",
      "label": "Button min width mobile",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "button_gap",
      "label": "Button gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 320,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 860
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between content",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Side padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "Side padding mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Editorial purpose banner"
    }
  ]
}
{% endschema %}
