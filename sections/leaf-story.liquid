
{%- liquid
  assign show_tl = section.settings.show_leaf_top_left
  assign show_br = section.settings.show_leaf_bottom_right
  assign img_tl = section.settings.leaf_image_top_left
  assign img_br = section.settings.leaf_image_bottom_right
  assign leaf_opacity = section.settings.leaf_opacity | divided_by: 100.0
-%}

<div
  class="section-background color-{{ section.settings.color_scheme }}"
  {% if section.settings.enable_custom_leaf_background %}
    style="background: {{ section.settings.leaf_section_background }};"
  {% endif %}
></div>
<div
  class="
    section
    {% if section.settings.section_width == 'full-width' %}
      section--full-width
    {% else %}
      page-width-content
    {% endif %}
    color-{{ section.settings.color_scheme }}
    leaf-story
  "
  style="
    --leaf-story-opacity: {{ leaf_opacity }};
    --leaf-story-mobile-vision-font-size: {{ section.settings.mobile_vision_text_size }}px;
    --leaf-vision-padding-block-start: {{ section.settings.vision_text_padding_top }}px;
    --leaf-vision-padding-block-end: {{ section.settings.vision_text_padding_bottom }}px;
    --leaf-icon-row-font-size: {{ section.settings.icon_row_text_size }}px;
    --leaf-icon-row-font-size-mobile: {{ section.settings.icon_row_text_size_mobile }}px;
    --leaf-vision-padding-inline-mobile-start: {{ section.settings.vision_padding_inline_start_mobile }}px;
    --leaf-vision-padding-inline-mobile-end: {{ section.settings.vision_padding_inline_end_mobile }}px;
    --leaf-vision-heading-font-size: {{ section.settings.vision_heading_text_size }}px;
    --leaf-vision-heading-font-size-mobile: {{ section.settings.vision_heading_text_size_mobile }}px;
    --leaf-story-leaf-max-mobile: min({{ section.settings.leaf_mobile_max_width_vw }}vw, {{ section.settings.leaf_mobile_max_width_px }}px);
    --leaf-icon-cell-min-mobile: {{ section.settings.icon_row_cell_min_width_mobile }}px;
    --leaf-icon-cell-max-mobile: {{ section.settings.icon_row_cell_max_width_mobile }}px;
    --leaf-icon-cell-flex-basis: {{ section.settings.icon_row_cell_flex_basis_percent }}%;
  "
>
  {%- if show_tl and img_tl != blank -%}
    <div class="leaf-story__leaf leaf-story__leaf--top-left" aria-hidden="true">
      {{
        img_tl
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '200,400,600,800',
          sizes: '(min-width: 990px) 28vw, 40vw',
          class: 'leaf-story__leaf-img'
      }}
    </div>
  {%- endif -%}

  {%- if show_br and img_br != blank -%}
    <div class="leaf-story__leaf leaf-story__leaf--bottom-right" aria-hidden="true">
      {{
        img_br
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '200,400,600,800',
          sizes: '(min-width: 990px) 32vw, 45vw',
          class: 'leaf-story__leaf-img'
      }}
    </div>
  {%- endif -%}

  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
      leaf-story__content
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  /*
   * Horizon .section uses a 3-column grid; .section > * defaults to grid-column: 2 only.
   * Corner leaves must span grid-column: 1 / -1 so they sit in the full-width band (margins
   * + content), otherwise they are clipped to the narrow center column.
   * Stack leaves + content on grid-row: 1 so row height still follows the main content.
   */
  .leaf-story {
    position: relative;
    overflow: visible;
  }

  .leaf-story > * {
    grid-row: 1;
  }

  .leaf-story__leaf {
    grid-column: 1 / -1;
    position: absolute;
    z-index: 0;
    pointer-events: none;
    max-width: min(38vw, 20rem);
    opacity: var(--leaf-story-opacity, 0.4);
  }

  .leaf-story__leaf--top-left {
    top: 0;
    inset-inline-start: 0;
  }

  .leaf-story__leaf--bottom-right {
    bottom: 0;
    inset-inline-end: 0;
  }

  .leaf-story__leaf-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .leaf-story__content {
    grid-column: 2;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /*
   * Vision-only column panels: use > .group-block > so nested columns inside the icon row
   * (row > group-block > column) are not matched—those stay on Icon row text settings.
   */
  /* Vision text blocks: extra padding inside column stacks (Paragraph / Custom / Default, not headings) */
  .leaf-story__content.layout-panel-flex--column
    > .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6)),
  .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column
    > .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6)) {
    padding-block-start: var(--leaf-vision-padding-block-start, 0px);
    padding-block-end: var(--leaf-vision-padding-block-end, 0px);
  }

  /* Icon row captions: desktop size */
  .leaf-story__content .group-block-content.layout-panel-flex--row .text-block.custom:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)) {
    --font-size: var(--leaf-icon-row-font-size);
  }

  .leaf-story__content .group-block-content.layout-panel-flex--row
    .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6))
    > * {
    font-size: var(--leaf-icon-row-font-size);
  }

  /*
   * Vision column: eyebrow / kicker — H5/H6, or the first Paragraph/Custom/RTE block when it is
   * the first child in the column (typical green line above the main vision heading). Separate
   * from body vision text and icon row. H1–H4 keep theme or block sizing.
   */
  .leaf-story__content.layout-panel-flex--column > .text-block:is(.h5, .h6) > *,
  .leaf-story__content.layout-panel-flex--column > .text-block:is(.h5, .h6) :is(h5, h6),
  .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column > .text-block:is(.h5, .h6) > *,
  .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column
    > .text-block:is(.h5, .h6)
    :is(h5, h6),
  .leaf-story__content.layout-panel-flex--column
    > .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):first-child
    > *,
  .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column
    > .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):first-child
    > * {
    font-size: var(--leaf-vision-heading-font-size, 14px);
  }

  .leaf-story__content.layout-panel-flex--column
    > .text-block.custom:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):first-child,
  .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column
    > .text-block.custom:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):first-child {
    --font-size: var(--leaf-vision-heading-font-size, 14px);
  }

  @media screen and (max-width: 749px) {
    .leaf-story__leaf {
      max-width: var(--leaf-story-leaf-max-mobile, min(44vw, 13rem));
    }

    /*
     * Vision / body copy: Paragraph, Custom, or RTE in column stacks, except the first child
     * (eyebrow — uses Vision heading sizes) and except heading presets.
     */
    .leaf-story__content.layout-panel-flex--column
      > .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):not(:first-child)
      > *,
    .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column
      > .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):not(:first-child)
      > * {
      font-size: var(--leaf-story-mobile-vision-font-size, 24px);
    }

    .leaf-story__content.layout-panel-flex--column
      > .text-block.custom:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):not(:first-child),
    .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column
      > .text-block.custom:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):not(:first-child) {
      --font-size: var(--leaf-story-mobile-vision-font-size, 24px);
    }

    .leaf-story__content.layout-panel-flex--column > .text-block:is(.h5, .h6) > *,
    .leaf-story__content.layout-panel-flex--column > .text-block:is(.h5, .h6) :is(h5, h6),
    .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column > .text-block:is(.h5, .h6) > *,
    .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column
      > .text-block:is(.h5, .h6)
      :is(h5, h6),
    .leaf-story__content.layout-panel-flex--column
      > .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):first-child
      > *,
    .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column
      > .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):first-child
      > * {
      font-size: var(--leaf-vision-heading-font-size-mobile, 13px);
    }

    .leaf-story__content.layout-panel-flex--column
      > .text-block.custom:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):first-child,
    .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column
      > .text-block.custom:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)):first-child {
      --font-size: var(--leaf-vision-heading-font-size-mobile, 13px);
    }

    /*
     * Icon row: keep horizontal flow with wrap + centered rows (matches 3+2 grid look).
     * Overrides group "Vertical on mobile" (mobile-column) for row groups inside this section.
     */
    .leaf-story__content .group-block-content.layout-panel-flex--row {
      flex-flow: row wrap;
      justify-content: center;
      align-items: flex-start;
      align-content: center;
    }

    .leaf-story__content .group-block-content.layout-panel-flex--row.mobile-column {
      flex-flow: row wrap;
      align-items: flex-start;
      justify-content: center;
    }

    /*
     * Icon row cells: section controls override group block mobile width (.size-style uses inline vars).
     */
    .leaf-story__content .group-block-content.layout-panel-flex--row > .group-block {
      flex: 1 1 calc(var(--leaf-icon-cell-flex-basis, 33.333%) - var(--gap, 16px));
      width: auto !important;
      min-width: var(--leaf-icon-cell-min-mobile, 7.5rem) !important;
      max-width: var(--leaf-icon-cell-max-mobile, 11rem) !important;
    }

    .leaf-story__content .group-block-content.layout-panel-flex--row .text-block.custom:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)) {
      --font-size: var(--leaf-icon-row-font-size-mobile);
    }

    .leaf-story__content .group-block-content.layout-panel-flex--row
      .text-block:is(.paragraph, .custom, .rte):not(:is(.h1, .h2, .h3, .h4, .h5, .h6))
      > * {
      font-size: var(--leaf-icon-row-font-size-mobile);
    }

    /*
     * Vision column: replace block padding-inline (e.g. 80px on Heading) on small screens.
     * Text blocks use .spacing-style + inline --padding-inline-* from the block editor; those
     * beat normal rules, so !important is required here.
     */
    .leaf-story__content.layout-panel-flex--column.spacing-style > .text-block.spacing-style,
    .leaf-story__content > .group-block > .group-block-content.layout-panel-flex--column > .text-block.spacing-style {
      padding-inline-start: var(--leaf-vision-padding-inline-mobile-start, 24px) !important;
      padding-inline-end: var(--leaf-vision-padding-inline-mobile-end, 24px) !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.leaf_story",
  "class": "section-wrapper",
  "tag": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.leaf_decorations"
    },
    {
      "type": "checkbox",
      "id": "show_leaf_top_left",
      "label": "t:settings.show_leaf_top_left",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "leaf_image_top_left",
      "label": "t:settings.leaf_image_top_left",
      "visible_if": "{{ section.settings.show_leaf_top_left }}"
    },
    {
      "type": "checkbox",
      "id": "show_leaf_bottom_right",
      "label": "t:settings.show_leaf_bottom_right",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "leaf_image_bottom_right",
      "label": "t:settings.leaf_image_bottom_right",
      "visible_if": "{{ section.settings.show_leaf_bottom_right }}"
    },
    {
      "type": "range",
      "id": "leaf_opacity",
      "label": "t:settings.leaf_opacity",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "leaf_mobile_max_width_vw",
      "label": "t:settings.leaf_mobile_max_width_vw",
      "info": "t:settings.leaf_mobile_max_width_info",
      "min": 32,
      "max": 78,
      "step": 1,
      "unit": "%",
      "default": 56
    },
    {
      "type": "range",
      "id": "leaf_mobile_max_width_px",
      "label": "t:settings.leaf_mobile_max_width_px",
      "info": "t:settings.leaf_mobile_max_width_info",
      "min": 160,
      "max": 440,
      "step": 4,
      "unit": "px",
      "default": 288
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_leaf_background",
      "label": "t:settings.enable_custom_leaf_background",
      "default": false
    },
    {
      "type": "color_background",
      "id": "leaf_section_background",
      "label": "t:settings.leaf_section_background",
      "info": "t:settings.leaf_section_background_info",
      "visible_if": "{{ section.settings.enable_custom_leaf_background }}"
    },
    {
      "type": "header",
      "content": "t:content.leaf_vision_text"
    },
    {
      "type": "range",
      "id": "vision_text_padding_top",
      "label": "t:settings.vision_text_padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "vision_text_padding_bottom",
      "label": "t:settings.vision_text_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "vision_padding_inline_start_mobile",
      "label": "t:settings.vision_padding_inline_start_mobile",
      "info": "t:settings.vision_padding_inline_mobile_info",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "vision_padding_inline_end_mobile",
      "label": "t:settings.vision_padding_inline_end_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.leaf_vision_heading"
    },
    {
      "type": "range",
      "id": "vision_heading_text_size",
      "label": "t:settings.vision_heading_text_size",
      "info": "t:settings.vision_heading_text_size_info",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "vision_heading_text_size_mobile",
      "label": "t:settings.vision_heading_text_size_mobile",
      "info": "t:settings.vision_heading_text_size_mobile_info",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "t:content.leaf_icon_row"
    },
    {
      "type": "range",
      "id": "icon_row_text_size",
      "label": "t:settings.icon_row_text_size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "icon_row_text_size_mobile",
      "label": "t:settings.icon_row_text_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "t:content.leaf_icon_row_layout"
    },
    {
      "type": "range",
      "id": "icon_row_cell_flex_basis_percent",
      "label": "t:settings.icon_row_cell_flex_basis_percent",
      "info": "t:settings.icon_row_cell_layout_mobile_info",
      "min": 22,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 33
    },
    {
      "type": "range",
      "id": "icon_row_cell_min_width_mobile",
      "label": "t:settings.icon_row_cell_min_width_mobile",
      "info": "t:settings.icon_row_cell_layout_mobile_info",
      "min": 72,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "icon_row_cell_max_width_mobile",
      "label": "t:settings.icon_row_cell_max_width_mobile",
      "info": "t:settings.icon_row_cell_layout_mobile_info",
      "min": 120,
      "max": 280,
      "step": 4,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "range",
      "id": "mobile_vision_text_size",
      "label": "t:settings.mobile_vision_text_size",
      "info": "t:settings.mobile_vision_text_size_info",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.leaf_story",
      "category": "t:categories.storytelling",
      "settings": {
        "color_scheme": "scheme-1",
        "section_width": "page-width",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "flex-start",
        "gap": 28,
        "mobile_vision_text_size": 24,
        "vision_text_padding_top": 0,
        "vision_text_padding_bottom": 0,
        "vision_padding_inline_start_mobile": 24,
        "vision_padding_inline_end_mobile": 24,
        "vision_heading_text_size": 14,
        "vision_heading_text_size_mobile": 13,
        "icon_row_text_size": 15,
        "icon_row_text_size_mobile": 13,
        "leaf_mobile_max_width_vw": 56,
        "leaf_mobile_max_width_px": 288,
        "icon_row_cell_flex_basis_percent": 33,
        "icon_row_cell_min_width_mobile": 120,
        "icon_row_cell_max_width_mobile": 200,
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    }
  ]
}
{% endschema %}
