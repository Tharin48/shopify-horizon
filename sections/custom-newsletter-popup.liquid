    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "image_picker",
      "id": "decorative_image",
      "label": "Decorative image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f7f1e5"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#0f4a3c"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
