{{ 'custom-newsletter-popup.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable MissingAsset %}
<script src="{{ 'custom-newsletter-popup.js' | asset_url }}" defer></script>
{% # theme-check-enable MissingAsset %}

{%- liquid
  assign popup_visibility = section.settings.popup_visibility | default: 'entire_site'
  assign page_type = request.page_type | default: ''
  assign page_allowed = true

  case popup_visibility
    when 'homepage_only'
      if page_type == 'index'
        assign page_allowed = true
      else
        assign page_allowed = false
      endif
    when 'product_only'
      if page_type == 'product'
        assign page_allowed = true
      else
        assign page_allowed = false
      endif
    when 'collection_only'
      if page_type == 'collection'
        assign page_allowed = true
      else
        assign page_allowed = false
      endif
    when 'key_templates'
      assign page_allowed = false
      if page_type == 'index' or page_type == 'product' or page_type == 'collection'
        assign page_allowed = true
      endif
    when 'exclude_cart'
      if page_type != 'cart'
        assign page_allowed = true
      else
        assign page_allowed = false
      endif
    else
      assign page_allowed = true
  endcase

  assign dialog_title_id = 'CustomNewsletterPopupTitle-' | append: section.id
  assign dialog_description_id = 'CustomNewsletterPopupDescription-' | append: section.id
  assign email_input_id = 'CustomNewsletterPopupEmail-' | append: section.id
  assign form_id = 'CustomNewsletterPopupForm-' | append: section.id
-%}

<section
  id="shopify-section-{{ section.id }}-newsletter-popup"
  class="custom-newsletter-popup"
  data-custom-newsletter-popup
  data-section-id="{{ section.id }}"
  data-enabled="{{ section.settings.enable_popup }}"
  data-page-allowed="{{ page_allowed }}"
  data-design-mode="{{ request.design_mode }}"
  data-delay-seconds="{{ section.settings.delay_seconds | default: 8 }}"
  data-display-frequency="{{ section.settings.display_frequency | default: 'days' }}"
  data-frequency-days="{{ section.settings.frequency_days | default: 14 }}"
  data-enable-desktop="{{ section.settings.enable_desktop }}"
  data-enable-mobile="{{ section.settings.enable_mobile }}"
  data-dismiss-key="customNewsletterPopupDismissedAt-{{ section.id }}"
  data-session-dismiss-key="customNewsletterPopupDismissedInSession-{{ section.id }}"
  hidden
  aria-hidden="true"
  style="
    --custom-newsletter-popup-background: {{ section.settings.background_color | default: '#f7f1e5' }};
    --custom-newsletter-popup-button: {{ section.settings.button_color | default: '#0f4a3c' }};
    --custom-newsletter-popup-overlay-opacity: {{ section.settings.overlay_opacity | default: 52 | times: 0.01 }};
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-newsletter-popup__overlay" data-newsletter-popup-dismiss aria-hidden="true"></div>

  <div
    class="custom-newsletter-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ dialog_title_id }}"
    aria-describedby="{{ dialog_description_id }}"
    tabindex="-1"
  >
    {%- if section.settings.decorative_image != blank -%}
      <div class="custom-newsletter-popup__decor" aria-hidden="true">
        {{
          section.settings.decorative_image
          | image_url: width: 520
          | image_tag:
            class: 'custom-newsletter-popup__decor-image',
            loading: 'lazy',
            widths: '120, 180, 240, 320, 420, 520',
            sizes: '(max-width: 749px) 7rem, 12rem',
            alt: ''
        }}
      </div>
    {%- endif -%}

    <button
      type="button"
      class="custom-newsletter-popup__icon-close"
      data-newsletter-popup-dismiss
      aria-label="Close popup"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5 5L19 19" />
        <path d="M19 5L5 19" />
      </svg>
    </button>

    <div class="custom-newsletter-popup__sheet-handle" aria-hidden="true"></div>

    {% render 'newsletter-popup-form',
      section: section,
      title_id: dialog_title_id,
      description_id: dialog_description_id,
      email_input_id: email_input_id,
      form_id: form_id
    %}
  </div>
</section>

{% schema %}
{
  "name": "Custom newsletter popup",
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "select",
      "id": "popup_visibility",
      "label": "Popup visibility",
      "default": "entire_site",
      "options": [
        {
          "value": "entire_site",
          "label": "Entire site"
        },
        {
          "value": "homepage_only",
          "label": "Homepage only"
        },
        {
          "value": "product_only",
          "label": "Product pages only"
        },
        {
          "value": "collection_only",
          "label": "Collection pages only"
        },
        {
          "value": "key_templates",
          "label": "Homepage + Product + Collection pages"
        },
        {
          "value": "exclude_cart",
          "label": "Exclude cart page"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_desktop",
      "label": "Enable desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mobile",
      "label": "Enable mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay seconds",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 8
    },
    {
      "type": "select",
      "id": "display_frequency",
      "label": "Display frequency",
      "default": "days",
      "options": [
        {
          "value": "days",
          "label": "Hide for configured days"
        },
        {
          "value": "session",
          "label": "Show every new session"
        }
      ]
    },
    {
      "type": "range",
      "id": "frequency_days",
      "label": "Frequency days",
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "d",
      "default": 14
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enjoy 10% Off Your First Order"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join the Dilmah community for exclusive offers, tea stories, and early access to new collections."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Unlock My Discount"
    },
    {
      "type": "text",
      "id": "close_text",
      "label": "Close text",
      "default": "No Thanks"
    },
    {
      "type": "text",
      "id": "small_trust_text",
      "label": "Small trust text",
      "default": "No spam. Just thoughtful tea experiences."
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success title",
      "default": "Thank you for subscribing"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Use code WELCOME10 at checkout."
    },
    {
      "type": "text",
      "id": "success_button_text",
      "label": "Success button text",
      "default": "Continue Shopping"
    },
    {
      "type": "text",
      "id": "copy_code_text",
      "label": "Copy code text",
      "default": "Copy code"
    },
    {
      "type": "text",
      "id": "copied_text",
      "label": "Copied state text",
      "default": "Copied"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "default": "WELCOME10"
    },
    {
      "type": "paragraph",
