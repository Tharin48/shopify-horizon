{{ 'section-custom-editorial-mosaic-cards.css' | asset_url | stylesheet_tag }}
<section
  class="custom-editorial-mosaic-cards custom-editorial-mosaic-cards--mobile-{{ section.settings.mobile_layout }}"
  style="
    --custom-editorial-mosaic-cards-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-mosaic-cards-background: {{ section.settings.background_color }};
    --custom-editorial-mosaic-cards-heading-color: {{ section.settings.heading_color }};
    --custom-editorial-mosaic-cards-body-color: {{ section.settings.body_color }};
    --custom-editorial-mosaic-cards-accent: {{ section.settings.accent_color }};
    --custom-editorial-mosaic-cards-card-radius: {{ section.settings.card_radius }}px;
    --custom-editorial-mosaic-cards-row-height: {{ section.settings.row_height }}px;
    --custom-editorial-mosaic-cards-gap: {{ section.settings.desktop_gap }}px;
    --custom-editorial-mosaic-cards-gap-mobile: {{ section.settings.mobile_gap }}px;
    --custom-editorial-mosaic-cards-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-mosaic-cards-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-mosaic-cards-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-mosaic-cards-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-mosaic-cards-content-padding: {{ section.settings.card_content_padding }}px;
    --custom-editorial-mosaic-cards-content-padding-mobile: {{ section.settings.card_content_padding_mobile }}px;
    --custom-editorial-mosaic-cards-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --custom-editorial-mosaic-cards-arrow-size: {{ section.settings.arrow_button_size }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-mosaic-cards__inner">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="custom-editorial-mosaic-cards__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-editorial-mosaic-cards__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="custom-editorial-mosaic-cards__intro rte">
            {{ section.settings.intro }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-editorial-mosaic-cards__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign text_color = block.settings.text_color
          assign heading_color = block.settings.heading_color | default: text_color
          assign body_color = block.settings.body_color | default: text_color
          assign overlay_opacity = block.settings.overlay_opacity
          assign has_link = false

          if block.settings.link_url != blank
            assign has_link = true
          endif
        -%}

        <article
          class="
            custom-editorial-mosaic-cards__card
            custom-editorial-mosaic-cards__card--col-{{ block.settings.column_span }}
            custom-editorial-mosaic-cards__card--row-{{ block.settings.row_span }}
            custom-editorial-mosaic-cards__card--v-{{ block.settings.vertical_alignment }}
            custom-editorial-mosaic-cards__card--h-{{ block.settings.horizontal_alignment }}
          "
          style="
            --custom-editorial-mosaic-card-text: {{ text_color }};
            --custom-editorial-mosaic-card-heading: {{ heading_color }};
            --custom-editorial-mosaic-card-body: {{ body_color }};
            --custom-editorial-mosaic-card-overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
            --custom-editorial-mosaic-card-max-width: {{ block.settings.content_max_width }}px;
          "
          {{ block.shopify_attributes }}
        >
          <div class="custom-editorial-mosaic-cards__media-shell">
            {%- if block.settings.mobile_image != blank -%}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ block.settings.mobile_image | image_url: width: 480 }} 480w,
                    {{ block.settings.mobile_image | image_url: width: 720 }} 720w,
                    {{ block.settings.mobile_image | image_url: width: 960 }} 960w
                  "
                  sizes="100vw"
                >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1800
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,540,720,960,1200,1600,1800',
                      sizes: '(min-width: 750px) 33vw, 100vw',
                      class: 'custom-editorial-mosaic-cards__image',
                      alt: block.settings.image.alt
                  }}
                {%- else -%}
                  {{
                    block.settings.mobile_image
                    | image_url: width: 1800
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,540,720,960,1200,1600,1800',
                      sizes: '(min-width: 750px) 33vw, 100vw',
                      class: 'custom-editorial-mosaic-cards__image',
                      alt: block.settings.mobile_image.alt
                  }}
                {%- endif -%}
              </picture>
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '360,540,720,960,1200,1600,1800',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  class: 'custom-editorial-mosaic-cards__image',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              <div class="custom-editorial-mosaic-cards__empty">Choose an image</div>
            {%- endif -%}

            <div class="custom-editorial-mosaic-cards__overlay"></div>
          </div>

          <div class="custom-editorial-mosaic-cards__content">
            <div class="custom-editorial-mosaic-cards__copy">
              {%- if block.settings.eyebrow != blank -%}
                <p class="custom-editorial-mosaic-cards__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="custom-editorial-mosaic-cards__card-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="custom-editorial-mosaic-cards__card-text rte">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            </div>

            {%- if has_link and block.settings.show_arrow_button -%}
              <a
                class="custom-editorial-mosaic-cards__arrow-button"
                href="{{ block.settings.link_url }}"
                aria-label="{{ block.settings.link_label | default: block.settings.heading | default: 'Open card' | escape }}"
              >
                <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
                  {% render 'icon', icon: 'arrow' %}
                </svg>
              </a>
            {%- endif -%}
          </div>

          {%- if has_link and block.settings.show_arrow_button == false -%}
            <a
              class="custom-editorial-mosaic-cards__card-link"
              href="{{ block.settings.link_url }}"
              aria-label="{{ block.settings.link_label | default: block.settings.heading | default: 'Open card' | escape }}"
            ></a>
          {%- endif -%}
        </article>
      {%- endfor -%}

      {%- if section.blocks.size == 0 and request.design_mode -%}
        <div class="custom-editorial-mosaic-cards__empty">Add card blocks to build this mosaic layout.</div>
      {%- endif -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Editorial mosaic cards",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "stack",
      "options": [
        { "value": "stack", "label": "Stack" },
        { "value": "carousel", "label": "Carousel" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1f1812"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#4b4137"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#b08a2f"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Desktop row height",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_content_padding",
      "label": "Card content padding",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_content_padding_mobile",
      "label": "Card content padding mobile",
      "min": 12,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "arrow_button_size",
      "label": "Arrow button size",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Default overlay opacity",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "checkbox",
          "id": "show_arrow_button",
          "label": "Show arrow button",
          "default": true
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#1f1812"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#1f1812"
        },
        {
          "type": "color",
          "id": "body_color",
          "label": "Body color",
          "default": "#3f372f"
        },
        {
          "type": "range",
          "id": "content_max_width",
          "label": "Content max width",
          "min": 120,
          "max": 520,
          "step": 10,
          "unit": "px",
          "default": 260
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "%",
          "default": 0
        },
        {
          "type": "select",
          "id": "column_span",
          "label": "Desktop column span",
          "default": "2",
          "options": [
            { "value": "1", "label": "1 column" },
            { "value": "2", "label": "2 columns" },
            { "value": "3", "label": "3 columns" },
            { "value": "4", "label": "4 columns" },
            { "value": "5", "label": "5 columns" },
            { "value": "6", "label": "6 columns" }
          ]
        },
        {
          "type": "select",
          "id": "row_span",
          "label": "Desktop row span",
          "default": "1",
          "options": [
            { "value": "1", "label": "1 row" },
            { "value": "2", "label": "2 rows" },
            { "value": "3", "label": "3 rows" }
          ]
        },
        {
          "type": "select",
          "id": "vertical_alignment",
          "label": "Vertical alignment",
          "default": "end",
          "options": [
            { "value": "start", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "end", "label": "Bottom" }
          ]
        },
        {
          "type": "select",
          "id": "horizontal_alignment",
          "label": "Horizontal alignment",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial mosaic cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
