{{ 'section-custom-editorial-service-cards.css' | asset_url | stylesheet_tag }}
<section
  class="custom-editorial-service-cards"
  style="
    --custom-editorial-service-cards-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-service-cards-background: {{ section.settings.background_color }};
    --custom-editorial-service-cards-card-background: {{ section.settings.card_background_color }};
    --custom-editorial-service-cards-text-color: {{ section.settings.text_color }};
    --custom-editorial-service-cards-accent: {{ section.settings.accent_color }};
    --custom-editorial-service-cards-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-service-cards-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-service-cards-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-service-cards-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-service-cards-padding-inline: {{ section.settings.padding_inline }}px;
    --custom-editorial-service-cards-padding-inline-mobile: {{ section.settings.padding_inline_mobile }}px;
    --custom-editorial-service-cards-header-gap: {{ section.settings.header_gap }}px;
    --custom-editorial-service-cards-grid-gap: {{ section.settings.grid_gap_desktop }}px;
    --custom-editorial-service-cards-grid-gap-mobile: {{ section.settings.grid_gap_mobile }}px;
    --custom-editorial-service-cards-card-radius: {{ section.settings.card_radius }}px;
    --custom-editorial-service-cards-card-padding: {{ section.settings.card_padding_desktop }}px;
    --custom-editorial-service-cards-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;
    --custom-editorial-service-cards-card-shadow-opacity: {{ section.settings.card_shadow_opacity | divided_by: 100.0 }};
    --custom-editorial-service-cards-icon-size: {{ section.settings.icon_size_desktop }}px;
    --custom-editorial-service-cards-icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
    --custom-editorial-service-cards-heading-size: {{ section.settings.heading_size_desktop }}px;
    --custom-editorial-service-cards-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --custom-editorial-service-cards-body-size: {{ section.settings.body_size_desktop }}px;
    --custom-editorial-service-cards-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --custom-editorial-service-cards-card-heading-size: {{ section.settings.card_heading_size_desktop }}px;
    --custom-editorial-service-cards-card-heading-size-mobile: {{ section.settings.card_heading_size_mobile }}px;
    --custom-editorial-service-cards-card-body-size: {{ section.settings.card_body_size_desktop }}px;
    --custom-editorial-service-cards-card-body-size-mobile: {{ section.settings.card_body_size_mobile }}px;
    --custom-editorial-service-cards-left-decor-width: {{ section.settings.left_decor_width }}px;
    --custom-editorial-service-cards-left-decor-opacity: {{ section.settings.left_decor_opacity | divided_by: 100.0 }};
    --custom-editorial-service-cards-left-decor-offset-x: {{ section.settings.left_decor_offset_x }}px;
    --custom-editorial-service-cards-left-decor-offset-y: {{ section.settings.left_decor_offset_y }}px;
    --custom-editorial-service-cards-right-decor-width: {{ section.settings.right_decor_width }}px;
    --custom-editorial-service-cards-right-decor-opacity: {{ section.settings.right_decor_opacity | divided_by: 100.0 }};
    --custom-editorial-service-cards-right-decor-offset-x: {{ section.settings.right_decor_offset_x }}px;
    --custom-editorial-service-cards-right-decor-offset-y: {{ section.settings.right_decor_offset_y }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-service-cards__inner">
    {%- if section.settings.left_decor_image != blank -%}
      <div
        class="custom-editorial-service-cards__decor custom-editorial-service-cards__decor--left{% if section.settings.hide_left_decor_mobile %} custom-editorial-service-cards__decor--hide-mobile{% endif %}"
        aria-hidden="true"
      >
        {{
          section.settings.left_decor_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '120,240,360,480,720,960,1200',
            sizes: '(min-width: 990px) 14vw, 24vw',
            class: 'custom-editorial-service-cards__decor-image',
            alt: ''
        }}
      </div>
    {%- endif -%}

    {%- if section.settings.right_decor_image != blank -%}
      <div
        class="custom-editorial-service-cards__decor custom-editorial-service-cards__decor--right{% if section.settings.hide_right_decor_mobile %} custom-editorial-service-cards__decor--hide-mobile{% endif %}"
        aria-hidden="true"
      >
        {{
          section.settings.right_decor_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '120,240,360,480,720,960,1200',
            sizes: '(min-width: 990px) 14vw, 24vw',
            class: 'custom-editorial-service-cards__decor-image',
            alt: ''
        }}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="custom-editorial-service-cards__header">
        {%- if section.settings.heading != blank -%}
          <div class="custom-editorial-service-cards__heading rte">
            {{ section.settings.heading }}
          </div>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="custom-editorial-service-cards__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-editorial-service-cards__grid">
      {%- for block in section.blocks -%}
        <article class="custom-editorial-service-cards__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="custom-editorial-service-cards__icon-shell">
              <div class="custom-editorial-service-cards__icon">
                {{
                  block.settings.icon
                  | image_url: width: 240
                  | image_tag:
                    loading: 'lazy',
                    widths: '48,72,96,144,192,240',
                    sizes: '72px',
                    alt: block.settings.icon.alt
                }}
              </div>
            </div>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <div class="custom-editorial-service-cards__card-heading rte">
              {{ block.settings.heading }}
            </div>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="custom-editorial-service-cards__card-text rte">
              {{ block.settings.text }}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}

      {%- if section.blocks.size == 0 and request.design_mode -%}
        <div class="custom-editorial-service-cards__empty">Add card blocks to build this section.</div>
      {%- endif -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Editorial service cards",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>How We Serve as Tea Growers</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>As tea growers, we serve by staying connected to source, protecting freshness, and sharing tea with integrity.</p><p>Our role is to preserve the authenticity of tea from garden to cup.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2b2a28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c8a11d"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1560
    },
    {
      "type": "header",
      "content": "Decorative images"
    },
    {
      "type": "image_picker",
      "id": "left_decor_image",
      "label": "Left decorative image"
    },
    {
      "type": "image_picker",
      "id": "right_decor_image",
      "label": "Right decorative image"
    },
