      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "left_decor_offset_y",
      "label": "Left image vertical offset",
      "min": -240,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "right_decor_offset_x",
