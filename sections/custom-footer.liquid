{{- 'custom-footer.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'custom-footer.js' | asset_url }}" defer></script>

{%- liquid
  assign main_block_count = 0
  assign trust_badge_count = 0
  assign payment_icons_count = 0
  assign copyright_count = 0
  assign menu_block_index = 0

  for block in section.blocks
    case block.type
      when 'menu_column', 'social_links', 'custom_text'
        assign main_block_count = main_block_count | plus: 1
      when 'trust_badge'
        assign trust_badge_count = trust_badge_count | plus: 1
      when 'payment_icons'
        assign payment_icons_count = payment_icons_count | plus: 1
      when 'copyright_text'
        assign copyright_count = copyright_count | plus: 1
    endcase
  endfor
-%}

<section class="custom-footer-section" {{ section.shopify_attributes }}>
  <footer
    class="custom-footer"
    data-custom-footer
    data-section-id="{{ section.id }}"
    style="
      --custom-footer-background: {{ section.settings.background_color }};
      --custom-footer-text: {{ section.settings.text_color }};
      --custom-footer-heading: {{ section.settings.heading_color }};
      --custom-footer-link-hover: {{ section.settings.link_hover_color }};
      --custom-footer-bottom-bar-background: {{ section.settings.bottom_bar_background_color }};
      --custom-footer-max-width: {{ section.settings.max_width }}px;
      --custom-footer-column-gap: {{ section.settings.column_gap }}px;
      --custom-footer-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
      --custom-footer-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
      --custom-footer-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --custom-footer-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --custom-footer-background-position: {{ section.settings.background_image_position }};
      --custom-footer-background-size: {{ section.settings.background_image_size }};
      --custom-footer-background-opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};
      --custom-footer-left-decor-width: {{ section.settings.left_decor_width }}px;
      --custom-footer-left-decor-opacity: {{ section.settings.left_decor_opacity | divided_by: 100.0 }};
      --custom-footer-left-decor-x: {{ section.settings.left_decor_offset_x }}px;
      --custom-footer-left-decor-y: {{ section.settings.left_decor_offset_y }}px;
      --custom-footer-right-decor-width: {{ section.settings.right_decor_width }}px;
      --custom-footer-right-decor-opacity: {{ section.settings.right_decor_opacity | divided_by: 100.0 }};
      --custom-footer-right-decor-x: {{ section.settings.right_decor_offset_x }}px;
      --custom-footer-right-decor-y: {{ section.settings.right_decor_offset_y }}px;
      {% if section.settings.background_image != blank %}
        --custom-footer-background-image: url({{ section.settings.background_image | image_url: width: 2400 }});
      {% endif %}
    "
  >
    <div class="custom-footer__background" aria-hidden="true"></div>
    {%- if section.settings.show_decorative_images -%}
      {%- if section.settings.left_decor_image != blank -%}
        <div class="custom-footer__decor custom-footer__decor--left" aria-hidden="true">
          {{
            section.settings.left_decor_image
            | image_url: width: 800
            | image_tag:
              class: 'custom-footer__decor-image',
              loading: 'lazy',
              widths: '160, 240, 320, 480, 640, 800',
              sizes: '220px',
              alt: ''
          }}
        </div>
      {%- endif -%}

      {%- if section.settings.right_decor_image != blank -%}
        <div class="custom-footer__decor custom-footer__decor--right" aria-hidden="true">
          {{
            section.settings.right_decor_image
            | image_url: width: 800
            | image_tag:
              class: 'custom-footer__decor-image',
              loading: 'lazy',
              widths: '160, 240, 320, 480, 640, 800',
              sizes: '220px',
              alt: ''
          }}
        </div>
      {%- endif -%}
    {%- endif -%}

    <div class="custom-footer__inner">
      {%- if main_block_count > 0 -%}
        <div class="custom-footer__main-grid">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'menu_column' -%}
                {%- liquid
                  assign menu_block_index = menu_block_index | plus: 1
                  assign menu = block.settings.menu
                  assign heading = block.settings.heading | default: menu.title
                  assign width = block.settings.width
                  assign text_alignment = block.settings.text_alignment | default: 'left'
                -%}
                {%- if menu != blank or heading != blank -%}
                  <div
                    class="custom-footer__block custom-footer__block--menu"
                    data-custom-footer-menu-block
                    style="
                      --custom-footer-block-width: {% if width > 0 %}{{ width }}px{% else %}100%{% endif %};
                      --custom-footer-text-align: {{ text_alignment }};
                    "
                    {{ block.shopify_attributes }}
                  >
                    <details
                      class="custom-footer__menu-accordion"
                      data-custom-footer-accordion
                      {% if menu_block_index == 1 %}open{% endif %}
                    >
                      <summary class="custom-footer__menu-summary">
                        {%- if heading != blank -%}
                          <h3 class="custom-footer__heading custom-footer__heading--menu">{{ heading | escape }}</h3>
                        {%- endif -%}

                        <span class="custom-footer__menu-toggle" aria-hidden="true">
                          <span class="svg-wrapper icon-caret icon-caret--forward">
                            {{- 'icon-caret.svg' | inline_asset_content -}}
                          </span>
                        </span>
                      </summary>

                      <div class="custom-footer__menu-panel" data-custom-footer-panel>
                        <div class="custom-footer__menu-panel-inner">
                          {%- if menu != blank -%}
                            <ul class="custom-footer__menu-list" role="list">
                              {%- for link in menu.links -%}
                                <li class="custom-footer__menu-item">
                                  <a href="{{ link.url }}">{{ link.title | escape }}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      </div>
                    </details>
                  </div>
                {%- endif -%}

              {%- when 'social_links' -%}
                <div class="custom-footer__block custom-footer__block--social" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h3 class="custom-footer__heading">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}

                  <div
                    class="custom-footer__social-list custom-footer__social-list--{{ block.settings.icon_style }}"
                    style="--custom-footer-social-size: {{ block.settings.icon_size }}px;"
                  >
                    {%- if block.settings.facebook_url != blank -%}
                      <a href="{{ block.settings.facebook_url }}" class="custom-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">{% render 'icon', icon: 'facebook' %}</svg>
                      </a>
                    {%- endif -%}
                    {%- if block.settings.pinterest_url != blank -%}
                      <a href="{{ block.settings.pinterest_url }}" class="custom-footer__social-link" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">{% render 'icon', icon: 'pinterest' %}</svg>
                      </a>
                    {%- endif -%}
                    {%- if block.settings.instagram_url != blank -%}
                      <a href="{{ block.settings.instagram_url }}" class="custom-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">{% render 'icon', icon: 'instagram' %}</svg>
                      </a>
                    {%- endif -%}
                    {%- if block.settings.youtube_url != blank -%}
                      <a href="{{ block.settings.youtube_url }}" class="custom-footer__social-link" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">{% render 'icon', icon: 'youtube' %}</svg>
                      </a>
                    {%- endif -%}
                    {%- if block.settings.tiktok_url != blank -%}
                      <a href="{{ block.settings.tiktok_url }}" class="custom-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">{% render 'icon', icon: 'tiktok' %}</svg>
                      </a>
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'custom_text' -%}
                <div class="custom-footer__block custom-footer__block--text" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h3 class="custom-footer__heading">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="custom-footer__rte rte">{{ block.settings.text }}</div>
                  {%- endif -%}

                  {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                    <a class="custom-footer__button-link" href="{{ block.settings.button_link }}">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if trust_badge_count > 0 or payment_icons_count > 0 -%}
        <div class="custom-footer__utility-row">
          {%- if trust_badge_count > 0 -%}
            <div class="custom-footer__trust-list" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'trust_badge' -%}
                  {%- capture trust_content -%}
                    <span class="custom-footer__trust-icon" aria-hidden="true">
                      {%- if block.settings.icon != blank -%}
                        {{
                          block.settings.icon
                          | image_url: width: 120
                          | image_tag:
                            class: 'custom-footer__trust-icon-image',
                            loading: 'lazy',
                            widths: '40, 60, 80, 120',
                            sizes: '24px',
                            alt: ''
                        }}
                      {%- endif -%}
                    </span>
                    <span class="custom-footer__trust-text">{{ block.settings.text | escape }}</span>
                  {%- endcapture -%}

                  {%- if block.settings.link != blank -%}
                    <a
                      class="custom-footer__trust-item"
                      href="{{ block.settings.link }}"
                      role="listitem"
                      {{ block.shopify_attributes }}
                    >
                      {{ trust_content }}
                    </a>
                  {%- else -%}
                    <div class="custom-footer__trust-item" role="listitem" {{ block.shopify_attributes }}>
                      {{ trust_content }}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if payment_icons_count > 0 -%}
            <div class="custom-footer__payment-area">
              {%- for block in section.blocks -%}
                {%- if block.type == 'payment_icons' -%}
                  <div class="custom-footer__payment-block" {{ block.shopify_attributes }}>
                    {%- if block.settings.show_shopify_payment_icons -%}
                      <ul class="custom-footer__payment-list" role="list">
                        {%- for type in shop.enabled_payment_types -%}
                          <li class="custom-footer__payment-item">
                            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    {%- if block.settings.custom_payment_image != blank -%}
                      <div class="custom-footer__payment-custom">
                        {{
                          block.settings.custom_payment_image
                          | image_url: width: 360
                          | image_tag:
                            class: 'custom-footer__payment-custom-image',
                            loading: 'lazy',
                            widths: '120, 180, 240, 360',
                            sizes: '180px',
                            alt: ''
                        }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if copyright_count > 0 -%}
      <div class="custom-footer__bottom-bar">
        <div class="custom-footer__inner custom-footer__inner--bottom">
          {%- for block in section.blocks -%}
            {%- if block.type == 'copyright_text' -%}
              <div class="custom-footer__copyright" {{ block.shopify_attributes }}>
                <div class="custom-footer__rte rte">{{ block.settings.copyright }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </footer>
</section>

{% schema %}
{
  "name": "Custom footer",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fbfaf5"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "background_image_position",
      "label": "Background image position",
      "default": "center center"
    },
    {
      "type": "select",
      "id": "background_image_size",
      "label": "Background image size",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" },
        { "value": "auto", "label": "Auto" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Decorative images"
    },
    {
      "type": "checkbox",
      "id": "show_decorative_images",
      "label": "Show decorative images",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "left_decor_image",
      "label": "Left decorative image"
    },
    {
      "type": "range",
      "id": "left_decor_width",
      "label": "Left image width",
      "min": 80,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "left_decor_opacity",
      "label": "Left image opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "left_decor_offset_x",
      "label": "Left image horizontal offset",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": -40
    },
    {
      "type": "range",
      "id": "left_decor_offset_y",
      "label": "Left image vertical offset",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": -20
    },
    {
      "type": "image_picker",
      "id": "right_decor_image",
      "label": "Right decorative image"
    },
    {
      "type": "range",
      "id": "right_decor_width",
      "label": "Right image width",
      "min": 80,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "right_decor_opacity",
      "label": "Right image opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "right_decor_offset_x",
      "label": "Right image horizontal offset",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "right_decor_offset_y",
      "label": "Right image vertical offset",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bottom_bar_background_color",
      "label": "Bottom bar background color",
      "default": "#f4f0e4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5d6160"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1f2628"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#b78f28"
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Footer menu"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Link list"
        },
        {
          "type": "range",
          "id": "width",
          "label": "Width",
          "min": 0,
          "max": 360,
          "step": 10,
          "unit": "px",
          "default": 0,
          "info": "Set to 0 for automatic width."
        },
        {
          "type": "text_alignment",
          "id": "text_alignment",
          "label": "Text alignment",
          "default": "left"
        }
      ]
    },
    {
      "type": "social_links",
      "name": "Social links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Get connected"
        },
        {
          "type": "url",
          "id": "facebook_url",
          "label": "Facebook URL"
        },
        {
          "type": "url",
          "id": "pinterest_url",
          "label": "Pinterest URL"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "Instagram URL"
        },
        {
          "type": "url",
          "id": "youtube_url",
          "label": "YouTube URL"
        },
        {
          "type": "url",
          "id": "tiktok_url",
          "label": "TikTok URL"
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon size",
          "min": 24,
          "max": 64,
          "step": 2,
          "unit": "px",
          "default": 40
        },
        {
          "type": "select",
          "id": "icon_style",
          "label": "Icon style",
          "options": [
            { "value": "outline", "label": "Outline circle" },
            { "value": "solid", "label": "Solid circle" },
            { "value": "plain", "label": "Plain" }
          ],
          "default": "outline"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image or SVG"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Secure checkout"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    },
    {
      "type": "payment_icons",
      "name": "Payment icons",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_shopify_payment_icons",
          "label": "Show Shopify payment icons",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "custom_payment_image",
          "label": "Custom payment image"
        }
      ]
    },
    {
      "type": "copyright_text",
      "name": "Copyright text",
      "settings": [
        {
          "type": "richtext",
          "id": "copyright",
          "label": "Copyright rich text",
          "default": "<p>Copyright © 2026 Your brand. All rights reserved.</p>"
        }
      ]
    },
    {
      "type": "custom_text",
      "name": "Custom text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Custom content"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Rich text",
          "default": "<p>Add supporting footer content here.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Optional button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Optional button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom footer",
      "category": "Footer",
      "blocks": {
        "menu_1": {
          "type": "menu_column",
          "settings": {
            "heading": "Footer menu"
          }
        },
        "social_1": {
          "type": "social_links",
          "settings": {
            "heading": "Get connected"
          }
        },
        "trust_1": {
          "type": "trust_badge",
          "settings": {
            "text": "Secure checkout"
          }
        },
        "payment_1": {
          "type": "payment_icons"
        },
        "copyright_1": {
          "type": "copyright_text"
        }
      },
      "block_order": ["menu_1", "social_1", "trust_1", "payment_1", "copyright_1"]
    }
  ]
}
{% endschema %}
