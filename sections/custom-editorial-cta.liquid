<section
  class="custom-editorial-cta"
  style="
    --custom-editorial-cta-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-cta-background: {{ section.settings.background_color }};
    --custom-editorial-cta-card-background: {{ section.settings.card_background_color }};
    --custom-editorial-cta-accent: {{ section.settings.accent_color }};
    --custom-editorial-cta-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-cta-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-cta-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-cta-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-cta-radius: {{ section.settings.card_radius }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-cta__inner">
    <div class="custom-editorial-cta__card">
      {%- if section.settings.decorative_pattern != blank -%}
        <div class="custom-editorial-cta__pattern" aria-hidden="true">
          {{
            section.settings.decorative_pattern
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '400,800,1200,1600,2000',
              sizes: '100vw',
              alt: ''
          }}
        </div>
      {%- endif -%}

      <div class="custom-editorial-cta__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-editorial-cta__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="custom-editorial-cta__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank -%}
          <div class="custom-editorial-cta__actions">
            {%- if section.settings.primary_button_label != blank and section.settings.primary_button_url != blank -%}
              <a class="custom-editorial-cta__button custom-editorial-cta__button--primary" href="{{ section.settings.primary_button_url }}">
                {{ section.settings.primary_button_label | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.secondary_button_label != blank and section.settings.secondary_button_url != blank -%}
              <a class="custom-editorial-cta__button custom-editorial-cta__button--secondary" href="{{ section.settings.secondary_button_url }}">
                {{ section.settings.secondary_button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-editorial-cta {
    background: var(--custom-editorial-cta-background);
  }

  .custom-editorial-cta__inner {
    max-width: var(--custom-editorial-cta-max-width);
    margin: 0 auto;
    padding:
      var(--custom-editorial-cta-padding-top-mobile)
      16px
      var(--custom-editorial-cta-padding-bottom-mobile);
  }

  .custom-editorial-cta__card {
    position: relative;
    overflow: hidden;
    border-radius: var(--custom-editorial-cta-radius);
    background: var(--custom-editorial-cta-card-background);
    text-align: center;
  }

  .custom-editorial-cta__pattern {
    position: absolute;
    inset: 0;
    opacity: 0.2;
    pointer-events: none;
  }

  .custom-editorial-cta__pattern img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-editorial-cta__content {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .custom-editorial-cta__heading {
    margin: 0;
  }

  .custom-editorial-cta__text {
    margin-top: 1rem;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .custom-editorial-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .custom-editorial-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .custom-editorial-cta__button--primary {
    background: var(--custom-editorial-cta-accent);
    color: #ffffff;
  }

  .custom-editorial-cta__button--secondary {
    border: 1px solid var(--custom-editorial-cta-accent);
    color: var(--custom-editorial-cta-accent);
  }

  @media screen and (min-width: 750px) {
    .custom-editorial-cta__inner {
      padding:
        var(--custom-editorial-cta-padding-top)
        48px
        var(--custom-editorial-cta-padding-bottom);
    }

    .custom-editorial-cta__content {
      padding: 3rem 4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom editorial CTA",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Call to action heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add a concise supporting message and invite visitors to keep exploring.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    },
    {
      "type": "image_picker",
      "id": "decorative_pattern",
      "label": "Decorative background pattern"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#f7f1e0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#b08a2f"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 480,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Custom editorial CTA"
    }
  ]
}
{% endschema %}
