{{ 'tup-home-rewards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tup-home-rewards.js' | asset_url }}" defer></script>

<tup-home-rewards
  id="tup-home-rewards-{{ section.id }}"
  class="tup-home-rewards tup-home-rewards--{{ section.settings.background_style }}"
  role="region"
  style="
    --tup-home-rewards-max-width: {% if section.settings.width_mode == 'full' %}100%{% elsif section.settings.width_mode == 'page' %}var(--page-width, 1200px){% else %}{{ section.settings.custom_max_width }}px{% endif %};
    --tup-home-rewards-padding-x-desktop: {{ section.settings.padding_x_desktop | default: 64 }}px;
    --tup-home-rewards-padding-x-mobile: {{ section.settings.padding_x_mobile | default: 16 }}px;
    --tup-home-rewards-padding-top-desktop: {{ section.settings.padding_top | default: 64 }}px;
    --tup-home-rewards-padding-bottom-desktop: {{ section.settings.padding_bottom | default: 64 }}px;
    --tup-home-rewards-padding-top-mobile: {{ section.settings.padding_top_mobile | default: 46 }}px;
    --tup-home-rewards-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 50 }}px;
    --tup-home-rewards-hero-gap-desktop: {{ section.settings.hero_gap_desktop | default: 72 }}px;
    --tup-home-rewards-card-gap-desktop: {{ section.settings.card_gap_desktop | default: 26 }}px;
    --tup-home-rewards-card-gap-mobile: {{ section.settings.card_gap_mobile | default: 16 }}px;
    --tup-home-rewards-cards-offset-desktop: {{ section.settings.cards_offset_desktop | default: 72 }}px;
    --tup-home-rewards-cards-offset-mobile: {{ section.settings.cards_offset_mobile | default: 32 }}px;
    --tup-home-rewards-card-padding-y-desktop: {{ section.settings.card_padding_y_desktop | default: 36 }}px;
    --tup-home-rewards-card-padding-x-desktop: {{ section.settings.card_padding_x_desktop | default: 28 }}px;
    --tup-home-rewards-card-padding-y-mobile: {{ section.settings.card_padding_y_mobile | default: 28 }}px;
    --tup-home-rewards-card-padding-x-mobile: {{ section.settings.card_padding_x_mobile | default: 20 }}px;
    --tup-home-rewards-eyebrow-size-desktop: {{ section.settings.eyebrow_font_size | default: 12 }}px;
    --tup-home-rewards-title-size-desktop: {{ section.settings.title_font_size | default: 40 }}px;
    --tup-home-rewards-body-size-desktop: {{ section.settings.body_font_size | default: 14 }}px;
    --tup-home-rewards-card-title-size-desktop: {{ section.settings.card_title_font_size | default: 18 }}px;
    --tup-home-rewards-card-text-size-desktop: {{ section.settings.card_text_font_size | default: 12 }}px;
    --tup-home-rewards-cta-size-desktop: {{ section.settings.cta_font_size_desktop | default: 12 }}px;
    --tup-home-rewards-eyebrow-size-mobile: {{ section.settings.eyebrow_font_size_mobile | default: 12 }}px;
    --tup-home-rewards-title-size-mobile: {{ section.settings.title_font_size_mobile | default: 28 }}px;
    --tup-home-rewards-body-size-mobile: {{ section.settings.body_font_size_mobile | default: 12 }}px;
    --tup-home-rewards-card-title-size-mobile: {{ section.settings.card_title_font_size_mobile | default: 18 }}px;
    --tup-home-rewards-card-text-size-mobile: {{ section.settings.card_text_font_size_mobile | default: 12 }}px;
    --tup-home-rewards-cta-size-mobile: {{ section.settings.cta_font_size_mobile | default: 12 }}px;
    --tup-home-rewards-bg-desktop: {{ section.settings.background_color_desktop | default: '#fbf2ec' }};
    --tup-home-rewards-bg-mobile: {{ section.settings.background_color_mobile | default: '#fbf2ec' }};
    --tup-home-rewards-eyebrow-color-desktop: {{ section.settings.eyebrow_color_desktop | default: '#bc9407' }};
    --tup-home-rewards-title-color-desktop: {{ section.settings.title_color_desktop | default: '#bc9407' }};
    --tup-home-rewards-body-color-desktop: {{ section.settings.body_color_desktop | default: '#5f6468' }};
    --tup-home-rewards-cta-bg-desktop: {{ section.settings.cta_background_desktop | default: '#bc9407' }};
    --tup-home-rewards-cta-text-desktop: {{ section.settings.cta_text_color_desktop | default: '#ffffff' }};
    --tup-home-rewards-card-bg-desktop: {{ section.settings.card_background_desktop | default: '#ffffff' }};
    --tup-home-rewards-card-title-color-desktop: {{ section.settings.card_title_color_desktop | default: '#bc9407' }};
    --tup-home-rewards-card-text-color-desktop: {{ section.settings.card_text_color_desktop | default: '#6b7280' }};
    --tup-home-rewards-icon-bg-desktop: {{ section.settings.icon_background_desktop | default: '#f7efe7' }};
    --tup-home-rewards-icon-color-desktop: {{ section.settings.icon_color_desktop | default: '#bc9407' }};
    --tup-home-rewards-eyebrow-color-mobile: {{ section.settings.eyebrow_color_mobile | default: '#bc9407' }};
    --tup-home-rewards-title-color-mobile: {{ section.settings.title_color_mobile | default: '#bc9407' }};
    --tup-home-rewards-body-color-mobile: {{ section.settings.body_color_mobile | default: '#5f6468' }};
    --tup-home-rewards-cta-bg-mobile: {{ section.settings.cta_background_mobile | default: '#bc9407' }};
    --tup-home-rewards-cta-text-mobile: {{ section.settings.cta_text_color_mobile | default: '#ffffff' }};
    --tup-home-rewards-card-bg-mobile: {{ section.settings.card_background_mobile | default: '#ffffff' }};
    --tup-home-rewards-card-title-color-mobile: {{ section.settings.card_title_color_mobile | default: '#bc9407' }};
    --tup-home-rewards-card-text-color-mobile: {{ section.settings.card_text_color_mobile | default: '#6b7280' }};
    --tup-home-rewards-icon-bg-mobile: {{ section.settings.icon_background_mobile | default: '#f7efe7' }};
    --tup-home-rewards-icon-color-mobile: {{ section.settings.icon_color_mobile | default: '#bc9407' }};
  "
  {{ section.shopify_attributes }}
>
  <div class="tup-home-rewards__inner">
    <div class="tup-home-rewards__hero">
      <div class="tup-home-rewards__media">
        {%- if section.settings.image != blank -%}
          {%- assign desktop_image_class = 'tup-home-rewards__image tup-home-rewards__image--desktop' -%}
          {%- if section.settings.mobile_image != blank -%}
            {%- assign desktop_image_class = desktop_image_class | append: ' tup-home-rewards__image--has-mobile' -%}
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              class: desktop_image_class,
              loading: 'lazy',
              widths: '360, 540, 720, 960, 1200',
              sizes: '(max-width: 749px) 100vw, 46vw',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'tup-home-rewards__image tup-home-rewards__placeholder' }}
        {%- endif -%}

        {%- if section.settings.mobile_image != blank -%}
          {{
            section.settings.mobile_image
            | image_url: width: 720
            | image_tag:
              class: 'tup-home-rewards__image tup-home-rewards__image--mobile',
              loading: 'lazy',
              widths: '320, 480, 640, 720',
              sizes: '100vw',
              alt: section.settings.mobile_image.alt
          }}
        {%- endif -%}
      </div>

      <div class="tup-home-rewards__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tup-home-rewards__eyebrow">
            <span></span>
            {{ section.settings.eyebrow | escape }}
            <span></span>
          </p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="tup-home-rewards__title">{{ section.settings.title | newline_to_br }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="tup-home-rewards__description">
            {{ section.settings.description | newline_to_br }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_cta and section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a class="tup-home-rewards__cta" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="tup-home-rewards__cards" role="list" data-tup-home-rewards-carousel>
      {%- for block in section.blocks -%}
        {%- if block.type == 'reward' -%}
          <article class="tup-home-rewards__card" role="listitem" {{ block.shopify_attributes }}>
            <div class="tup-home-rewards__card-icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'tag' -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M5 6.5V13l6.7 6.7a1.5 1.5 0 0 0 2.1 0l5.9-5.9a1.5 1.5 0 0 0 0-2.1L13 5H6.5A1.5 1.5 0 0 0 5 6.5Z" />
                    <path d="M8.8 8.8h.1" />
                  </svg>
                {%- when 'calendar' -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M7 4v3" />
                    <path d="M17 4v3" />
                    <path d="M5.5 6h13A1.5 1.5 0 0 1 20 7.5v10A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5v-10A1.5 1.5 0 0 1 5.5 6Z" />
                    <path d="M4 10h16" />
                    <path d="M8 13h2.5" />
                    <path d="M8 16h5" />
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M6.5 18.5c6.8.2 11-3.8 11-10.9 0-.7-.6-1.3-1.3-1.2C9.1 6.9 5.3 11 6.5 18.5Z" />
                    <path d="M6.8 18.2c2.4-4.5 5.2-7 9-8.9" />
                  </svg>
              {%- endcase -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="tup-home-rewards__card-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="tup-home-rewards__card-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</tup-home-rewards>

{% schema %}
