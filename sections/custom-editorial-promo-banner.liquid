{{ 'section-custom-editorial-promo-banner.css' | asset_url | stylesheet_tag }}
<section
  class="custom-editorial-promo-banner"
  {% if section.settings.range_tab_key != blank %}data-range-panel-key="{{ section.settings.range_tab_key | escape }}"{% endif %}
  style="
    --custom-editorial-promo-banner-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-promo-banner-background: {{ section.settings.background_color }};
    --custom-editorial-promo-banner-card-background: {{ section.settings.card_background_color }};
    --custom-editorial-promo-banner-heading: {{ section.settings.heading_color }};
    --custom-editorial-promo-banner-body: {{ section.settings.body_color }};
    --custom-editorial-promo-banner-accent: {{ section.settings.accent_color }};
    --custom-editorial-promo-banner-button-text: {{ section.settings.button_text_color }};
    --custom-editorial-promo-banner-button-bg: {{ section.settings.button_background_color }};
    --custom-editorial-promo-banner-button-border: {{ section.settings.button_border_color }};
    --custom-editorial-promo-banner-radius: {{ section.settings.banner_radius }}px;
    --custom-editorial-promo-banner-height: {{ section.settings.banner_height }}px;
    --custom-editorial-promo-banner-height-mobile: {{ section.settings.banner_height_mobile }}px;
    --custom-editorial-promo-banner-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-promo-banner-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-promo-banner-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-promo-banner-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-promo-banner-content-width: {{ section.settings.content_width }}px;
    --custom-editorial-promo-banner-content-padding: {{ section.settings.content_padding }}px;
    --custom-editorial-promo-banner-content-padding-mobile: {{ section.settings.content_padding_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-promo-banner__inner">
    {%- if section.settings.section_heading != blank -%}
      <header class="custom-editorial-promo-banner__header">
        <h2 class="custom-editorial-promo-banner__section-heading">{{ section.settings.section_heading | escape }}</h2>
      </header>
    {%- endif -%}

    <div class="custom-editorial-promo-banner__card">
      <div class="custom-editorial-promo-banner__media">
        {%- if section.settings.mobile_image != blank -%}
          <picture>
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
                {{ section.settings.mobile_image | image_url: width: 720 }} 720w,
                {{ section.settings.mobile_image | image_url: width: 960 }} 960w
              "
              sizes="100vw"
            >
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 3200
                | image_tag:
                  loading: 'lazy',
                  widths: '768,1200,1600,2000,2400,3200',
                  sizes: '100vw',
                  class: 'custom-editorial-promo-banner__image',
                  alt: section.settings.image.alt
              }}
            {%- else -%}
              {{
                section.settings.mobile_image
                | image_url: width: 3200
                | image_tag:
                  loading: 'lazy',
                  widths: '768,1200,1600,2000,2400,3200',
                  sizes: '100vw',
                  class: 'custom-editorial-promo-banner__image',
                  alt: section.settings.mobile_image.alt
              }}
            {%- endif -%}
          </picture>
        {%- elsif section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 3200
            | image_tag:
              loading: 'lazy',
              widths: '768,1200,1600,2000,2400,3200',
              sizes: '100vw',
              class: 'custom-editorial-promo-banner__image',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'custom-editorial-promo-banner__image custom-editorial-promo-banner__image--placeholder' }}
        {%- endif -%}
      </div>

      <div class="custom-editorial-promo-banner__overlay"></div>

      <div class="custom-editorial-promo-banner__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="custom-editorial-promo-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h3 class="custom-editorial-promo-banner__heading">{{ section.settings.heading | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="custom-editorial-promo-banner__text">
            {{ section.settings.text | escape | newline_to_br }}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- if section.settings.button_link != blank -%}
            <a class="custom-editorial-promo-banner__button" href="{{ section.settings.button_link }}">
              {{ section.settings.button_label | escape }}
            </a>
          {%- else -%}
            <span class="custom-editorial-promo-banner__button custom-editorial-promo-banner__button--static">
              {{ section.settings.button_label | escape }}
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Editorial promo banner",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "Tea Inspired"
    },
    {
      "type": "text",
      "id": "range_tab_key",
      "label": "Range tab key",
      "info": "Match a tab target key from the Range Hero to show this section when that pill is selected."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile banner image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Elixir Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevated Tea Experiences"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Crafted from handpicked Ceylon tea - perfect for iced teas, infused waters, tea mixology, shakes and smoothies."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover Elixir"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Banner base color",
      "default": "#f7ede6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1f1812"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#4b4137"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#b08a2f"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color",
      "default": "#b08a2f"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border color",
      "default": "#b08a2f"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Desktop banner height",
      "min": 260,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Mobile banner height",
      "min": 220,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "Banner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 220,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Content padding mobile",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Editorial promo banner"
    }
  ]
}
{% endschema %}
