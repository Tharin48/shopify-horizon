{{ 'section-custom-editorial-overlay-card.css' | asset_url | stylesheet_tag }}
<section
  class="custom-editorial-overlay-card custom-editorial-overlay-card--{{ section.settings.card_alignment }}"
  style="
    --custom-editorial-overlay-card-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-overlay-card-background: {{ section.settings.background_color }};
    --custom-editorial-overlay-card-card-background: {{ section.settings.card_background_color }};
    --custom-editorial-overlay-card-text-color: {{ section.settings.text_color }};
    --custom-editorial-overlay-card-accent: {{ section.settings.accent_color }};
    --custom-editorial-overlay-card-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-overlay-card-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-overlay-card-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-overlay-card-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-overlay-card-padding-inline: {{ section.settings.padding_inline }}px;
    --custom-editorial-overlay-card-padding-inline-mobile: {{ section.settings.padding_inline_mobile }}px;
    --custom-editorial-overlay-card-image-height: {{ section.settings.image_height_desktop }}px;
    --custom-editorial-overlay-card-image-height-mobile: {{ section.settings.image_height_mobile }}px;
    --custom-editorial-overlay-card-image-radius: {{ section.settings.image_radius }}px;
    --custom-editorial-overlay-card-card-radius: {{ section.settings.card_radius }}px;
    --custom-editorial-overlay-card-card-width: {{ section.settings.card_width_desktop }}px;
    --custom-editorial-overlay-card-card-width-mobile: {{ section.settings.card_width_mobile }}px;
    --custom-editorial-overlay-card-card-overlap: {{ section.settings.card_overlap_desktop }}px;
    --custom-editorial-overlay-card-card-overlap-mobile: {{ section.settings.card_overlap_mobile }}px;
    --custom-editorial-overlay-card-card-padding: {{ section.settings.card_padding_desktop }}px;
    --custom-editorial-overlay-card-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;
    --custom-editorial-overlay-card-content-max-width: {{ section.settings.content_max_width }}px;
    --custom-editorial-overlay-card-content-gap: {{ section.settings.content_gap }}px;
    --custom-editorial-overlay-card-heading-size: {{ section.settings.heading_size_desktop }}px;
    --custom-editorial-overlay-card-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --custom-editorial-overlay-card-subheading-size: {{ section.settings.subheading_size_desktop }}px;
    --custom-editorial-overlay-card-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --custom-editorial-overlay-card-body-size: {{ section.settings.body_size_desktop }}px;
    --custom-editorial-overlay-card-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --custom-editorial-overlay-card-button-gap: {{ section.settings.button_gap }}px;
    --custom-editorial-overlay-card-shadow-opacity: {{ section.settings.card_shadow_opacity | divided_by: 100.0 }};
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-overlay-card__inner">
    <div class="custom-editorial-overlay-card__media-shell">
      {%- if section.settings.image != blank -%}
        <div
          class="custom-editorial-overlay-card__media"
          style="
            --custom-editorial-overlay-card-image-position: {{ section.settings.image_position_desktop }};
            --custom-editorial-overlay-card-image-position-mobile: {{ section.settings.image_position_mobile }};
          "
        >
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1200 }}">
            {%- endif -%}
            {{
              section.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: 'lazy',
                widths: '480,720,960,1200,1600,2000,2400',
                sizes: '(min-width: 1200px) 88vw, 100vw',
                class: 'custom-editorial-overlay-card__image',
                alt: section.settings.image.alt
            }}
          </picture>
        </div>
      {%- elsif request.design_mode -%}
        <div class="custom-editorial-overlay-card__empty">Choose a background image for this section.</div>
      {%- endif -%}

      <div class="custom-editorial-overlay-card__card-shell">
        <div class="custom-editorial-overlay-card__card">
          <div class="custom-editorial-overlay-card__content">
            {%- assign has_content = false -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'eyebrow' -%}
                  {%- if block.settings.text != blank -%}
                    {%- assign has_content = true -%}
                    <p class="custom-editorial-overlay-card__eyebrow" {{ block.shopify_attributes }}>
                      {{ block.settings.text | escape }}
                    </p>
                  {%- endif -%}
                {%- when 'heading' -%}
                  {%- if block.settings.heading != blank -%}
                    {%- assign has_content = true -%}
                    <div class="custom-editorial-overlay-card__heading rte" {{ block.shopify_attributes }}>
                      {{ block.settings.heading }}
                    </div>
                  {%- endif -%}
                {%- when 'subheading' -%}
                  {%- if block.settings.text != blank -%}
                    {%- assign has_content = true -%}
                    <div class="custom-editorial-overlay-card__subheading rte" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}
                {%- when 'text' -%}
                  {%- if block.settings.text != blank -%}
                    {%- assign has_content = true -%}
                    <div class="custom-editorial-overlay-card__text rte" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}

            {%- assign has_valid_buttons = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'button' and block.settings.label != blank and block.settings.url != blank -%}
                {%- assign has_valid_buttons = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if has_valid_buttons -%}
              <div class="custom-editorial-overlay-card__actions">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'button' and block.settings.label != blank and block.settings.url != blank -%}
                    <a
                      class="custom-editorial-overlay-card__button custom-editorial-overlay-card__button--{{ block.settings.style }}"
                      href="{{ block.settings.url }}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.label | escape }}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if has_content == false and has_valid_buttons == false and request.design_mode -%}
              <div class="custom-editorial-overlay-card__empty custom-editorial-overlay-card__empty--card">
                Add heading, text, or button blocks to build this card.
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Editorial overlay card",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 10,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Image position desktop",
      "default": "center center",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Image position mobile",
      "default": "center center",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2b2a28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c6a34b"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1560
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Image height desktop",
      "min": 280,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 540
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image height mobile",
      "min": 220,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "header",
      "content": "Card layout"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card alignment desktop",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "card_width_desktop",
      "label": "Card width desktop",
      "min": 320,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 960
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card width mobile",
      "min": 220,
      "max": 760,
      "step": 10,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 280,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 860
