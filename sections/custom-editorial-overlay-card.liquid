    {
      "type": "range",
      "id": "card_overlap_desktop",
      "label": "Card overlap desktop",
      "min": 0,
      "max": 260,
      "step": 4,
      "unit": "px",
      "default": 116
    },
    {
      "type": "range",
      "id": "card_overlap_mobile",
      "label": "Card overlap mobile",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_padding_desktop",
      "label": "Card padding desktop",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
