    .custom-header[data-minimized-nav='center'][data-header-state='minimized'] .custom-header__nav :is(.menu-list, .menu-list__list),
    .custom-header[data-minimized-nav='center'][data-header-state='hidden'] .custom-header__nav :is(.menu-list, .menu-list__list) {
