    /* ── Minimized (+ hidden) desktop layout ──────────────────────────────────────
     *
     * Single row: [Logo][Nav items]──────────────────[Icons]
     *  or with right alignment: [Logo]──────────────[Nav items][Icons]
     *
     * Logo has no vertical padding — it stretches to fill the full minimized height.
     * Menu items and icons are vertically centered in the row.
     * ──────────────────────────────────────────────────────────────────────────── */

    .custom-header[data-header-state='minimized'] .custom-header__primary-inner,
    .custom-header[data-header-state='hidden'] .custom-header__primary-inner {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: stretch; /* logo, lower all stretch to full height */
      padding-block: 0;     /* logo fills the entire minimized-height — no dead space */
      gap: 0;               /* logo flush against nav; spacing handled inside lower */
      min-height: var(--custom-header-minimized-height);
    }

    /*
     * Dissolve the mobile wrapper divs so .custom-header__logo-row participates
     * directly as a flex child of .custom-header__primary-inner.
     * On mobile these already use display:contents (set in custom-header.css).
     * On desktop they default to display:block which made the logo-row a block
     * inside a full-width box — causing the big gap between logo and nav items.
