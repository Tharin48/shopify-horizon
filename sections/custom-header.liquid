    /* ── Menu alignment: CENTER ──────────────────────────────────────────────────
     * [Logo] ───────────── [Nav items] ───────────── [Icons]
     * ─────────────────────────────────────────────────────────────────────────── */
    .custom-header[data-minimized-nav='center'][data-header-state='minimized'] .custom-header__nav,
    .custom-header[data-minimized-nav='center'][data-header-state='hidden'] .custom-header__nav {
