    /* Logo link fills the full minimized height */
    .custom-header[data-header-state='minimized'] .custom-header__logo-link,
    .custom-header[data-header-state='hidden'] .custom-header__logo-link {
      display: flex;
      align-items: center;
      height: 100%;
      justify-content: flex-start;
    }

    /* Image fills the available height — no square cap, purely height-driven */
    .custom-header[data-header-state='minimized'] .custom-header__logo-img,
    .custom-header[data-header-state='hidden'] .custom-header__logo-img {
      height: 100%;
      width: auto;
      max-width: none;
      max-height: var(--custom-header-minimized-height);
      object-fit: contain;
    }

    /* Lower becomes a single flex row (nav + actions side by side) */
    .custom-header[data-header-state='minimized'] .custom-header__lower,
    .custom-header[data-header-state='hidden'] .custom-header__lower {
      display: flex;
      flex-direction: row;
      align-items: center;
      flex: 1 1 auto;
      min-width: 0;
      gap: var(--gap-md);
    }

    .custom-header[data-header-state='minimized'] .custom-header__horizon-menu,
