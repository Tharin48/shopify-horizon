    .custom-header[data-header-state='minimized'] .custom-header__mobile,
    .custom-header[data-header-state='hidden'] .custom-header__mobile,
    .custom-header[data-header-state='minimized'] .custom-header__mobile-top,
    .custom-header[data-header-state='hidden'] .custom-header__mobile-top {
      display: contents;
    }

    /* Logo column stretches to full height so the image fills edge-to-edge */
    .custom-header[data-header-state='minimized'] .custom-header__logo-row,
    .custom-header[data-header-state='hidden'] .custom-header__logo-row {
      flex: 0 0 auto;
      width: auto;
      align-self: stretch;
      display: flex;
      align-items: center;
      padding-inline-end: var(--gap-md); /* breathing room before the nav */
    }

    .custom-header[data-header-state='minimized'] .custom-header__logo,
    .custom-header[data-header-state='hidden'] .custom-header__logo {
      display: flex;
      align-items: center;
      height: 100%;
      text-align: left;
