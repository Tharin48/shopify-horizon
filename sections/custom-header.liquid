    /* Menu list horizontal in minimized */
    .custom-header[data-header-state='minimized'] .custom-header__menu-list,
    .custom-header[data-header-state='hidden'] .custom-header__menu-list {
      justify-content: flex-start;
      flex-wrap: nowrap;
    }
  }

  .custom-header__menu-link:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  /* ── Desktop search bar row ──────────────────────────────────────────────────
   * Pill-shaped search bar rendered as a third row below the nav.
   * Always white background + dark text so it reads clearly on any hero image.
   * Only visible in transparent state (homepage hero) on desktop (≥750px).
   * Focus state: gold border (#BC9407) matching brand accent.
   * ─────────────────────────────────────────────────────────────────────────── */

  .custom-header__desktop-search-row {
    display: none; /* hidden by default for all states and screen sizes */
    position: relative;
    z-index: 25;
    width: 100%;
    order: 3; /* appears after logo row and lower row in the column flex */
  }

  @media screen and (min-width: 750px) {
    /* Only reveal in the transparent (homepage hero) state */
    .custom-header[data-header-state='transparent'] .custom-header__desktop-search-row {
      display: block;
      padding-block: var(--gap-sm) var(--padding-sm);
    }

    /* Wrapper anchors the absolutely-positioned dropdown to the search bar */
    .custom-header__desktop-search-wrap {
      position: relative;
      width: 100%;
      max-width: 680px;
      margin-inline: auto;
    }

    /*
     * "Default search" mode: a pill-shaped button that mimics the form visually
     * but opens the theme's predictive search modal when clicked.
     * Shares all base styles with .custom-header__desktop-search-form.
     */
    .custom-header__desktop-search-default-btn {
      max-width: 680px;
      margin-inline: auto;
      cursor: pointer;
      text-align: start;
      justify-content: space-between;
    }

    .custom-header__desktop-search-placeholder-text {
      flex: 1;
      font-size: 0.9375rem;
      color: var(--custom-header-search-color, #121212);
      opacity: 0.55;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .custom-header__desktop-search-default-btn:hover {
      border-color: var(--custom-header-search-focus, #bc9407);
    }

    .custom-header__desktop-search-default-btn:focus-visible {
      border-color: var(--custom-header-search-focus, #bc9407);
      border-width: 2px;
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--custom-header-search-focus, #bc9407) 22%, transparent);
      outline: none;
    }

    .custom-header__desktop-search-form {
      display: flex;
      align-items: center;
      width: 100%;
      min-height: 48px;
      padding-inline-start: 1.375rem;
      padding-inline-end: 0.5rem;
      border-radius: 9999px;
      /*
       * Uses theme-controlled CSS variables — NOT currentColor.
       * The transparent header sets currentColor to white, so inheriting it
       * would produce invisible white text on white background.
       */
      background: var(--custom-header-search-bg, #ffffff);
      color: var(--custom-header-search-color, #121212);
      border: 1.5px solid var(--custom-header-search-border, #d4d4d4);
      gap: var(--gap-sm);
      transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease;
    }

    /* Active/focus state — themed accent border + soft glow */
    .custom-header__desktop-search-form:focus-within {
      border-color: var(--custom-header-search-focus, #bc9407);
      border-width: 2px;
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--custom-header-search-focus, #bc9407) 22%, transparent);
    }

    .custom-header__desktop-search-input {
      flex: 1;
      min-width: 0;
      border: none;
      /*
       * The Shopify theme's base.css applies `background: var(--color-input-background)`
       * to every input element. That rule wins over a plain `background: transparent`
       * regardless of -webkit-appearance. `!important` is the only reliable override
       * here — we are intentionally fighting the theme base stylesheet.
       */
      -webkit-appearance: none;
      appearance: none;
      background: transparent !important;
      background-color: transparent !important;
      color: var(--custom-header-search-color, #121212);
      font: inherit;
      font-size: 0.9375rem;
      outline: none;
      padding: 0;
    }

    /* Autofill background override — browsers force a blue/yellow tint on autofilled inputs */
    .custom-header__desktop-search-input:-webkit-autofill,
    .custom-header__desktop-search-input:-webkit-autofill:hover,
    .custom-header__desktop-search-input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0 1000px var(--custom-header-search-bg, #ffffff) inset;
      -webkit-text-fill-color: var(--custom-header-search-color, #121212);
      caret-color: var(--custom-header-search-color, #121212);
    }

    .custom-header__desktop-search-input::placeholder {
      color: var(--custom-header-search-color, #121212);
      opacity: 0.5;
    }

    /* Show the native browser clear (×) button — matches style guide active state */
    .custom-header__desktop-search-input::-webkit-search-decoration {
      display: none;
    }

    /* Search submit (icon) button */
    .custom-header__desktop-search-submit {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      background: transparent;
      border: none;
      border-radius: 9999px;
      color: var(--custom-header-search-color, #121212);
      cursor: pointer;
      padding: 0;
      line-height: 1;
    }

    .custom-header__desktop-search-submit:focus-visible {
      outline: 2px solid var(--custom-header-search-focus, #bc9407);
      outline-offset: 2px;
    }

    .custom-header__desktop-search-submit .svg-wrapper {
      display: inline-flex;
      align-items: center;
    }

    .custom-header__desktop-search-submit .svg-wrapper svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    /*
     * Homepage typewriter “placeholder” (editor-controlled copy). Native
     * placeholders cannot animate; this overlay mimics placeholder styling and
     * hides on focus, when the field has a value, or when the tab is hidden.
     */
    .custom-header__desktop-search-form--typing {
      position: relative;
    }

    .custom-header__desktop-search-typing {
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      inset-inline-end: 0;
      display: flex;
      align-items: center;
      pointer-events: none;
      padding-inline-start: 1.375rem;
      padding-inline-end: 3rem;
      font: inherit;
      font-size: 0.9375rem;
      color: var(--custom-header-search-typing-color, var(--custom-header-search-color, #121212));
      opacity: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: opacity 0.15s ease;
    }

    .custom-header__desktop-search-typing:not(:empty)::after {
      content: '';
      display: inline-block;
      width: 1px;
      height: 1em;
      margin-inline-start: 1px;
      background: currentcolor;
      animation: custom-header-typing-cursor 1s step-end infinite;
      vertical-align: text-bottom;
    }

    @keyframes custom-header-typing-cursor {
      0%,
      50% {
        opacity: 1;
      }
      51%,
      100% {
        opacity: 0;
      }
    }

    .custom-header__desktop-search-form--typing:focus-within .custom-header__desktop-search-typing,
    .custom-header__desktop-search-form--typing.custom-header__desktop-search-form--has-query
      .custom-header__desktop-search-typing {
      opacity: 0;
      visibility: hidden;
    }

    .custom-header__desktop-search-form--typing:focus-within .custom-header__desktop-search-typing::after,
    .custom-header__desktop-search-form--typing.custom-header__desktop-search-form--has-query
      .custom-header__desktop-search-typing::after {
      animation: none;
    }
  }

  /* ── Search dropdown ──────────────────────────────────────────────────────
   * Google-style autocomplete panel: recent searches, recently viewed, and
   * live predictive results (query suggestions + product cards).
   * Always white background + dark text — independent of header color state.
   * ─────────────────────────────────────────────────────────────────────── */

  .custom-header__search-dropdown {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 6px);
    background: #ffffff;
    color: #121212;
    border-radius: 16px;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.08),
      0 16px 48px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    z-index: 20;
    max-height: 74vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .custom-header__search-dropdown[hidden] {
    display: none;
  }

  /* Section dividers */
  .ch-search-section {
    padding: 14px 16px 10px;
  }

  .ch-search-section + .ch-search-section {
    border-top: 1px solid rgba(18, 18, 18, 0.07);
  }

  .ch-search-section__title {
    margin: 0 0 10px;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(18, 18, 18, 0.42);
  }

  /* Query / recent suggestion rows */
  .ch-search-queries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ch-search-suggestion {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 10px;
    border: none;
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
    color: #121212;
    font: inherit;
    font-size: 0.9375rem;
    text-align: start;
    transition: background 0.12s;
    line-height: 1.3;
  }

  .ch-search-suggestion:hover,
  .ch-search-suggestion[data-focused='true'] {
    background: rgba(18, 18, 18, 0.055);
    outline: none;
  }

  .ch-search-suggestion__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    color: rgba(18, 18, 18, 0.38);
  }

  .ch-search-suggestion__text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Bold the typed portion in suggestions (Shopify wraps it in <em>) */
  .ch-search-suggestion__text em {
    font-style: normal;
    font-weight: 700;
  }

  .ch-search-suggestion__remove {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    margin-inline-start: auto;
    border: none;
    background: transparent;
    border-radius: 50%;
    cursor: pointer;
    color: rgba(18, 18, 18, 0.38);
    font-size: 1.1rem;
    line-height: 1;
    transition: background 0.12s, color 0.12s;
  }

  .ch-search-suggestion__remove:hover {
    background: rgba(18, 18, 18, 0.08);
    color: #121212;
  }

  /* Product grid */
  .ch-search-products {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .ch-search-product-link {
    display: block;
    text-decoration: none;
    color: #121212;
    border-radius: 10px;
    padding: 4px;
    transition: background 0.12s;
  }

  .ch-search-product-link:hover {
    background: rgba(18, 18, 18, 0.045);
  }

  .ch-search-product-img-wrap {
    border-radius: 8px;
    overflow: hidden;
    background: rgba(18, 18, 18, 0.05);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ch-search-product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ch-search-product-info {
    padding: 6px 2px 2px;
  }

  .ch-search-product-title {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    margin: 0 0 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: #121212;
  }

  .ch-search-product-price {
    font-size: 0.6875rem;
    color: rgba(18, 18, 18, 0.55);
    display: block;
  }

  /* Footer — "See all results" */
  .ch-search-footer {
    padding: 10px 16px 14px;
    border-top: 1px solid rgba(18, 18, 18, 0.07);
    text-align: center;
  }

  .ch-search-footer__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(18, 18, 18, 0.62);
    text-decoration: none;
  }

  .ch-search-footer__link:hover {
    color: #121212;
    text-decoration: underline;
  }

  /* Loading / empty states */
  .ch-search-loading,
  .ch-search-empty {
    padding: 24px 16px;
    text-align: center;
    color: rgba(18, 18, 18, 0.4);
    font-size: 0.875rem;
  }
{% endstylesheet %}

