{% liquid
  assign featured_collection = section.settings.collection
  assign product_limit = section.settings.products_limit | default: 6
  assign has_products = false
  if featured_collection != blank and featured_collection.products_count > 0
    assign has_products = true
  endif

  assign show_banner_subtitle = section.settings.show_banner_subtitle
  assign show_banner_title = section.settings.show_banner_title
  assign show_banner_button = section.settings.show_banner_button
  assign show_banner_overlay = true
  if section.settings.show_banner_overlay == false
    assign show_banner_overlay = false
  endif

  assign horizontal_position = 'flex-start'
  case section.settings.banner_text_horizontal_position
    when 'center'
      assign horizontal_position = 'center'
    when 'right'
      assign horizontal_position = 'flex-end'
  endcase

  assign vertical_position = 'flex-end'
  case section.settings.banner_text_vertical_position
    when 'top'
      assign vertical_position = 'flex-start'
    when 'middle'
      assign vertical_position = 'center'
  endcase

  assign text_alignment = section.settings.banner_text_alignment | default: 'left'
  assign desktop_content_alignment = 'start'
  case section.settings.desktop_content_alignment
    when 'middle'
      assign desktop_content_alignment = 'center'
    when 'bottom'
      assign desktop_content_alignment = 'end'
  endcase
  assign show_custom_eyebrow = false
  if section.settings.use_custom_eyebrow_label and section.settings.custom_eyebrow_label != blank
    assign show_custom_eyebrow = true
  endif

  assign fepc_show_decor = false
  if section.settings.show_left_leaf and section.settings.left_leaf_image != blank
    assign fepc_show_decor = true
  endif
  if section.settings.show_right_leaf and section.settings.right_leaf_image != blank
    assign fepc_show_decor = true
  endif

  capture banner_overlay_style
    unless section.settings.banner_overlay_color == blank
      echo '--fepc-overlay-background: ' | append: section.settings.banner_overlay_color | append: ';'
    endunless
  endcapture

  assign fepc_banner_media = section.settings.banner_image | default: section.settings.mobile_banner_image
  assign fepc_banner_alt = ''
  if fepc_banner_media != blank
    assign fepc_banner_alt = fepc_banner_media.alt | strip
    if fepc_banner_alt == blank and section.settings.title != blank
      assign fepc_banner_alt = section.settings.title | strip
    endif
    if fepc_banner_alt == blank and section.settings.section_heading != blank
      assign fepc_banner_alt = section.settings.section_heading | strip
    endif
    if fepc_banner_alt == blank
      assign fepc_banner_alt = 'accessibility.promo_banner_image' | t
    endif
  endif
%}

{% liquid
  assign defer_section_css = false
  if request.page_type == 'index' and section.index > 2
    assign defer_section_css = true
  endif
%}

{% # theme-check-disable MissingAsset %}
{{- 'teamakers-product-card.css' | asset_url | stylesheet_tag -}}
{{- 'featured-editorial-product-carousel.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'featured-editorial-product-carousel.js' | asset_url }}" defer></script>
{% # theme-check-enable MissingAsset %}

{% capture banner_body %}
  <div class="fepc__banner-media">
    {% if section.settings.banner_image != blank or section.settings.mobile_banner_image != blank %}
      <picture>
        {% if section.settings.mobile_banner_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.mobile_banner_image | image_url: width: 600 }} 600w,
              {{ section.settings.mobile_banner_image | image_url: width: 900 }} 900w
            "
          >
        {% endif %}
        {{
          section.settings.banner_image
          | default: section.settings.mobile_banner_image
          | image_url: width: 1600
          | image_tag:
            class: 'fepc__banner-image',
            loading: 'lazy',
            widths: '600,800,1100,1400,1600',
            sizes: '(max-width: 749px) 86vw, (max-width: 989px) 42vw, 34vw',
            alt: fepc_banner_alt
        }}
      </picture>
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'fepc__banner-image fepc__banner-image--placeholder' }}
    {% endif %}
  </div>
  <div class="fepc__banner-overlay{% unless show_banner_overlay %} fepc__banner-overlay--hidden{% endunless %}"{% if banner_overlay_style != blank %} style="{{ banner_overlay_style | strip }}"{% endif %}></div>
  <div class="fepc__banner-content">
    {% if show_banner_subtitle and section.settings.subtitle != blank %}
      <p class="fepc__banner-subtitle">{{ section.settings.subtitle | escape }}</p>
    {% endif %}
    {% if show_banner_title and section.settings.title != blank %}
      <h3 class="fepc__banner-title">{{ section.settings.title | escape }}</h3>
    {% endif %}
    {% if show_banner_button and section.settings.button_label != blank %}
      {% liquid
        assign banner_button_icon_name = section.settings.banner_button_icon | default: 'arrow'
        assign banner_button_icon_image = blank
        assign banner_button_variant = 'primary'
        assign banner_button_border_width = 1
        assign banner_button_padding_vertical = 15
        assign banner_button_padding_horizontal = 23
        assign banner_button_use_custom_colors = false

        if banner_button_icon_name == 'custom'
          assign banner_button_icon_name = 'arrow'
          assign banner_button_icon_image = section.settings.banner_button_icon_image
        endif

        if section.settings.banner_button_color_source == 'custom'
          assign banner_button_use_custom_colors = true
        endif

        case section.settings.button_style
          when 'outline'
            assign banner_button_variant = 'secondary'
          when 'text'
            assign banner_button_variant = 'link'
            assign banner_button_border_width = 0
            assign banner_button_padding_vertical = 0
            assign banner_button_padding_horizontal = 0
        endcase
      %}
      {% render 'button',
        label: section.settings.button_label,
        link: section.settings.button_link,
        variant: banner_button_variant,
        show_icon: section.settings.show_banner_button_icon,
        icon: banner_button_icon_name,
        custom_icon_image: banner_button_icon_image,
        icon_position: section.settings.banner_button_icon_position,
        icon_size: section.settings.banner_button_icon_size,
        icon_spacing: section.settings.banner_button_icon_gap,
        font_size: section.settings.banner_button_font_size,
        font_weight: 400,
        padding_vertical: banner_button_padding_vertical,
        padding_horizontal: banner_button_padding_horizontal,
        border_radius: 999,
        border_width: banner_button_border_width,
        use_custom_colors: banner_button_use_custom_colors,
        background: section.settings.banner_button_background_color,
        text_color: section.settings.banner_button_text_color,
        border_color: section.settings.banner_button_border_color,
        hover_background: section.settings.banner_button_background_color,
        hover_text_color: section.settings.banner_button_text_color,
        hover_border_color: section.settings.banner_button_border_color,
        icon_color: section.settings.banner_button_icon_color,
        class_name: 'fepc__banner-button'
      %}
    {% endif %}
  </div>
{% endcapture %}
<section
  id="FeaturedEditorialProductCarousel-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} featured-editorial-carousel color-{{ section.settings.color_scheme }}"
  data-featured-editorial-carousel
  data-section-id="{{ section.id }}"
  data-card-background-style="{{ section.settings.card_background_style }}"
  style="
    --fepc-background: {{ section.settings.background_color }};
    --fepc-heading: {{ section.settings.heading_color }};
    --fepc-subheading: {{ section.settings.subtitle_color }};
    --fepc-card-bg: {{ section.settings.card_background }};
    --fepc-card-bg-solid: {{ section.settings.card_background | color_modify: 'alpha', section.settings.card_background_opacity | divided_by: 100.0 }};
    {% if section.settings.product_card_image_background != blank %}--tp-card-media-bg: {{ section.settings.product_card_image_background }};{% endif %}
    --fepc-card-text: {{ section.settings.card_text_color }};
    --fepc-card-muted: {{ section.settings.card_muted_text_color }};
    --fepc-price: {{ section.settings.price_color }};
    --fepc-sale: {{ section.settings.sale_price_color }};
    --fepc-button-bg: {{ section.settings.banner_button_background_color }};
    --fepc-button-text: {{ section.settings.banner_button_text_color }};
    --fepc-button-border: {{ section.settings.banner_button_border_color }};
    --fepc-button-icon-color: {{ section.settings.banner_button_icon_color }};
    --fepc-arrow-bg: {{ section.settings.arrow_background_color }};
    --fepc-arrow-color: {{ section.settings.arrow_icon_color }};
    --fepc-arrow-border: {{ section.settings.arrow_border_color }};
    --fepc-banner-subtitle-color: {{ section.settings.banner_subtitle_color }};
    --fepc-banner-title-color: {{ section.settings.banner_title_color }};
    --fepc-section-subheading-size: {{ section.settings.section_subheading_size }}px;
    --fepc-section-heading-size: {{ section.settings.section_heading_size }}px;
    --fepc-section-heading-size-mobile: {{ section.settings.section_heading_size_mobile }}px;
    --fepc-banner-subtitle-size: {{ section.settings.banner_subtitle_size }}px;
    --fepc-banner-subtitle-size-mobile: {{ section.settings.banner_subtitle_size_mobile }}px;
    --fepc-banner-title-size-desktop: {{ section.settings.banner_title_size_desktop }}px;
    --fepc-banner-title-size-mobile: {{ section.settings.banner_title_size_mobile }}px;
    --fepc-banner-title-max-width: {{ section.settings.banner_title_max_width }}ch;
    --fepc-banner-button-font-size: {{ section.settings.banner_button_font_size }}px;
    --fepc-banner-button-icon-size: {{ section.settings.banner_button_icon_size }}px;
    --fepc-banner-button-icon-gap: {{ section.settings.banner_button_icon_gap }}px;
    --fepc-banner-content-gap: {{ section.settings.banner_content_gap }}px;
    --fepc-banner-content-padding-desktop: {{ section.settings.banner_content_padding_desktop }}px;
    --fepc-banner-content-padding-mobile: {{ section.settings.banner_content_padding_mobile }}px;
    --fepc-gap: {{ section.settings.card_gap }}px;
    --fepc-banner-width: {{ section.settings.desktop_banner_width }}%;
    --fepc-products-desktop: {{ section.settings.products_per_view_desktop }};
    --fepc-products-tablet: {{ section.settings.products_per_view_tablet }};
    --fepc-mobile-card-width: {{ section.settings.mobile_card_width }}px;
    --fepc-pad-top: {{ section.settings.padding_top }}px;
    --fepc-pad-bottom: {{ section.settings.padding_bottom }}px;
    --fepc-radius: {{ section.settings.corner_radius }}px;
    --fepc-banner-height-desktop: {{ section.settings.banner_height_desktop }}px;
    --fepc-banner-height-mobile: {{ section.settings.banner_height_mobile }}px;
    --fepc-overlay-start: {{ section.settings.overlay_start_color | color_modify: 'alpha', section.settings.overlay_start_opacity | divided_by: 100.0 }};
    --fepc-overlay-end: {{ section.settings.overlay_end_color | color_modify: 'alpha', section.settings.overlay_end_opacity | divided_by: 100.0 }};
    --fepc-overlay-highlight: {{ section.settings.overlay_highlight_color | color_modify: 'alpha', section.settings.overlay_highlight_opacity | divided_by: 100.0 }};
    --fepc-banner-content-x: {{ horizontal_position }};
    --fepc-banner-content-y: {{ vertical_position }};
    --fepc-banner-text-align: {{ text_alignment }};
    --fepc-desktop-content-align: {{ desktop_content_alignment }};
    --fepc-left-leaf-x: {{ section.settings.left_leaf_offset_x }}px;
    --fepc-left-leaf-y: {{ section.settings.left_leaf_offset_y }}px;
    --fepc-right-leaf-x: {{ section.settings.right_leaf_offset_x }}px;
    --fepc-right-leaf-y: {{ section.settings.right_leaf_offset_y }}px;
  ">
  {% if fepc_show_decor %}
    <div class="fepc__decor" aria-hidden="true">
      {% if section.settings.show_left_leaf and section.settings.left_leaf_image != blank %}
        <div class="fepc__leaf fepc__leaf--left{% if section.settings.hide_decorations_on_mobile %} fepc__leaf--hide-mobile{% endif %}">
          {{
            section.settings.left_leaf_image | image_url: width: 420 | image_tag: class: 'fepc__leaf-image', loading: 'lazy', widths: '140,220,320,420', sizes: '(max-width: 749px) 20vw, 12vw', alt: ''
          }}
        </div>
      {% endif %}

      {% if section.settings.show_right_leaf and section.settings.right_leaf_image != blank %}
        <div class="fepc__leaf fepc__leaf--right{% if section.settings.hide_decorations_on_mobile %} fepc__leaf--hide-mobile{% endif %}">
          {{
            section.settings.right_leaf_image | image_url: width: 420 | image_tag: class: 'fepc__leaf-image', loading: 'lazy', widths: '140,220,320,420', sizes: '(max-width: 749px) 20vw, 12vw', alt: ''
          }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="fepc__wrap">
    <div class="fepc__intro">
      <div class="fepc__intro-copy">
        {% if section.settings.show_section_subheading and section.settings.section_subheading != blank %}
          <p class="fepc__section-subheading">{{ section.settings.section_subheading | escape }}</p>
        {% endif %}
        {% if section.settings.show_section_heading and section.settings.section_heading != blank %}
          <h2 class="fepc__section-heading">{{ section.settings.section_heading | escape }}</h2>
        {% endif %}
      </div>

      {% if section.settings.show_arrow_controls and section.settings.show_arrow_controls_mobile %}
        <div class="fepc__controls fepc__controls--mobile" aria-label="Carousel controls">
          <button
            type="button"
            class="fepc__arrow fepc__arrow--{{ section.settings.arrow_style }}"
            data-carousel-prev
            aria-label="Show previous products">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false">
              <path
                d="M14.5 5.5 8 12l6.5 6.5"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.7" />
            </svg>
          </button>
          <button
            type="button"
            class="fepc__arrow fepc__arrow--{{ section.settings.arrow_style }}"
            data-carousel-next
            aria-label="Show next products">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false">
              <path
                d="M9.5 5.5 16 12l-6.5 6.5"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.7" />
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    <div class="fepc__layout">
      <article class="fepc__banner-card fepc__banner-card--desktop">
        {{ banner_body }}
      </article>

      <div class="fepc__products-column">
        {% if section.settings.show_arrow_controls %}
          <div class="fepc__products-top">
            <div class="fepc__controls fepc__controls--desktop" aria-label="Carousel controls">
              <button
                type="button"
                class="fepc__arrow fepc__arrow--{{ section.settings.arrow_style }}"
                data-carousel-prev
                aria-label="Show previous products">
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false">
                  <path
                    d="M14.5 5.5 8 12l6.5 6.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.7" />
                </svg>
              </button>
              <button
                type="button"
                class="fepc__arrow fepc__arrow--{{ section.settings.arrow_style }}"
                data-carousel-next
                aria-label="Show next products">
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false">
                  <path
                    d="M9.5 5.5 16 12l-6.5 6.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.7" />
                </svg>
              </button>
            </div>
          </div>
        {% endif %}

        {% if request.design_mode and has_products == false %}
          <div class="fepc__editor-note">
            {% if featured_collection == blank %}
              Select a collection to populate this carousel. Placeholder cards are shown until products are connected.
            {% else %}
              The selected collection does not contain products yet. Placeholder cards are shown to help with layout.
            {% endif %}
          </div>
        {% endif %}

        <div
          class="fepc__viewport"
          data-carousel-viewport
          tabindex="0"
          aria-label="Featured products carousel">
          <div class="fepc__track" data-carousel-track>
            <article class="fepc__banner-card fepc__banner-card--mobile" aria-label="Featured editorial banner">
              {{ banner_body }}
            </article>

            {% if has_products %}
              {% for product in featured_collection.products limit: product_limit %}
                {% liquid
                  assign card_eyebrow = blank
                  if show_custom_eyebrow
                    assign card_eyebrow = section.settings.custom_eyebrow_label
                  endif
                %}
                <div class="fepc__product-card" data-product-card>
                  {% render 'teamakers-product-card'
                    , product: product
                    , eyebrow: card_eyebrow
                    , show_vendor: section.settings.show_vendor
                    , show_review: section.settings.show_review_placeholder
                    , show_quick_add: section.settings.show_quick_cart
                    , quick_add_mode: 'horizon'
                    , section_id: section.id
                    , image_sizes: '(max-width: 989px) min(78vw, 340px), 18vw'
                    , placeholder: false
                  %}
                </div>
              {% endfor %}
            {% else %}
              {% for index in (1..product_limit) %}
                <div class="fepc__product-card fepc__product-card--placeholder" data-product-card>
                  {% render 'teamakers-product-card'
                    , show_review: section.settings.show_review_placeholder
                    , placeholder: true
                  %}
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Editorial carousel",
    "tag": "section",
    "class": "shopify-section-featured-editorial-carousel",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-1"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "page-width",
        "options": [
          {
            "value": "page-width",
            "label": "Page width"
          }, {
            "value": "full-width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      }, {
        "type": "range",
        "id": "products_limit",
        "label": "Products limit",
        "min": 1,
        "max": 12,
        "step": 1,
        "default": 6
      }, {
        "type": "text",
        "id": "section_subheading",
        "label": "Section subheading",
        "default": "Editorial selection"
      }, {
        "type": "checkbox",
        "id": "show_section_subheading",
        "label": "Show section subheading",
        "default": true
      }, {
        "type": "text",
        "id": "section_heading",
        "label": "Section heading",
        "default": "Rare Finds"
      }, {
        "type": "checkbox",
        "id": "show_section_heading",
        "label": "Show section heading",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show product vendor",
        "default": true
      }, {
        "type": "checkbox",
        "id": "use_custom_eyebrow_label",
        "label": "Use custom eyebrow label instead of vendor",
        "default": false
      }, {
        "type": "text",
        "id": "custom_eyebrow_label",
        "label": "Custom eyebrow label",
        "default": "Rare find"
      }, {
        "type": "checkbox",
        "id": "show_review_placeholder",
        "label": "Show review placeholder",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_quick_cart",
        "label": "Show quick cart button",
        "default": true
      }, {
        "type": "color_background",
        "id": "product_card_image_background",
        "label": "Product card image background"
      }, {
        "type": "header",
        "content": "Banner"
      }, {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Banner image"
      }, {
        "type": "image_picker",
        "id": "mobile_banner_image",
        "label": "Mobile banner image"
      }, {
        "type": "text",
        "id": "subtitle",
        "label": "Banner subtitle",
        "default": "Curated for slow afternoons"
      }, {
        "type": "text",
        "id": "title",
        "label": "Banner title",
        "default": "Our Rare finds"
      }, {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Shop now"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }, {
        "type": "checkbox",
        "id": "show_banner_subtitle",
        "label": "Show banner subtitle",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_banner_title",
        "label": "Show banner title",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_banner_button",
        "label": "Show banner button",
        "default": true
      }, {
        "type": "header",
        "content": "Banner style"
      }, {
        "type": "color",
        "id": "banner_subtitle_color",
        "label": "Banner subtitle color",
        "default": "#FFFDF8"
      }, {
        "type": "color",
        "id": "banner_title_color",
        "label": "Banner title color",
        "default": "#FFFDF8"
      }, {
        "type": "range",
        "id": "section_subheading_size",
        "label": "Section subheading size",
        "min": 10,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 14
      }, {
        "type": "range",
        "id": "section_heading_size",
        "label": "Section heading size",
        "min": 28,
        "max": 72,
        "step": 1,
        "unit": "px",
        "default": 54
      }, {
        "type": "range",
        "id": "section_heading_size_mobile",
        "label": "Section heading size mobile",
        "min": 14,
        "max": 56,
        "step": 1,
        "unit": "px",
        "default": 42
      }, {
        "type": "range",
        "id": "banner_subtitle_size",
        "label": "Banner subtitle size",
        "min": 10,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 14
      }, {
        "type": "range",
        "id": "banner_subtitle_size_mobile",
        "label": "Banner subtitle size mobile",
        "min": 10,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 13
      }, {
        "type": "range",
        "id": "banner_title_size_desktop",
        "label": "Banner title size (desktop)",
        "min": 24,
        "max": 84,
        "step": 1,
        "unit": "px",
        "default": 54
      }, {
        "type": "range",
        "id": "banner_title_size_mobile",
        "label": "Banner title size (mobile/tablet)",
        "min": 20,
        "max": 64,
        "step": 1,
        "unit": "px",
        "default": 43
      }, {
        "type": "range",
        "id": "banner_title_max_width",
        "label": "Banner title width",
        "min": 8,
        "max": 24,
        "step": 1,
        "unit": "ch",
        "default": 12
