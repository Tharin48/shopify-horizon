      "max": 2400,
      "step": 40,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "range",
      "id": "section_max_height",
      "label": "Max height",
      "min": 560,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 960
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "label": "Desktop padding left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "label": "Desktop padding right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "label": "Mobile padding left",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "label": "Mobile padding right",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
