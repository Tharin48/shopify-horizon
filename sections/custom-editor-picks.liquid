<section
  class="custom-editor-picks"
  style="
    --cep-heading-color: {{ section.settings.heading_color }};
    --cep-heading-size: {{ section.settings.heading_size }}px;
    --cep-underline-color: {{ section.settings.underline_color }};
    --cep-card-radius: {{ section.settings.card_radius }}px;
    --cep-card-height-desktop: {{ section.settings.card_height_desktop }}px;
    --cep-card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --cep-card-padding: {{ section.settings.card_padding }}px;
    --cep-overlay-start-opacity: {{ section.settings.overlay_start_opacity | divided_by: 100.0 }};
    --cep-overlay-end-opacity: {{ section.settings.overlay_end_opacity | divided_by: 100.0 }};
    --cep-pill-text-color: {{ section.settings.pill_text_color }};
    --cep-pill-bg-color: {{ section.settings.pill_background_color }};
    --cep-title-color: {{ section.settings.title_color }};
    --cep-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --cep-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --cep-excerpt-color: {{ section.settings.excerpt_color }};
    --cep-excerpt-size-desktop: {{ section.settings.excerpt_size_desktop }}px;
    --cep-excerpt-size-mobile: {{ section.settings.excerpt_size_mobile }}px;
    --cep-date-color: {{ section.settings.date_color }};
    --cep-meta-size: {{ section.settings.meta_size }}px;
    --cep-grid-gap: {{ section.settings.grid_gap }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editor-picks__inner">
    <div class="custom-editor-picks__header">
      <div>
        <h2 class="custom-editor-picks__heading">{{ section.settings.heading | escape }}</h2>
        <div class="custom-editor-picks__underline" aria-hidden="true"></div>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="custom-editor-picks__scroller">
        <div class="custom-editor-picks__grid">
          {% for block in section.blocks %}
            {% assign article = block.settings.article %}
            {% assign editor_pick_category = block.settings.category_label | default: article.tags.first | default: 'Editorial' %}
            <article class="custom-editor-picks__card" {{ block.shopify_attributes }}>
              <a class="custom-editor-picks__card-link" href="{{ article.url | default: '#' }}">
                <div class="custom-editor-picks__card-media">
                  {% if article != blank and article.image != blank %}
                    {{
                      article.image
                      | image_url: width: 1600
                      | image_tag:
                        widths: '320,480,640,800,1200,1600',
                        sizes: '(min-width: 1200px) 33vw, (min-width: 768px) 50vw, 86vw',
                        loading: 'lazy',
                        class: 'custom-editor-picks__image',
                        alt: article.image.alt | default: article.title | escape
                    }}
                  {% else %}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'custom-editor-picks__image custom-editor-picks__image--placeholder' }}
                  {% endif %}
                  <div class="custom-editor-picks__overlay"></div>
                </div>

                <div class="custom-editor-picks__card-content">
                  <div class="custom-editor-picks__text-stack">
                    <h3 class="custom-editor-picks__title">{{ article.title | default: 'Select an article' | escape }}</h3>
                    <p class="custom-editor-picks__excerpt">
                      {{ article.excerpt_or_content | default: 'Choose an article in the block settings to populate this card.' | strip_html | truncate: 135 }}
                    </p>
                  </div>
                  <div class="custom-editor-picks__meta-row">
                    <span class="custom-editor-picks__category">{{ editor_pick_category | escape }}</span>
                    {% if article != blank %}
                      <span class="custom-editor-picks__date">{{ article.published_at | date: '%d.%m.%Y' }}</span>
                    {% endif %}
                  </div>
                </div>
              </a>
            </article>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="custom-editor-picks__empty">
        Add article pick blocks to populate this section.
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .custom-editor-picks {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
    background: rgb(var(--color-background-rgb));
  }

  .custom-editor-picks__inner {
    width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .custom-editor-picks__header {
    margin-bottom: 1.75rem;
  }

  .custom-editor-picks__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2rem, 4vw, var(--cep-heading-size, 48px));
    color: var(--cep-heading-color, rgb(var(--color-foreground-heading-rgb)));
  }

  .custom-editor-picks__underline {
    width: 3rem;
    height: 0.18rem;
    margin-top: 0.7rem;
    background: var(--cep-underline-color, #c7a03a);
  }

  .custom-editor-picks__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cep-grid-gap, 24px);
  }

  .custom-editor-picks__card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--cep-card-radius, 12px);
    min-height: var(--cep-card-height-desktop, 336px);
  }

  .custom-editor-picks__card-link {
    position: relative;
    display: block;
    color: #fffdf8;
    text-decoration: none;
    min-height: var(--cep-card-height-desktop, 336px);
  }

  .custom-editor-picks__card-media,
  .custom-editor-picks__overlay {
    position: absolute;
    inset: 0;
  }

  .custom-editor-picks__image,
  .custom-editor-picks__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-editor-picks__overlay {
    background: linear-gradient(
      180deg,
      rgb(15 13 11 / var(--cep-overlay-start-opacity, 0.16)),
      rgb(15 13 11 / var(--cep-overlay-end-opacity, 0.68))
    );
  }

  .custom-editor-picks__card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.7rem;
    min-height: var(--cep-card-height-desktop, 336px);
    padding: var(--cep-card-padding, 20px);
  }

  .custom-editor-picks__text-stack {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .custom-editor-picks__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.35rem;
    font-size: var(--cep-meta-size, 13px);
  }

  .custom-editor-picks__category {
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--cep-pill-bg-color, rgb(255 255 255 / 0.16));
    color: var(--cep-pill-text-color, #fffdf8);
    backdrop-filter: blur(8px);
  }

  .custom-editor-picks__date {
    color: var(--cep-date-color, rgb(255 253 248 / 0.78));
  }

  .custom-editor-picks__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: var(--cep-title-size-desktop, 24px);
    line-height: 1.2;
    color: var(--cep-title-color, #fffdf8);
  }

  .custom-editor-picks__excerpt {
    margin: 0;
    color: var(--cep-excerpt-color, rgb(255 253 248 / 0.8));
    font-size: var(--cep-excerpt-size-desktop, 15px);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .custom-editor-picks__empty {
    padding: 2rem;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.68);
    text-align: center;
  }

  @media screen and (max-width: 1023px) {
    .custom-editor-picks__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .custom-editor-picks__scroller {
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }

    .custom-editor-picks__grid {
      display: flex;
      gap: 1rem;
      width: max-content;
    }

    .custom-editor-picks__card {
      width: min(84vw, 22rem);
      min-width: min(84vw, 22rem);
      min-height: var(--cep-card-height-mobile, 320px);
    }

    .custom-editor-picks__card-link,
    .custom-editor-picks__card-content {
      min-height: var(--cep-card-height-mobile, 320px);
    }

    .custom-editor-picks__title {
      font-size: var(--cep-title-size-mobile, 22px);
    }

    .custom-editor-picks__excerpt {
      font-size: var(--cep-excerpt-size-mobile, 14px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom editor picks",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Editor’s Pick"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F1B16"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline color",
      "default": "#C7A03A"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Card gap",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_height_desktop",
      "label": "Desktop card height",
      "min": 260,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "label": "Mobile card height",
      "min": 240,
      "max": 460,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card content padding",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "overlay_start_opacity",
      "label": "Overlay top opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "range",
      "id": "overlay_end_opacity",
      "label": "Overlay bottom opacity",
      "min": 0,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Category text color",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "pill_background_color",
      "label": "Category background color",
      "default": "#FFFFFF29"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#FFFDF8"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Desktop title size",
      "min": 18,
      "max": 42,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Mobile title size",
      "min": 16,
      "max": 34,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt color",
      "default": "#CCC7BE"
    },
    {
      "type": "range",
      "id": "excerpt_size_desktop",
      "label": "Desktop excerpt size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "excerpt_size_mobile",
      "label": "Mobile excerpt size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date color",
      "default": "#F2EEE7"
    },
    {
      "type": "range",
      "id": "meta_size",
      "label": "Category and date size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    }
  ],
  "blocks": [
    {
      "type": "article_pick",
      "name": "Article pick",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "text",
          "id": "category_label",
          "label": "Category label override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom editor picks",
      "blocks": [
        { "type": "article_pick" },
        { "type": "article_pick" },
        { "type": "article_pick" }
      ]
    }
  ]
}
{% endschema %}
