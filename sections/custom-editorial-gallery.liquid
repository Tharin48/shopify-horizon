<section
  class="custom-editorial-gallery custom-editorial-gallery--mobile-{{ section.settings.mobile_layout }}"
  style="
    --custom-editorial-gallery-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-gallery-background: {{ section.settings.background_color }};
    --custom-editorial-gallery-accent: {{ section.settings.accent_color }};
    --custom-editorial-gallery-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-gallery-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-gallery-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-gallery-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-gallery-gap: {{ section.settings.desktop_gap }}px;
    --custom-editorial-gallery-gap-mobile: {{ section.settings.mobile_gap }}px;
    --custom-editorial-gallery-row-height: {{ section.settings.row_height }}px;
    --custom-editorial-gallery-radius: {{ section.settings.image_radius }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-gallery__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="custom-editorial-gallery__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="custom-editorial-gallery__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-editorial-gallery__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="custom-editorial-gallery__intro rte">
            {{ section.settings.intro }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-editorial-gallery__grid">
      {%- for block in section.blocks -%}
        <figure
          class="custom-editorial-gallery__item custom-editorial-gallery__item--col-{{ block.settings.column_span }} custom-editorial-gallery__item--row-{{ block.settings.row_span }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="custom-editorial-gallery__image-shell">
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '240,360,540,720,960,1200,1600,1800',
                  sizes: '(min-width: 990px) 24vw, 80vw',
                  class: 'custom-editorial-gallery__image',
                  alt: block.settings.image.alt
              }}
            </div>
          {%- else -%}
            <div class="custom-editorial-gallery__empty">Choose an image</div>
          {%- endif -%}

          {%- if block.settings.caption != blank -%}
            <figcaption class="custom-editorial-gallery__caption">{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}

      {%- if section.blocks.size == 0 and request.design_mode -%}
        <div class="custom-editorial-gallery__empty">Add gallery image blocks to populate this layout.</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-editorial-gallery {
    background: var(--custom-editorial-gallery-background);
  }

  .custom-editorial-gallery__inner {
    max-width: var(--custom-editorial-gallery-max-width);
    margin: 0 auto;
    padding:
      var(--custom-editorial-gallery-padding-top-mobile)
      16px
      var(--custom-editorial-gallery-padding-bottom-mobile);
  }

  .custom-editorial-gallery__header {
    max-width: 44rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .custom-editorial-gallery__eyebrow {
    margin: 0 0 0.7rem;
    color: var(--custom-editorial-gallery-accent);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.76rem;
  }

  .custom-editorial-gallery__heading {
    margin: 0;
  }

  .custom-editorial-gallery__intro {
    margin-top: 1rem;
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .custom-editorial-gallery__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--custom-editorial-gallery-gap-mobile);
  }

  .custom-editorial-gallery__item {
    margin: 0;
  }

  .custom-editorial-gallery__image-shell,
  .custom-editorial-gallery__empty {
    overflow: hidden;
    border-radius: var(--custom-editorial-gallery-radius);
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .custom-editorial-gallery__empty {
    display: grid;
    place-items: center;
    min-height: 15rem;
    padding: 1.25rem;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.18);
    color: rgb(var(--color-foreground-rgb) / 0.66);
  }

  .custom-editorial-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 15rem;
    object-fit: cover;
  }

  .custom-editorial-gallery__caption {
    margin-top: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  @media screen and (min-width: 750px) {
    .custom-editorial-gallery__inner {
      padding:
        var(--custom-editorial-gallery-padding-top)
        48px
        var(--custom-editorial-gallery-padding-bottom);
    }

    .custom-editorial-gallery__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: var(--custom-editorial-gallery-row-height);
      gap: var(--custom-editorial-gallery-gap);
    }

    .custom-editorial-gallery__item {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .custom-editorial-gallery__image-shell {
      flex: 1 1 auto;
      min-height: 100%;
    }

    .custom-editorial-gallery__item--col-1 {
      grid-column: span 1;
    }

    .custom-editorial-gallery__item--col-2 {
      grid-column: span 2;
    }

    .custom-editorial-gallery__item--col-3 {
      grid-column: span 3;
    }

    .custom-editorial-gallery__item--col-4 {
      grid-column: span 4;
    }

    .custom-editorial-gallery__item--col-5 {
      grid-column: span 5;
    }

    .custom-editorial-gallery__item--col-6 {
      grid-column: span 6;
    }

    .custom-editorial-gallery__item--row-1 {
      grid-row: span 1;
    }

    .custom-editorial-gallery__item--row-2 {
      grid-row: span 2;
    }

    .custom-editorial-gallery__item--row-3 {
      grid-row: span 3;
    }
  }

  @media screen and (max-width: 749px) {
    .custom-editorial-gallery--mobile-carousel .custom-editorial-gallery__grid {
      display: flex;
      overflow-x: auto;
      gap: 1rem;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .custom-editorial-gallery--mobile-carousel .custom-editorial-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    .custom-editorial-gallery--mobile-carousel .custom-editorial-gallery__item {
      flex: 0 0 min(84vw, 24rem);
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom editorial gallery",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Gallery heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "stacked",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "carousel", "label": "Carousel" }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#b08a2f"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fffdf8"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Desktop row height",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "select",
          "id": "column_span",
          "label": "Desktop column span",
          "default": "3",
          "options": [
            { "value": "1", "label": "1 column" },
            { "value": "2", "label": "2 columns" },
            { "value": "3", "label": "3 columns" },
            { "value": "4", "label": "4 columns" },
            { "value": "5", "label": "5 columns" },
            { "value": "6", "label": "6 columns" }
          ]
        },
        {
          "type": "select",
          "id": "row_span",
          "label": "Desktop row span",
          "default": "2",
          "options": [
            { "value": "1", "label": "1 row" },
            { "value": "2", "label": "2 rows" },
            { "value": "3", "label": "3 rows" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom editorial gallery"
    }
  ]
}
{% endschema %}
