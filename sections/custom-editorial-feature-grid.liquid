<section
  class="custom-editorial-feature-grid"
  style="
    --custom-editorial-feature-grid-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-feature-grid-background: {{ section.settings.background_color }};
    --custom-editorial-feature-grid-card-background: {{ section.settings.card_background_color }};
    --custom-editorial-feature-grid-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-feature-grid-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-feature-grid-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-feature-grid-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-feature-grid-gap: {{ section.settings.desktop_gap }}px;
    --custom-editorial-feature-grid-gap-mobile: {{ section.settings.mobile_gap }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-feature-grid__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="custom-editorial-feature-grid__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="custom-editorial-feature-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-editorial-feature-grid__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="custom-editorial-feature-grid__intro rte">
            {{ section.settings.intro }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-editorial-feature-grid__grid custom-editorial-feature-grid__grid--{{ section.settings.desktop_columns }}">
      {%- for block in section.blocks -%}
        <article class="custom-editorial-feature-grid__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="custom-editorial-feature-grid__icon">
              {{
                block.settings.icon
                | image_url: width: 120
                | image_tag:
                  loading: 'lazy',
                  widths: '40,60,80,120',
                  sizes: '40px',
                  alt: block.settings.icon.alt
              }}
            </div>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="custom-editorial-feature-grid__card-heading">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="custom-editorial-feature-grid__card-text rte">
              {{ block.settings.text }}
            </div>
          {%- endif -%}

          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a class="custom-editorial-feature-grid__card-link" href="{{ block.settings.link_url }}">
              {{ block.settings.link_label | escape }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}

      {%- if section.blocks.size == 0 and request.design_mode -%}
        <div class="custom-editorial-feature-grid__empty">Add feature blocks to build the grid.</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-editorial-feature-grid {
    background: var(--custom-editorial-feature-grid-background);
  }

  .custom-editorial-feature-grid__inner {
    max-width: var(--custom-editorial-feature-grid-max-width);
    margin: 0 auto;
    padding:
      var(--custom-editorial-feature-grid-padding-top-mobile)
      16px
      var(--custom-editorial-feature-grid-padding-bottom-mobile);
  }

  .custom-editorial-feature-grid__header {
    max-width: 44rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .custom-editorial-feature-grid__eyebrow {
    margin: 0 0 0.7rem;
    color: #b08a2f;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.76rem;
  }

  .custom-editorial-feature-grid__heading {
    margin: 0;
  }

  .custom-editorial-feature-grid__intro {
    margin-top: 1rem;
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .custom-editorial-feature-grid__grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--custom-editorial-feature-grid-gap-mobile);
  }

  .custom-editorial-feature-grid__card,
  .custom-editorial-feature-grid__empty {
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: var(--custom-editorial-feature-grid-card-background);
  }

  .custom-editorial-feature-grid__empty {
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.18);
    color: rgb(var(--color-foreground-rgb) / 0.66);
    text-align: center;
  }

  .custom-editorial-feature-grid__icon {
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
  }

  .custom-editorial-feature-grid__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .custom-editorial-feature-grid__card-heading {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.35;
  }

  .custom-editorial-feature-grid__card-text {
    margin-top: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .custom-editorial-feature-grid__card-link {
    display: inline-flex;
    margin-top: 1rem;
    color: #b08a2f;
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    .custom-editorial-feature-grid__inner {
      padding:
        var(--custom-editorial-feature-grid-padding-top)
        48px
        var(--custom-editorial-feature-grid-padding-bottom);
    }

    .custom-editorial-feature-grid__grid {
      gap: var(--custom-editorial-feature-grid-gap);
    }

    .custom-editorial-feature-grid__grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .custom-editorial-feature-grid__grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .custom-editorial-feature-grid__grid--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial feature grid",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Feature grid heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "4",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "4", "label": "4 columns" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe the editorial feature here.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial feature grid"
    }
  ]
}
{% endschema %}
