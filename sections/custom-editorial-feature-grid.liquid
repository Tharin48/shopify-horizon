{{ 'section-custom-editorial-feature-grid.css' | asset_url | stylesheet_tag }}
<section
  class="custom-editorial-feature-grid"
  style="
    --custom-editorial-feature-grid-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-feature-grid-background: {{ section.settings.background_color }};
    --custom-editorial-feature-grid-card-background: {{ section.settings.card_background_color }};
    --custom-editorial-feature-grid-accent: {{ section.settings.accent_color }};
    --custom-editorial-feature-grid-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-feature-grid-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-feature-grid-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-feature-grid-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-feature-grid-gap: {{ section.settings.desktop_gap }}px;
    --custom-editorial-feature-grid-gap-mobile: {{ section.settings.mobile_gap }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-feature-grid__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="custom-editorial-feature-grid__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="custom-editorial-feature-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-editorial-feature-grid__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="custom-editorial-feature-grid__intro rte">
            {{ section.settings.intro }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-editorial-feature-grid__grid custom-editorial-feature-grid__grid--{{ section.settings.desktop_columns }}">
      {%- for block in section.blocks -%}
        <article class="custom-editorial-feature-grid__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="custom-editorial-feature-grid__icon">
              {{
                block.settings.icon
                | image_url: width: 120
                | image_tag:
                  loading: 'lazy',
                  widths: '40,60,80,120',
                  sizes: '40px',
                  alt: block.settings.icon.alt
              }}
            </div>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="custom-editorial-feature-grid__card-heading">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="custom-editorial-feature-grid__card-text rte">
              {{ block.settings.text }}
            </div>
          {%- endif -%}

          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a class="custom-editorial-feature-grid__card-link" href="{{ block.settings.link_url }}">
              {{ block.settings.link_label | escape }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}

      {%- if section.blocks.size == 0 and request.design_mode -%}
        <div class="custom-editorial-feature-grid__empty">Add feature blocks to build the grid.</div>
      {%- endif -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Editorial feature grid",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Feature grid heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "4",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "4", "label": "4 columns" }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#b08a2f"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe the editorial feature here.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial feature grid"
    }
  ]
}
{% endschema %}
