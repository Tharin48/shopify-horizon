<section
  class="custom-editorial-text-image{% if section.settings.reverse_layout %} custom-editorial-text-image--reversed{% endif %}"
  style="
    --custom-editorial-text-image-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-text-image-background: {{ section.settings.background_color }};
    --custom-editorial-text-image-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-text-image-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-text-image-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-text-image-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-text-image-gap: {{ section.settings.desktop_gap }}px;
    --custom-editorial-text-image-gap-mobile: {{ section.settings.mobile_gap }}px;
    --custom-editorial-text-image-image-radius: {{ section.settings.image_radius }}px;
    --custom-editorial-text-image-quote-background: {{ section.settings.quote_background_color }};
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-text-image__inner">
    <div class="custom-editorial-text-image__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="custom-editorial-text-image__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="custom-editorial-text-image__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="custom-editorial-text-image__text rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.quote_text != blank or section.settings.quote_author != blank -%}
        <div class="custom-editorial-text-image__quote">
          {%- if section.settings.quote_text != blank -%}
            <blockquote class="custom-editorial-text-image__quote-text">{{ section.settings.quote_text }}</blockquote>
          {%- endif -%}
          {%- if section.settings.quote_author != blank -%}
            <p class="custom-editorial-text-image__quote-author">{{ section.settings.quote_author | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="custom-editorial-text-image__media">
      {%- if section.settings.image != blank -%}
        <div
          class="custom-editorial-text-image__image-shell"
          style="--custom-editorial-text-image-object-position: {{ section.settings.image_position }};"
        >
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 960 }}">
            {%- endif -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '360,540,720,900,1200,1400,1600',
                sizes: '(min-width: 990px) 46vw, 100vw',
                class: 'custom-editorial-text-image__image',
                alt: section.settings.image.alt
            }}
          </picture>
        </div>
      {%- elsif request.design_mode -%}
        <div class="custom-editorial-text-image__empty">Choose an image to display alongside the text.</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-editorial-text-image {
    background: var(--custom-editorial-text-image-background);
  }

  .custom-editorial-text-image__inner {
    display: grid;
    gap: var(--custom-editorial-text-image-gap-mobile);
    align-items: center;
    max-width: var(--custom-editorial-text-image-max-width);
    margin: 0 auto;
    padding:
      var(--custom-editorial-text-image-padding-top-mobile)
      16px
      var(--custom-editorial-text-image-padding-bottom-mobile);
  }

  .custom-editorial-text-image__content,
  .custom-editorial-text-image__media {
    min-width: 0;
  }

  .custom-editorial-text-image__eyebrow {
    margin: 0 0 0.7rem;
    color: #b08a2f;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.76rem;
  }

  .custom-editorial-text-image__heading {
    margin: 0;
  }

  .custom-editorial-text-image__text {
    margin-top: 1rem;
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .custom-editorial-text-image__quote {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: var(--custom-editorial-text-image-quote-background);
  }

  .custom-editorial-text-image__quote-text {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .custom-editorial-text-image__quote-author {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .custom-editorial-text-image__image-shell,
  .custom-editorial-text-image__empty {
    overflow: hidden;
    min-height: clamp(18rem, 46vw, 34rem);
    border-radius: var(--custom-editorial-text-image-image-radius);
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .custom-editorial-text-image__empty {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.18);
    color: rgb(var(--color-foreground-rgb) / 0.66);
  }

  .custom-editorial-text-image__image-shell picture,
  .custom-editorial-text-image__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .custom-editorial-text-image__image {
    object-fit: cover;
    object-position: var(--custom-editorial-text-image-object-position, center center);
  }

  @media screen and (min-width: 750px) {
    .custom-editorial-text-image__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--custom-editorial-text-image-gap);
      padding:
        var(--custom-editorial-text-image-padding-top)
        48px
        var(--custom-editorial-text-image-padding-bottom);
    }

    .custom-editorial-text-image--reversed .custom-editorial-text-image__content {
      order: 2;
    }

    .custom-editorial-text-image--reversed .custom-editorial-text-image__media {
      order: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial text image",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Editorial section heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use this section for editorial storytelling with flexible copy and photography.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout on desktop",
      "default": false
    },
    {
      "type": "richtext",
      "id": "quote_text",
      "label": "Quote text"
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote author"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "quote_background_color",
      "label": "Quote card background",
      "default": "#f7f1e0"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Editorial text image"
    }
  ]
}
{% endschema %}
