{{ 'section-custom-editorial-quote.css' | asset_url | stylesheet_tag }}
<section
  class="custom-editorial-quote"
  style="
    --custom-editorial-quote-max-width: {{ section.settings.max_width }}px;
    --custom-editorial-quote-background: {{ section.settings.background_color }};
    --custom-editorial-quote-card-background: {{ section.settings.card_background_color }};
    --custom-editorial-quote-padding-top: {{ section.settings.padding_top }}px;
    --custom-editorial-quote-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-editorial-quote-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --custom-editorial-quote-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --custom-editorial-quote-radius: {{ section.settings.card_radius }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-editorial-quote__inner">
    <div class="custom-editorial-quote__card">
      {%- if section.settings.background_image != blank -%}
        <div class="custom-editorial-quote__background" aria-hidden="true">
          {{
            section.settings.background_image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              widths: '400,800,1200,1600,1800',
              sizes: '100vw',
              alt: ''
          }}
        </div>
      {%- endif -%}

      <div class="custom-editorial-quote__content">
        {%- if section.settings.quote_text != blank -%}
          <blockquote class="custom-editorial-quote__text">{{ section.settings.quote_text }}</blockquote>
        {%- endif -%}

        {%- if section.settings.author != blank -%}
          <p class="custom-editorial-quote__author">{{ section.settings.author | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Custom editorial quote",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "quote_text",
      "label": "Quote text",
      "default": "<p>Add a featured quote here.</p>"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "Quote attribution"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#f7f1e0"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 480,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 980
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Custom editorial quote"
    }
  ]
}
{% endschema %}
