<section
  class="custom-blog-hero-slider"
  data-custom-blog-hero-slider
  data-autoplay="{% if section.settings.autoplay and slide_count > 1 %}true{% else %}false{% endif %}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  style="
    --cbhs-desktop-height: {{ section.settings.desktop_height }}px;
    --cbhs-mobile-height: {{ section.settings.mobile_height }}px;
    --cbhs-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --cbhs-pill-text-color: {{ section.settings.pill_text_color }};
    --cbhs-pill-bg-color: {{ section.settings.pill_background_color }};
    --cbhs-title-color: {{ section.settings.title_color }};
    --cbhs-body-color: {{ section.settings.body_color }};
    --cbhs-date-color: {{ section.settings.date_color }};
    --cbhs-button-text-color: {{ section.settings.button_text_color }};
    --cbhs-button-bg-color: {{ section.settings.button_background_color }};
    --cbhs-button-border-color: {{ section.settings.button_border_color }};
    --cbhs-desktop-title-size: {{ section.settings.desktop_title_size }}px;
    --cbhs-mobile-title-size: {{ section.settings.mobile_title_size }}px;
    --cbhs-desktop-body-size: {{ section.settings.desktop_body_size }}px;
    --cbhs-mobile-body-size: {{ section.settings.mobile_body_size }}px;
  "
  {{ section.shopify_attributes }}>
  <script src="{{ 'custom-blog-hero-slider.js' | asset_url }}" defer></script>
  <div
    class="custom-blog-hero-slider__viewport"
    data-blog-hero-viewport
    tabindex="0"
    aria-label="Featured blog articles slider">
    {% if slide_count > 0 %}
      <div class="custom-blog-hero-slider__track" data-blog-hero-track>
        {{ slide_markup }}
      </div>
      {% if slide_count > 1 %}
        <div class="custom-blog-hero-slider__dots" aria-label="Slider navigation">
          {% for i in (1..slide_count) %}
            <button
              type="button"
              class="custom-blog-hero-slider__dot{% if forloop.first %} is-active{% endif %}"
              data-blog-hero-dot
              data-slide-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="custom-blog-hero-slider__empty">
        <p>No featured articles found. Select blogs in the section settings and tag articles with “{{ section.settings.featured_tag_text | escape }}”.</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .custom-blog-hero-slider {
    background: rgb(var(--color-background-rgb));
  }

  .custom-blog-hero-slider__viewport {
    position: relative;
    overflow: hidden;
    height: var(--cbhs-mobile-height, 420px);
    outline: none;
  }

  .custom-blog-hero-slider__track {
    display: flex;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .custom-blog-hero-slider__slide {
    position: relative;
    flex: 0 0 100%;
    height: var(--cbhs-mobile-height, 420px);
    isolation: isolate;
  }

  .custom-blog-hero-slider__media,
  .custom-blog-hero-slider__overlay {
    position: absolute;
    inset: 0;
  }

  .custom-blog-hero-slider__image,
  .custom-blog-hero-slider__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-blog-hero-slider__overlay {
    background: linear-gradient(90deg, rgb(14 12 9 / calc(var(--cbhs-overlay-opacity, 0.35) + 0.15)) 0%, rgb(14 12 9 / calc(var(--cbhs-overlay-opacity, 0.35) + 0.02)) 55%, rgb(14 12 9 / calc(var(--cbhs-overlay-opacity, 0.35) * 0.6)) 100%);
    z-index: 0;
  }

  .custom-blog-hero-slider__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 0.8rem;
    height: 100%;
    width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) 0;
    color: var(--cbhs-title-color, #fffdf8);
  }

  .custom-blog-hero-slider__pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--cbhs-pill-bg-color, rgb(255 255 255 / 0.16));
    color: var(--cbhs-pill-text-color, #fffdf8);
    backdrop-filter: blur(10px);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .custom-blog-hero-slider__title {
    max-width: min(28ch, 100%);
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2.2rem, 5vw, var(--cbhs-desktop-title-size, 74px));
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--cbhs-title-color, #fffdf8);
  }

  .custom-blog-hero-slider__excerpt {
    max-width: 40rem;
    margin: 0;
    font-size: var(--cbhs-desktop-body-size, 16px);
    line-height: 1.7;
    color: var(--cbhs-body-color, rgb(255 253 248 / 0.86));
  }

  .custom-blog-hero-slider__date {
    margin: 0;
    font-size: max(0.9rem, calc(var(--cbhs-desktop-body-size, 16px) - 2px));
    color: var(--cbhs-date-color, rgb(255 253 248 / 0.72));
  }

  .custom-blog-hero-slider__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    background: var(--cbhs-button-bg-color, rgb(255 255 255 / 0.14));
    border: 1px solid var(--cbhs-button-border-color, rgb(255 255 255 / 0.3));
    color: var(--cbhs-button-text-color, #fffdf8);
    text-decoration: none;
    transition: background-color 0.2s ease
    , transform 0.2s ease;
  }

  .custom-blog-hero-slider__link:hover,
  .custom-blog-hero-slider__link:focus-visible {
    background: rgb(255 255 255 / 0.22);
    transform: translateY(-1px);
  }

  .custom-blog-hero-slider__dots {
    position: absolute;
    inset-inline-start: max(1rem, calc((100% - min(1280px, calc(100% - 2rem))) / 2));
    inset-block-end: 1.5rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .custom-blog-hero-slider__dot {
    width: 0.75rem;
    height: 0.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.45);
    cursor: pointer;
    transition: transform 0.2s ease
    , background-color 0.2s ease;
  }

  .custom-blog-hero-slider__dot.is-active {
    background: #fffdf8;
    transform: scale(1.15);
  }

  .custom-blog-hero-slider__empty {
    display: grid;
    place-items: center;
    min-height: min(60vh, var(--cbhs-mobile-height, 420px));
    padding: 2rem;
    text-align: center;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  @media screen and (min-width: 750px) {
    .custom-blog-hero-slider__viewport,
    .custom-blog-hero-slider__slide {
      height: var(--cbhs-desktop-height, 620px);
    }
  }

  @media screen and (max-width: 749px) {
    .custom-blog-hero-slider__content {
      justify-content: flex-end;
      gap: 0.65rem;
      width: calc(100% - 2rem);
      padding-bottom: 4.25rem;
    }

    .custom-blog-hero-slider__title {
      max-width: min(14ch, 100%);
      font-size: clamp(1.95rem, 9vw, var(--cbhs-mobile-title-size, 48px));
    }

    .custom-blog-hero-slider__excerpt {
      max-width: 100%;
      font-size: var(--cbhs-mobile-body-size, 15px);
      line-height: 1.6;
    }

    .custom-blog-hero-slider__date {
      font-size: max(0.85rem, calc(var(--cbhs-mobile-body-size, 15px) - 2px));
    }

    .custom-blog-hero-slider__dots {
      inset-inline-start: 1rem;
      inset-block-end: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Custom blog hero slider",
    "tag": "section",
    "class": "section-wrapper",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "paragraph",
        "content": "Automatically shows articles tagged as featured from the selected blogs."
      },
      {
        "type": "blog",
        "id": "blog_1",
        "label": "Blog 1"
      },
      {
        "type": "blog",
        "id": "blog_2",
        "label": "Blog 2"
      },
      {
        "type": "blog",
        "id": "blog_3",
        "label": "Blog 3"
      }, {
        "type": "blog",
        "id": "blog_4",
        "label": "Blog 4"
      }, {
        "type": "blog",
        "id": "blog_5",
        "label": "Blog 5"
      }, {
        "type": "text",
        "id": "featured_tag_text",
        "label": "Featured tag text",
        "default": "featured"
      }, {
        "type": "range",
        "id": "max_slides",
        "label": "Maximum slides",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 5
      }, {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": true
      }, {
        "type": "range",
        "id": "autoplay_speed",
        "label": "Autoplay speed",
        "min": 3,
        "max": 10,
        "step": 1,
        "unit": "s",
        "default": 5
      }, {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Overlay opacity",
        "min": 0,
        "max": 80,
        "step": 5,
        "unit": "%",
        "default": 35
      }, {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Read article"
      }, {
