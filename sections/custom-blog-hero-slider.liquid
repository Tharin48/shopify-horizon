{% liquid
  assign max_slides = section.settings.max_slides | default: 5
  assign featured_tag_text = section.settings.featured_tag_text | default: 'featured' | strip | downcase
  assign slide_count = 0
%}

{% capture slide_markup %}
  {% if section.settings.blog_1 != blank and slide_count < max_slides %}
    {% for article in section.settings.blog_1.articles %}
      {% assign is_featured = false %}
      {% for tag in article.tags %}
        {% assign normalized_tag = tag | strip | downcase %}
        {% if normalized_tag == featured_tag_text %}
          {% assign is_featured = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      {% if is_featured %}
        <article class="custom-blog-hero-slider__slide" data-blog-hero-slide>
          <div class="custom-blog-hero-slider__media">
            {% if article.image != blank %}
              {{
                article.image
                | image_url: width: 3840
                | image_tag:
                  widths: '750,1100,1500,2000,2600,3200,3840',
                  sizes: '100vw',
                  loading: 'eager',
                  class: 'custom-blog-hero-slider__image',
                  alt: article.image.alt | default: article.title | escape
              }}
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'custom-blog-hero-slider__image custom-blog-hero-slider__image--placeholder' }}
            {% endif %}
          </div>
          <div class="custom-blog-hero-slider__overlay" aria-hidden="true"></div>
          <div class="custom-blog-hero-slider__content">
            <span class="custom-blog-hero-slider__pill">{{ section.settings.blog_1.title | escape }}</span>
            {% if slide_count == 0 %}
              <h1 class="custom-blog-hero-slider__title">{{ article.title | escape }}</h1>
            {% else %}
              <h2 class="custom-blog-hero-slider__title">{{ article.title | escape }}</h2>
            {% endif %}
            <p class="custom-blog-hero-slider__excerpt">
              {{ article.excerpt_or_content | strip_html | truncate: 140 }}
            </p>
            <p class="custom-blog-hero-slider__date">{{ article.published_at | date: '%d.%m.%Y' }}</p>
            <a class="custom-blog-hero-slider__link" href="{{ article.url }}">
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        </article>
        {% assign slide_count = slide_count | plus: 1 %}
        {% if slide_count >= max_slides %}
          {% break %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}

