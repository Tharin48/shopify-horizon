{% # theme-check-disable %}
{%- liquid
  assign body_font_url = ''
  assign heading_font_url = ''

  unless settings.type_body_font.system?
    assign body_font_url = settings.type_body_font | font_url
  endunless

  unless settings.type_heading_font.system?
    assign heading_font_url = settings.type_heading_font | font_url
  endunless
-%}

{%- comment -%}
  Limit global font preloads to the most likely first-paint fonts.
  Subheading/accent fonts still load through the generated @font-face rules,
  but skipping their preload shortens the critical chain and avoids extra
  connection pressure when merchants choose several custom families.
{%- endcomment -%}

{%- if body_font_url != blank -%}
  <link
    rel="preload"
    as="font"
    href="{{ body_font_url }}"
    type="font/woff2"
    crossorigin
    fetchpriority="low"
  >
{%- endif -%}

{%- if heading_font_url != blank and heading_font_url != body_font_url -%}
  <link
    rel="preload"
    as="font"
    href="{{ heading_font_url }}"
    type="font/woff2"
    crossorigin
    fetchpriority="low"
  >
{%- endif -%}
{% # theme-check-enable %}
