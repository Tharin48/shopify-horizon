{%- liquid
  assign heading = section.settings.heading | default: 'Enjoy 10% Off Your First Order'
  assign description = section.settings.description | default: 'Join the Dilmah community for exclusive offers, tea stories, and early access to new collections.'
  assign email_placeholder = section.settings.email_placeholder | default: 'Enter your email'
  assign cta_text = section.settings.cta_text | default: 'Unlock My Discount'
  assign close_text = section.settings.close_text | default: 'No Thanks'
  assign trust_text = section.settings.small_trust_text | default: 'No spam. Just thoughtful tea experiences.'
  assign success_title = section.settings.success_title | default: 'Thank you for subscribing'
  assign success_message = section.settings.success_message | default: 'Use code WELCOME10 at checkout.'
  assign success_button_text = section.settings.success_button_text | default: 'Continue Shopping'
  assign copy_code_text = section.settings.copy_code_text | default: 'Copy code'
  assign copied_text = section.settings.copied_text | default: 'Copied'
  assign discount_code = section.settings.discount_code | default: 'WELCOME10'
-%}

{%- form 'customer', id: form_id, class: 'custom-newsletter-popup__form-shell' -%}
  {%- liquid
    assign popup_state = 'default'
    if form.posted_successfully?
      assign popup_state = 'success'
    elsif form.errors
      assign popup_state = 'error'
    endif
  -%}

  <input type="hidden" name="contact[tags]" value="newsletter,popup-10-off">

  <div class="custom-newsletter-popup__card" data-newsletter-popup-state="{{ popup_state }}">
    {%- if popup_state == 'success' -%}
      <div class="custom-newsletter-popup__success" data-newsletter-popup-success tabindex="-1">
        <div class="custom-newsletter-popup__success-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M5 12.5L9.25 16.75L19 7" />
          </svg>
        </div>

        {%- if success_title != blank -%}
          <h2 id="{{ title_id }}" class="custom-newsletter-popup__title">
            {{ success_title | escape }}
          </h2>
        {%- endif -%}

        {%- if success_message != blank -%}
          <p id="{{ description_id }}" class="custom-newsletter-popup__description custom-newsletter-popup__description--success">
            {{ success_message | escape }}
          </p>
        {%- endif -%}

        {%- if discount_code != blank -%}
          <div class="custom-newsletter-popup__discount-code" role="status" aria-live="polite">
            <span>{{ discount_code | escape }}</span>
            <button
              type="button"
              class="custom-newsletter-popup__copy-button"
              data-newsletter-popup-copy
              data-copy-default-text="{{ copy_code_text | escape }}"
              data-copy-success-text="{{ copied_text | escape }}"
              aria-label="{{ copy_code_text | escape }}"
              title="{{ copy_code_text | escape }}"
            >
              <span class="visually-hidden">{{ copy_code_text | escape }}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  class="custom-newsletter-popup__copy-icon"
                  d="M9 9.75C9 8.50736 10.0074 7.5 11.25 7.5H17.25C18.4926 7.5 19.5 8.50736 19.5 9.75V17.25C19.5 18.4926 18.4926 19.5 17.25 19.5H11.25C10.0074 19.5 9 18.4926 9 17.25V9.75Z"
                />
                <path
                  class="custom-newsletter-popup__copy-icon"
                  d="M6.75 15.75C5.50736 15.75 4.5 14.7426 4.5 13.5V6.75C4.5 5.50736 5.50736 4.5 6.75 4.5H13.5C14.7426 4.5 15.75 5.50736 15.75 6.75"
                />
                <path
                  class="custom-newsletter-popup__copy-check"
                  d="M10 13L11.8 14.8L15 11.6"
                />
              </svg>
            </button>
          </div>
        {%- endif -%}

        {%- if success_button_text != blank -%}
          <button type="button" class="custom-newsletter-popup__success-button" data-newsletter-popup-dismiss>
            {{ success_button_text | escape }}
          </button>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="custom-newsletter-popup__intro">
        {%- if heading != blank -%}
          <h2 id="{{ title_id }}" class="custom-newsletter-popup__title">{{ heading | escape }}</h2>
        {%- endif -%}

        {%- if description != blank -%}
          <p id="{{ description_id }}" class="custom-newsletter-popup__description">{{ description | escape }}</p>
        {%- endif -%}
      </div>

      {%- if form.errors -%}
        <div class="custom-newsletter-popup__message custom-newsletter-popup__message--error" role="alert">
          {%- for field in form.errors -%}
            <p>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
              {%- endif -%}
            </p>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="custom-newsletter-popup__form-row">
        <label class="visually-hidden" for="{{ email_input_id }}">Email address</label>
        <input
          id="{{ email_input_id }}"
          class="custom-newsletter-popup__input"
          type="email"
          name="contact[email]"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          placeholder="{{ email_placeholder | escape }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          required
          {% if form.errors contains 'email' %}
            aria-invalid="true"
          {% endif %}
        >

        <button class="custom-newsletter-popup__submit" type="submit">
          {{ cta_text | escape }}
        </button>
      </div>

      {%- if trust_text != blank -%}
        <p class="custom-newsletter-popup__trust-text">{{ trust_text | escape }}</p>
      {%- endif -%}

      {%- if close_text != blank -%}
        <button type="button" class="custom-newsletter-popup__text-close" data-newsletter-popup-dismiss>
          {{ close_text | escape }}
        </button>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endform -%}
