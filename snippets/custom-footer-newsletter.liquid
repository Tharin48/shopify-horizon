{%- if block.settings.enable_newsletter -%}
  <div class="custom-footer__connect-block custom-footer__connect-block--newsletter" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h3 class="custom-footer__newsletter-heading">{{ block.settings.heading | escape }}</h3>
    {%- endif -%}

    {%- form 'customer', class: 'custom-footer__newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="return_to" value="{{ request.path }}?customer_posted=true">
      <label class="visually-hidden" for="CustomFooterEmail-{{ block.id }}">Email</label>
      <div class="custom-footer__newsletter-field">
        <input
          id="CustomFooterEmail-{{ block.id }}"
          class="custom-footer__newsletter-input"
          type="email"
          name="contact[email]"
          placeholder="{{ block.settings.placeholder | escape }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
          {% if form.errors %}
            aria-invalid="true"
          {% endif %}
        >
        <button class="custom-footer__newsletter-button" type="submit">
          {%- if block.settings.button_label != blank -%}
            <span>{{ block.settings.button_label | escape }}</span>
          {%- endif -%}
          {%- if block.settings.button_icon == 'arrow' -%}
            <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">{% render 'icon', icon: 'arrow' %}</svg>
          {%- endif -%}
        </button>
      </div>

      {%- if form.errors -%}
        {%- capture custom_footer_newsletter_toast_message -%}
          {{- form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email -}}
        {%- endcapture -%}
        {% render 'theme-toast-flash', variant: 'error', message: custom_footer_newsletter_toast_message %}
        <p
          hidden
          class="custom-footer__newsletter-message custom-footer__newsletter-message--error"
        >
          {{ custom_footer_newsletter_toast_message | strip | escape }}
        </p>
      {%- elsif form.posted_successfully? -%}
        {% render 'theme-toast-flash', variant: 'success', message: 'blocks.email_signup.success' | t %}
        <p hidden class="custom-footer__newsletter-message custom-footer__newsletter-message--success">
          {{ 'blocks.email_signup.success' | t }}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
{%- endif -%}
