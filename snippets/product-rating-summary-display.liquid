{%- doc -%}
  Compact star row + optional review count for product rating summary (placeholder or Shopify Reviews metafields).

  @param {number} rating - Average rating (e.g. 4.5)
  @param {number} scale_max - Scale max (usually 5)
  @param {number} rating_count - Number of reviews (optional)
  @param {string} star_color - CSS color for filled stars
  @param {string} star_empty_color - CSS color for empty stars
  @param {boolean} show_count - Show (N reviews)
  @param {string} unique_suffix - Suffix for SVG gradient IDs (e.g. block.id)
{%- enddoc -%}

{%- liquid
  assign rating = rating | default: 0
  assign scale_max = scale_max | default: 5
  assign unique_suffix = unique_suffix | default: 'rating'
  assign star_count_rating = scale_max
  assign decimal_rating = 0
  assign decimal = rating | modulo: 1
  if decimal >= 0.3 and decimal <= 0.7
    assign decimal_rating = 0.5
  elsif decimal > 0.7
    assign decimal_rating = 1
  endif
  assign decimal_rounded = decimal_rating | ceil
  assign svg_filled_stars = rating | floor | plus: decimal_rounded
-%}

<div class="product-rating-summary-display">
  <svg
    class="visually-hidden"
    style="width: 0; height: 0;"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="half-{{ unique_suffix }}" x1="0" x2="100%" y1="0" y2="0">
        <stop offset="50%" stop-color="{{ star_color }}"></stop>
        <stop offset="50%" stop-color="{{ star_empty_color }}"></stop>
      </linearGradient>
      <symbol xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" id="star-{{ unique_suffix }}">
        <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
      </symbol>
    </defs>
  </svg>
  <div
    class="product-rating-summary-display__stars"
    role="img"
    aria-label="{{ 'accessibility.rating' | t: rating: rating }}{% if show_count and rating_count != blank %}, {{ rating_count }} {{ 'content.reviews' | t }}{% endif %}"
  >
    {%- for star in (1..star_count_rating) -%}
      <svg
        class="product-rating-summary-display__star {% if star <= svg_filled_stars %}is-filled{% endif %}"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
      >
        <use
          href="#star-{{ unique_suffix }}"
          xlink:href="#star-{{ unique_suffix }}"
          {% if decimal_rating == 0.5 and star == svg_filled_stars %}
            fill="url(#half-{{ unique_suffix }})"
          {% endif %}
        ></use>
      </svg>
    {%- endfor -%}
  </div>
  {%- if show_count and rating_count != blank -%}
    <p class="product-rating-summary-display__count" aria-hidden="true">
      ({{ rating_count }} {{ 'content.reviews' | t }})
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-rating-summary-display {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .product-rating-summary-display__stars {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .product-rating-summary-display__star {
    width: 1rem;
    height: 1rem;
    fill: var(--prs-star-empty, rgb(var(--color-foreground-rgb) / 0.2));
  }

  .product-rating-summary-display__star.is-filled {
    fill: var(--prs-star-fill, var(--color-primary));
  }

  .product-rating-summary-display__count {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--prs-count, rgb(var(--color-foreground-rgb) / 0.62));
  }
{% endstylesheet %}
