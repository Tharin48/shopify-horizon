{%- doc -%}
  Product media gallery content styles extracted into a standalone snippet.

  @example
  {% render 'product-media-gallery-content-styles' %}
{%- enddoc -%}

{% stylesheet %}
  media-gallery:where(.media-gallery--grid) .media-gallery__grid {
    display: none;
  }

  media-gallery.media-gallery--grid .media-gallery__grid .product-media-container {
    /* Needed for safari to stretch to full grid height */
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .media-gallery--two-column .media-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Display grid view as a carousel on mobile, grid on desktop */
    media-gallery:is(.media-gallery--grid) slideshow-component {
      display: none;
    }

    media-gallery:where(.media-gallery--grid) .media-gallery__grid {
      display: grid;
    }
  }

  .product-media-container__zoom-button {
    position: absolute;
    inset: auto;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--minimum-touch-target, 2.75rem);
    height: var(--minimum-touch-target, 2.75rem);
    margin: 0;
    padding: 0;
    border: 0.1rem solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 999px;
    box-sizing: border-box;
    cursor: pointer;
    color: rgb(var(--color-foreground-rgb));
    background: color-mix(in srgb, var(--color-background) 92%, transparent);
    box-shadow: 0 0.4rem 1.2rem rgb(var(--color-foreground-rgb) / 0.1);
    backdrop-filter: blur(0.6rem);
    pointer-events: auto;

    &:hover {
      background: color-mix(in srgb, var(--color-background) 88%, transparent);
      border-color: rgb(var(--color-foreground-rgb) / 0.2);
    }

    &:focus-visible {
      outline: 2px solid rgb(var(--color-foreground-rgb) / 0.45);
      outline-offset: 2px;
    }
  }

  .product-media-container__zoom-button-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    pointer-events: none;
  }

  .product-media-container__zoom-button-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  slideshow-slide.product-media-container--tallest {
    content-visibility: visible;
  }

  .product-media__drag-zoom-wrapper {
    aspect-ratio: inherit;
    min-height: inherit;
    min-width: inherit;
    display: inherit;
    flex: inherit;
  }

  .media-gallery__mobile-controls {
    grid-area: auto;
  }

  .product-media-container--zoomable.product-media-container--image {
    cursor: default;
  }

  @media screen and (min-width: 750px) {
    media-gallery:not(.media-gallery--list)
      .product-media-container--zoomable.product-media-container--image {
      cursor: zoom-in;
    }
  }
{% endstylesheet %}
