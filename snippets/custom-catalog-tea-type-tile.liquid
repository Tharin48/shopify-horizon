{%- doc -%}
  Single tea-type visual tile for custom catalog: link when matched to storefront Tea type filter, else disabled control.
  @param {object} section - Parent section (settings).
  @param {string} display_title - Visible label.
  @param {string} [filter_value_attr] - data-catalog-tea-filter-value (handle or manual slug).
  @param {object} [tea_matched_fv] - Matched filter value drop, or false.
  @param {object} catalog_filter_tea_type - Tea type filter or false.
  @param {object} [default_image] - Image or file drop for default state.
  @param {object} [hover_image] - Image or file drop for hover state.
  @param {string} [block_shopify_attributes] - Optional block.shopify_attributes string.
{%- enddoc -%}
{%- liquid
  assign tea_type_tile_title = display_title | strip
  assign tea_img_alt = tea_type_tile_title
  assign tea_btn_aria = tea_type_tile_title | default: section.settings.tea_type_button_fallback_aria
  assign tea_type_href = ''
  assign tea_type_is_active = false
  if tea_matched_fv
    if tea_matched_fv.active
      assign tea_type_href = tea_matched_fv.url_to_remove
      assign tea_type_is_active = true
    else
      assign tea_type_href = tea_matched_fv.url_to_add
    endif
  endif
-%}
{%- if tea_matched_fv -%}
  <li class="custom-catalog__tea-type" {{ block_shopify_attributes }}>
    <a
      href="{{ tea_type_href }}"
      class="custom-catalog__tea-type-btn{% if tea_type_is_active %} is-active{% endif %}"
      aria-label="{{ tea_btn_aria | escape }}"
      {% if tea_type_is_active %}aria-current="true"{% endif %}
      data-catalog-tea-filter-value="{{ filter_value_attr | escape }}"
    >
      <span class="custom-catalog__tea-type-media">
        {%- if default_image != blank -%}
          {{
            default_image
            | image_url: width: 400
            | image_tag:
              loading: 'lazy',
              widths: '120,200,300,400',
              sizes: '(min-width: 990px) 8.25rem, 28vw',
              class: 'custom-catalog__tea-type-img custom-catalog__tea-type-img--default',
              alt: tea_img_alt
          }}
        {%- endif -%}
        {%- if hover_image != blank -%}
          {{
            hover_image
            | image_url: width: 400
            | image_tag:
              loading: 'lazy',
              widths: '120,200,300,400',
              sizes: '(min-width: 990px) 8.25rem, 28vw',
              class: 'custom-catalog__tea-type-img custom-catalog__tea-type-img--hover',
              alt: tea_img_alt
          }}
        {%- endif -%}
      </span>
      {%- if tea_type_tile_title != blank -%}
        <span class="custom-catalog__tea-type-label">{{ tea_type_tile_title | escape }}</span>
      {%- endif -%}
    </a>
  </li>
{%- endif -%}
