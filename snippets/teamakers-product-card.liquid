{% doc %}
  Reusable Teamaker-style product card.

  @param {object} [product] - Shopify product object (optional for placeholder)
  @param {string} [eyebrow] - Optional eyebrow text. Falls back to metafield collection title, then vendor (linked via url_for_vendor) when enabled.
  @param {boolean} [show_vendor]
  @param {boolean} [show_review]
  @param {boolean} [show_quick_add]
  @param {boolean} [show_sale_badge] - When false, hide sale pill (oos still shows). Default true.
  @param {string} [image_sizes]
  @param {boolean} [placeholder]
  @param {string} [quick_add_mode] - `legacy` (custom form) or `horizon` (native Horizon quick add).
  @param {string} [section_id] - Section id forwarded to Horizon quick add form.
{% enddoc %}

{% liquid
  assign is_placeholder = placeholder | default: false
  assign card_product = product
  assign first_variant = blank
  assign card_show_sale_badge = show_sale_badge | default: true
  assign secondary_media = blank
  assign quick_add_mode = quick_add_mode | default: 'legacy'
  assign use_horizon_quick_add = false
  assign quick_add_section_id = section_id | default: 'custom-catalog'
  assign image_sizes = image_sizes | default: '(min-width: 1200px) 300px, (min-width: 750px) 50vw, 100vw'
  assign card_link_url = card_product.url
  assign has_horizon_quick_add = false
  assign has_horizon_mobile_quick_add = false
  assign product_card_anchor = blank
  assign eyebrow_url = blank

  if quick_add_mode == 'horizon'
    assign use_horizon_quick_add = true
  endif

  if is_placeholder == false and card_product != blank
    assign first_variant = card_product.selected_or_first_available_variant
    if first_variant != blank and first_variant.url != blank
      assign card_link_url = first_variant.url
    endif

    if use_horizon_quick_add and show_quick_add and card_product.available
      assign has_horizon_quick_add = true
      assign has_horizon_mobile_quick_add = true
    endif

    assign product_card_anchor = 'teamakers-product-card-link-' | append: card_product.id | append: '-' | append: quick_add_section_id | md5
    assign image_count = 0
    for m in card_product.media
      if m.media_type == 'image'
        assign image_count = image_count | plus: 1
        if image_count == 2
          assign secondary_media = m
          break
        endif
      endif
    endfor
  endif

  assign eyebrow_text = eyebrow
  if eyebrow_text == blank and card_product != blank
    assign collection_link_metafield = card_product.metafields.custom.collection_link
    if collection_link_metafield != blank and collection_link_metafield.value != blank
      assign eyebrow_text = collection_link_metafield.value.title
      assign eyebrow_url = collection_link_metafield.value.url
    endif
  endif

  if eyebrow_text == blank and show_vendor and card_product != blank and card_product.vendor != blank
    assign eyebrow_text = card_product.vendor
    assign eyebrow_url = card_product.vendor | url_for_vendor
  endif
%}

<article
  class="teamakers-pick__card"
  {% if is_placeholder == false and card_product != blank %}
    aria-label="{{ card_product.title | escape }}"
  {% endif %}
>
  {% if is_placeholder == false and card_product != blank %}
    {% if use_horizon_quick_add %}
      <product-card
        class="teamakers-pick__horizon-product-card"
        data-product-id="{{ card_product.id }}"
      >
    {% endif %}
    <div
      class="teamakers-pick__image-wrap tup-country-flag-badge-host{% if secondary_media != blank %} teamakers-pick__image-wrap--has-secondary{% endif %}"
      {% if use_horizon_quick_add %}
        style="
          --quick-add-display: {% if has_horizon_quick_add %}flex{% else %}none{% endif %};
          --quick-add-mobile-display: {% if has_horizon_mobile_quick_add %}flex{% else %}none{% endif %};
          --quick-add-mobile-opacity: {% if has_horizon_mobile_quick_add %}1{% else %}0{% endif %};
          --padding-inline-end: 0px;
          --padding-block-end: 0px;
          --border-radius: var(--tp-img-radius, 10px);
        "
      {% endif %}
    >
      <a
        class="teamakers-pick__card-link"
        href="{{ card_link_url }}"
        {% if use_horizon_quick_add %}
          id="{{ product_card_anchor }}"
          ref="productCardLink"
        {% endif %}
      >
        {% if card_product.available == false %}
          <span class="teamakers-pick__pill teamakers-pick__pill--oos">Out of stock</span>
        {% elsif card_show_sale_badge and card_product.compare_at_price > card_product.price %}
          <span class="teamakers-pick__pill teamakers-pick__pill--sale">Sale</span>
        {% endif %}

        <span class="teamakers-pick__image-stack">
          {% if card_product.featured_media != blank %}
            {{
              card_product.featured_media
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '320,480,640,800,900',
                sizes: image_sizes,
                class: 'teamakers-pick__image teamakers-pick__image--primary',
                alt: card_product.title
            }}
          {% else %}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'teamakers-pick__image teamakers-pick__image--primary teamakers-pick__image-placeholder' }}
          {% endif %}

          {% if secondary_media != blank %}
            {{
              secondary_media
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '320,480,640,800,900',
                sizes: image_sizes,
                class: 'teamakers-pick__image teamakers-pick__image--secondary',
                alt: ''
            }}
          {% endif %}
        </span>
      </a>
      {% render 'tup-country-flag-badge', product_resource: card_product, position: 'bottom-left' %}

      {% if has_horizon_quick_add %}
        {% render 'quick-add',
          product: card_product,
          section_id: quick_add_section_id
        %}
      {% elsif show_quick_add and card_product.available and first_variant != blank %}
        <form method="post" action="{{ routes.cart_add_url }}" class="teamakers-pick__quick-add-form">
          <input type="hidden" name="id" value="{{ first_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            class="teamakers-pick__quick-add"
            aria-label="{{ 'products.product.add_to_cart' | t }}: {{ card_product.title | escape }}"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.5 7.5h11l-1.2 10.2a1 1 0 0 1-1 .8H8.7a1 1 0 0 1-1-.8L6.5 7.5Z" stroke="currentColor" stroke-width="1.5" />
              <path d="M9 7.5V6a3 3 0 1 1 6 0v1.5" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
        </form>
      {% endif %}
    </div>
    {% if use_horizon_quick_add %}
      </product-card>
    {% endif %}

    <div class="teamakers-pick__meta">
      {% if eyebrow_text != blank %}
        <p class="teamakers-pick__vendor">
          {% if eyebrow_url != blank %}
            <a href="{{ eyebrow_url }}" class="teamakers-pick__vendor-link">{{ eyebrow_text | escape }}</a>
          {% else %}
            {{ eyebrow_text | escape }}
          {% endif %}
        </p>
      {% endif %}

      <h3 class="teamakers-pick__name">
        <a href="{{ card_product.url }}">{{ card_product.title }}</a>
      </h3>

      {% if show_review %}
        {% if card_product != blank %}
          <div class="teamakers-pick__rating">
            {% render 'yotpo-rating-mount', product: card_product, instance_id: '824555', lazy: true %}
          </div>
        {% endif %}
      {% endif %}

      <p class="teamakers-pick__price">
        {%- render 'custom-inr-money', amount: card_product.price -%}
        {% if card_product.compare_at_price > card_product.price %}
          <s class="teamakers-pick__compare">{%- render 'custom-inr-money', amount: card_product.compare_at_price -%}</s>
        {% endif %}
      </p>
    </div>
  {% else %}
    <div class="teamakers-pick__image-wrap">
      {{ 'product-apparel-1' | placeholder_svg_tag: 'teamakers-pick__image teamakers-pick__image--primary teamakers-pick__image-placeholder' }}
    </div>
    <div class="teamakers-pick__meta">
      <p class="teamakers-pick__vendor">Tea label</p>
      <h3 class="teamakers-pick__name">Product title</h3>
      {% if show_review %}
        <p class="teamakers-pick__rating">
          <span class="teamakers-pick__rating-stars" aria-hidden="true">★★★★★</span>
          <span class="teamakers-pick__rating-value">4.5</span>
          <span class="teamakers-pick__rating-count">(0)</span>
        </p>
      {% endif %}
      <p class="teamakers-pick__price">{%- render 'custom-inr-money', amount: 5000 -%}</p>
    </div>
  {% endif %}
</article>
