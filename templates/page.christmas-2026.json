        "dilly": {
          "type": "character",
          "settings": {
            "name": "Dilly",
            "accessible_label": "Meet Dilly",
            "cta_label": "Meet Dilly →",
            "image": "shopify://shop_images/Dilly.webp",
            "spotlight_label": "Meet Dilly",
            "spotlight_tagline": "Small elephant. Very big personality.",
            "role": "Small elephant. Very big personality.",
            "story": "<p>Dilly is a rescued baby elephant, professional adventurer and enthusiastic giver of group hugs.</p><p>He loves his gang, loves saying thank you and occasionally gets the zoomies.</p><p>We should probably also mention that elephants get gassy. Sorry in advance.</p>",
            "real_heading": "Meet the Real Dilly",
            "real_story": "<p>Our little Dilly is inspired by a very real rescued elephant who was named Dilly by the Dilmah family in Australia. After being cared for and rehabilitated, he grew up and returned to the wild, where he belongs.</p><p>Dilmah continues to support the care and rehabilitation of orphaned baby elephants, helping give them another chance at life in the wild.</p>",
            "impact_heading": "",
            "impact_text": "",
            "organization_1_text": "",
            "organization_1_logo": "shopify://shop_images/Dilmah_Conservation_Logo_-_Medium_855e7192-5626-49c0-87bc-d30053586327.png",
            "organization_1_link": "https://www.dilmahconservation.org/",
            "organization_1_link_label": "Explore Conservation",
            "organization_2_text": "",
            "organization_2_logo": "shopify://shop_images/mjf-charitable-foundation-logo.png",
            "organization_2_link": "",
            "organization_2_link_label": "Explore Foundation",
            "cta_heading": "<p><em><strong>Want to support more cute, naughty and gassy baby elephants like Dilly?</strong></em></p>",
            "product_1": "a-variety-of-fine-teas-80-tea-bags-1",
            "product_2": "christmas-tea-advent-calendar",
            "cta_footnote": "Because your Dilmah gift helps us continue caring for elephants just like him.",
            "link": "",
            "drawer_button_label": "Shop now",
