        "aunty_kanthi": {
          "type": "character",
          "settings": {
            "name": "Aunty Kanthi",
            "accessible_label": "Meet Aunty Kanthi",
            "cta_label": "Meet Aunty Kanthi →",
            "image": "shopify://shop_images/Kanthi.webp",
            "spotlight_label": "Meet Aunty Kanthi",
            "spotlight_tagline": "Aunty Kanthi makes the best cookies in the world.",
            "role": "Aunty Kanthi makes the best cookies in the world.",
            "story": "<p>This information has been independently verified by Dilly. Several times.</p><p>She's warm, wonderful and usually carrying something delicious. Basically, exactly the sort of aunty you want in your gang.</p>",
            "real_heading": "Meet the Real Aunties",
            "real_story": "<p>Aunty Kanthi is inspired by Sandamali, Anjali and Anoja, three amazing women from the MJF Foundation's cookery programme.</p><p>The Foundation provides the kitchen, equipment and space they need to work their culinary magic.</p><p>Today, they cook for the Good Heart Café while also using their skills to build businesses and livelihoods of their own.</p><p>So yes, Aunty Kanthi may be animated. But the women behind her are very real.</p>",
            "impact_heading": "",
            "impact_text": "",
            "organization_1_text": "",
            "organization_1_link": "",
            "organization_1_link_label": "",
            "organization_2_text": "",
            "organization_2_link": "",
            "organization_2_link_label": "",
            "cta_heading": "<p><em><strong>Want to help more amazing aunties cook up something good?</strong></em></p>",
            "product_1": "",
            "product_2": "",
            "cta_footnote": "Because your Dilmah gift helps women turn skills, hard work and a good recipe into brighter futures.",
            "link": "",
            "drawer_button_label": "Explore their story",
            "x_position": 44,
            "mobile_x_position": 44,
            "y_position": 66,
