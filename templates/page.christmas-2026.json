        "lucky": {
          "type": "character",
          "settings": {
            "name": "Lucky",
            "accessible_label": "Meet Lucky",
            "cta_label": "Meet Lucky →",
            "image": "shopify://shop_images/Lucky.webp",
            "spotlight_label": "Meet Lucky",
            "spotlight_tagline": "Every gang needs someone who knows where they're going. Lucky occasionally does.",
            "role": "Every gang needs someone who knows where they're going. Lucky occasionally does.",
            "story": "<p>He's Dilly's best friend, fearless gang leader and the one responsible for getting everybody where they need to be.</p><p>Which is not easy when one member of your team is an elephant.</p>",
            "real_heading": "Meet the Real Kids Behind Lucky",
            "real_story": "<p>Lucky is inspired by Nethan, Lithika, Janiru and Shion, four young people from the MJF Kids Programme.</p><p>There, children get opportunities to learn, explore and discover what they're good at through maths, vocational training, life skills, scouting, Girl Guiding, aesthetic studies and more.</p><p>Because growing up should come with plenty of chances to find your own way.</p>",
            "impact_heading": "",
            "impact_text": "",
            "organization_1_text": "",
            "organization_1_link": "",
            "organization_1_link_label": "",
            "organization_2_text": "",
            "organization_2_link": "",
            "organization_2_link_label": "",
            "cta_heading": "<p><em><strong>Want to help more kids find their way?</strong></em></p>",
            "product_1": "85-reserve-ceylon-green-tea-with-mint-20-luxury-leaf-tea-bags",
            "product_2": "85-reserve-ceylon-spice-chai-20-luxury-leaf-tea-bags",
            "cta_footnote": "Because your Dilmah gift helps create more opportunities for children to learn, grow and discover what they can become.",
            "link": "",
            "drawer_button_label": "Explore their story",
            "x_position": 37,
            "mobile_x_position": 37,
            "y_position": 65,
