        "sammy": {
          "type": "character",
          "settings": {
            "name": "Sammy",
            "accessible_label": "Meet Sammy",
            "cta_label": "Meet Sammy →",
            "image": "shopify://shop_images/Sammy.webp",
            "spotlight_label": "Meet Sammy",
            "spotlight_tagline": "Sammy is the gang's brilliant young chef.",
            "role": "Sammy is the gang's brilliant young chef.",
            "story": "<p>Give her a kitchen, a few ingredients and approximately five minutes before Dilly starts asking when dinner is ready.</p><p>She is talented, ambitious and always cooking up something good.</p>",
            "real_heading": "Meet the Real Chefs Behind Sammy",
            "real_story": "<p>Sammy is inspired by Dilumika, Danushi and Rashmi, graduates of the Empower Culinary & Hospitality School run by the MJF Charitable Foundation.</p><p>Dilumika completed CLPC Batch 11. Danushi completed CLPC Batch 13. Rashmi completed Pastry & Bakery Batch 01.</p><p>They trained. They qualified. They graduated with flying colours. And now they're turning those skills into careers in professional kitchens.</p><p>Which means Sammy has some fairly serious culinary credentials behind her.</p>",
            "impact_heading": "",
            "impact_text": "",
            "organization_1_text": "",
            "organization_1_link": "",
            "organization_1_link_label": "",
            "organization_2_text": "",
            "organization_2_link": "",
            "organization_2_link_label": "",
            "cta_heading": "<p><em><strong>Want to help more young talent get cooking?</strong></em></p>",
            "product_1": "",
            "product_2": "",
            "cta_footnote": "Because your Dilmah gift helps young people gain professional skills and turn opportunity into a career.",
            "link": "",
            "drawer_button_label": "Explore their story",
