        "cleo_lucas": {
          "type": "character",
          "settings": {
            "name": "Cleo & Lucas",
            "accessible_label": "Meet Cleo and Lucas",
            "cta_label": "Meet Cleo & Lucas →",
            "image": "shopify://shop_images/Cleo-_-Lucas.webp",
            "spotlight_label": "Meet Cleo & Lucas",
            "spotlight_tagline": "Meet Cleo and her little cub, Lucas.",
            "role": "Meet Cleo and her little cub, Lucas.",
            "story": "<p>Cleo is graceful, watchful and quietly in charge. Lucas is curious, adventurous and considerably less quietly in charge.</p><p>Dilly would also like it officially recorded that Lucas is a drool machine. We have been unable to independently verify this.</p>",
            "real_heading": "Meet the Real Inspiration",
            "real_story": "<p>Cleo and Lucas are inspired by Sri Lanka's magnificent leopards.</p><p>At Queensberry Estate, camera traps help researchers quietly observe how leopards move through and use the landscape, helping us better understand these remarkable animals.</p><p>And through conservation work such as the Endane Nature Corridor, fragmented forests are being reconnected to give wildlife more room to move.</p><p>Even their names have a wild story behind them. Cleo and Lucas are named in tribute to two well-known leopards of Yala National Park.</p>",
            "impact_heading": "",
            "impact_text": "",
            "organization_1_text": "",
            "organization_1_link": "",
            "organization_1_link_label": "",
            "organization_2_text": "",
            "organization_2_link": "",
            "organization_2_link_label": "",
            "cta_heading": "<p><em><strong>Want to help keep things wild?</strong></em></p>",
            "product_1": "",
            "product_2": "",
            "cta_footnote": "Because your Dilmah gift helps support conservation work that protects wildlife and the places they call home.",
