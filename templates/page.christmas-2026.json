        "uncle_laksiri": {
          "type": "character",
          "settings": {
            "name": "Uncle Laksiri",
            "accessible_label": "Meet Uncle Laksiri",
            "cta_label": "Meet Uncle Laksiri →",
            "image": "shopify://shop_images/Laksiri.webp",
            "spotlight_label": "Meet Uncle Laksiri",
            "spotlight_tagline": "If it has wheels, Uncle Laksiri can probably fix it.",
            "role": "If it has wheels, Uncle Laksiri can probably fix it.",
            "story": "<p>Bicycles. Wheelchairs. Probably Dilly's scooter, if we ever make the mistake of buying him one.</p><p>He's our resident wizard with a spanner and the Kindness Gang's undisputed king of keeping things moving.</p>",
            "real_heading": "Meet the Two Very Handy Uncles Behind Him",
            "real_story": "<p>Uncle Laksiri is inspired by not one handy gentleman, but two.</p><p>Lasantha is a wheelchair mechanic who can tackle just about any problem and help keep chairs, and the people who depend on them, rolling.</p><p>Rahulakumar is our bicycle wizard of the east and one of the longest-active members of the Small Entrepreneurship Programme. His workshop is basically a hospital for broken bicycles. No appointment necessary.</p>",
            "impact_heading": "",
            "impact_text": "",
            "organization_1_text": "",
            "organization_1_link": "",
            "organization_1_link_label": "",
            "organization_2_text": "",
            "organization_2_link": "",
            "organization_2_link_label": "",
            "cta_heading": "<p><em><strong>Want to help more people keep moving forward?</strong></em></p>",
            "product_1": "",
            "product_2": "",
            "cta_footnote": "Because your Dilmah gift helps people build skills, livelihoods and greater independence.",
