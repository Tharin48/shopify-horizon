        "hero_text": {
          "type": "hero_text",
          "settings": {
            "eyebrow": "About US",
            "heading_source": "custom",
            "custom_heading": "Who We Are",
            "intro": "<p><strong>Dilmah</strong> was founded by master teamaker Merrill J Fernando on a lifelong passion to share the finest Ceylon tea with the world while making business a matter of human service. Today, his sons Dilhan & Malik, and the next generation of the Fernando family continue this legacy, remaining true to the values that have guided us from the beginning; authenticity, quality and kindness to the craft of tea, the people and the nation that nurture it. As the world’s first producer-owned tea brand, Dilmah pioneered Single Origin Tea in 1985, bringing tea that is picked, perfected and packed at source, empowering Sri Lankan tea growers while preserving the character of our island’s finest gardens.</p>"
          }
        },
        "hero_image": {
          "type": "hero_image",
          "settings": {
            "image": "shopify://shop_images/bbba18e68d1f40ed389f8ecc34eaa11385481c73.jpg",
            "image_position": "right center",
            "use_section_radius": true,
            "border_radius": 28
          }
        }
