        "text_content_gChnUT": {
          "type": "text_content",
          "settings": {
            "column": "left",
            "eyebrow": "",
            "heading": "<h2>Why <br/><em>Dilmah</em> <br/>Was Created</h2>",
            "text": "<p>For Merrill J. Fernando, tea was more than just a commodity; it was a way to serve humanity. He wanted to bring a cup of tea that wasn't just healthy and delicious, but also ethically sound.<br/><br/>The vision was to create a business that was a matter of human service. This philosophy continues to guide everything we do today, through our MJF Charitable Foundation and Dilmah Conservation.</p>"
          }
        },
        "quote_card_tcQqRn": {
          "type": "quote_card",
          "settings": {
            "column": "right",
            "quote": "<p>\"Business is a matter of human service. To share the success of my business with the less fortunate, the poor and the needy.\"</p>",
            "author": "Merrill J. Fernando",
            "background_color": "",
            "border_color": ""
          }
        }
