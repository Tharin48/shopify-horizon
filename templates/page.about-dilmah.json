          "settings": {
            "icon": "shopify://shop_images/vfwsatwayfmmmu760lm_1.svg",
            "heading": "Packaged Fresh At The Source",
            "text": "<p>Garden fresh, unblended tea is a hallmark of Dilmah and offers a unique taste of unblended Ceylon Tea packed at source.</p>"
          }
        },
        "feature_item_fJVDRF": {
          "type": "feature_item",
          "settings": {
            "icon": "shopify://shop_images/3sy3aj7zdzjmmu76l9w_1.svg",
            "heading": "Climate & Plastic Neutral",
            "text": "<p>We started our sustainability journey in 2000, since then we have eliminated 421,052Kgs of plastics.</p>"
          }
        },
        "feature_item_EGpxmD": {
          "type": "feature_item",
