{% liquid
  assign s = block.settings
  assign preview_image = s.image
  assign section_index = section.index | default: 99

  assign text_align = 'start'
  case s.content_horizontal_alignment
    when 'center'
      assign text_align = 'center'
    when 'flex-end'
      assign text_align = 'end'
  endcase

  assign grid_align_self = 'center'
  case s.content_vertical_position
    when 'flex-start'
      assign grid_align_self = 'start'
    when 'flex-end'
      assign grid_align_self = 'end'
    when 'center'
      assign grid_align_self = 'center'
  endcase

  assign vertical_mobile = s.content_vertical_position_mobile | default: s.content_vertical_position
  assign grid_align_self_mobile = 'center'
  case vertical_mobile
    when 'flex-start'
      assign grid_align_self_mobile = 'start'
    when 'flex-end'
      assign grid_align_self_mobile = 'end'
    when 'center'
      assign grid_align_self_mobile = 'center'
  endcase

  assign grid_justify_self = 'start'
  case s.content_horizontal_alignment
    when 'flex-start'
      assign grid_justify_self = 'start'
    when 'flex-end'
      assign grid_justify_self = 'end'
    when 'center'
      assign grid_justify_self = 'center'
  endcase

  assign horizontal_mobile = s.content_horizontal_alignment_mobile | default: s.content_horizontal_alignment

  assign text_align_mobile = 'start'
  case horizontal_mobile
    when 'center'
      assign text_align_mobile = 'center'
    when 'flex-end'
      assign text_align_mobile = 'end'
  endcase

  assign grid_justify_self_mobile = 'start'
  case horizontal_mobile
    when 'flex-start'
      assign grid_justify_self_mobile = 'start'
    when 'flex-end'
      assign grid_justify_self_mobile = 'end'
    when 'center'
      assign grid_justify_self_mobile = 'center'
  endcase

  assign loading = 'lazy'
  if section_index <= 3
    assign loading = 'eager'
  endif

  assign fetchpriority = 'low'
  if section_index == 1
    assign fetchpriority = 'high'
  endif
%}

<div class="impact-slide" {{ block.shopify_attributes }}>
  <div class="slide__image-container{% if s.toggle_overlay %} slide__image-container--overlay{% endif %}">
    {%- if s.toggle_overlay -%}
      {% render 'overlay', settings: s %}
    {%- endif -%}
    {%- if preview_image != blank -%}
      {%- liquid
        assign height = preview_image.width | divided_by: preview_image.aspect_ratio | round
        assign sizes = '100vw'
        assign widths = '832, 1200, 1600, 1920, 2560, 3840'
      -%}
      {{
        preview_image
        | image_url: width: 3840
        | image_tag:
          height: height,
          sizes: sizes,
          widths: widths,
          class: 'slide__image',
          loading: loading,
          fetchpriority: fetchpriority,
          alt: preview_image.alt | default: s.heading | escape
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'slide__image' }}
    {%- endif -%}
  </div>

  <div
    class="spacing-style slide__content impact-slide__content{% if s.inherit_color_scheme == false %} color-{{ s.color_scheme }}{% endif %}{% if preview_image != blank or s.toggle_overlay %} background-transparent{% endif %}"
    style="
      {% render 'spacing-style', settings: s %}
      --impact-slide-align-self: {{ grid_align_self }};
      --impact-slide-align-self-mobile: {{ grid_align_self_mobile }};
      --impact-slide-justify-self: {{ grid_justify_self }};
      --impact-slide-justify-self-mobile: {{ grid_justify_self_mobile }};
      --impact-slide-align: {{ s.content_horizontal_alignment }};
      --impact-slide-align-mobile: {{ horizontal_mobile }};
      --impact-slide-text-align: {{ text_align }};
      --impact-slide-text-align-mobile: {{ text_align_mobile }};
    "
  >
    <div class="impact-slide__inner">
      {% if s.show_heading and s.heading != blank %}
        <h3 class="impact-slide__heading">{{ s.heading | escape }}</h3>
      {% endif %}
      {% if s.show_subheading and s.subheading != blank %}
        <p class="impact-slide__subheading">{{ s.subheading | escape }}</p>
      {% endif %}
      {% if s.show_button and s.button_label != blank %}
        {% if s.button_link != blank %}
          <a
            class="button impact-slide__button"
            href="{{ s.button_link }}"
          >
            {{ s.button_label | escape }}
          </a>
        {% else %}
          <span class="button impact-slide__button is-disabled" role="link" aria-disabled="true">
            {{ s.button_label | escape }}
          </span>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>
<!--IMPACT_SLIDE_BOUNDARY-->

{% stylesheet %}
  .impact-slide {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
  }

  /*
   * Single-cell grid + align-self / justify-self: reliable top/center/bottom and
   * left/center/right even when slideshow-slide height / % chains are flaky in the editor.
   * (Flex + justify-content on this layer was collapsing or fighting other rules.)
   */
  .impact-slide__content {
    position: relative;
    z-index: var(--layer-flat);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    height: 100%;
    min-height: 100%;
    box-sizing: border-box;
    text-align: var(--impact-slide-text-align, start);
  }

  /*
   * Horizon’s _slide block sets .slide__content > * { margin: auto }, which also matches
   * Impact slides (they reuse .slide__content). Auto margins break grid self-alignment.
   */
  .impact-slide > .slide__content.impact-slide__content > * {
    margin-block: 0;
    margin-inline: 0;
  }

  .impact-slide__inner {
    grid-column: 1;
    grid-row: 1;
    align-self: var(--impact-slide-align-self, center);
    justify-self: var(--impact-slide-justify-self, start);
    min-width: 0;
    max-width: 36rem;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: var(--impact-slide-align, flex-start);
    gap: 0.75rem;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .impact-slide__heading {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    line-height: 1.1;
  }

  .impact-slide__subheading {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    opacity: 0.92;
  }

  .impact-slide__button.is-disabled {
    pointer-events: none;
    opacity: 0.65;
  }

  .impact-slide__content.background-transparent {
    background-color: transparent;
  }

  .impact-slide .slide__content {
    @supports (animation-timeline: auto) {
      opacity: 0;
      animation: slide-reveal both linear;
      animation-timeline: var(--slideshow-timeline);
    }

    @media (prefers-reduced-motion) {
      opacity: 1;
      animation: none;
    }
  }

  slideshow-component[refreshing-timeline] .impact-slide .slide__content {
    animation: none;
  }

  slideshow-slide > .impact-slide > .slide__image-container {
    display: flex;
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: absolute;
    inset: 0;
  }

  .impact-slide .slide__image-container > .slide__image {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  @media screen and (max-width: 749px) {
    .impact-slide__content {
      text-align: var(
        --impact-slide-text-align-mobile,
        var(--impact-slide-text-align, start)
      );
    }

    .impact-slide__inner {
      align-self: var(
        --impact-slide-align-self-mobile,
        var(--impact-slide-align-self, center)
      );
      justify-self: var(
        --impact-slide-justify-self-mobile,
        var(--impact-slide-justify-self, start)
      );
      align-items: var(
        --impact-slide-align-mobile,
        var(--impact-slide-align, flex-start)
      );
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Impact slide",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Slide heading",
      "visible_if": "{{ block.settings.show_heading }}"
    },
    {
      "type": "checkbox",
      "id": "show_subheading",
      "label": "Show subheading",
      "default": true
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add supporting text for this slide.",
      "visible_if": "{{ block.settings.show_subheading }}"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now",
      "visible_if": "{{ block.settings.show_button }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "visible_if": "{{ block.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_horizontal_alignment",
      "label": "Horizontal position (desktop)",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "content_horizontal_alignment_mobile",
      "label": "Horizontal position (mobile)",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "content_vertical_position",
      "label": "Vertical position (desktop)",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-end"
    },
    {
      "type": "select",
      "id": "content_vertical_position_mobile",
      "label": "Vertical position (mobile)",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-end"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "Inherit color scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "Media overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "alpha": true,
      "default": "#00000066",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient direction",
      "options": [
        { "value": "to top", "label": "Up" },
        { "value": "to bottom", "label": "Down" }
      ],
      "default": "to top",
      "visible_if": "{{ block.settings.toggle_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
