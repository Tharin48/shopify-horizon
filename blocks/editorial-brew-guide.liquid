{% liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign brew_vessel = product_resource.metafields.editorial.brew_vessel.value | default: product_resource.metafields.editorial.brew_vessel
  assign brew_temperature_c = product_resource.metafields.editorial.brew_temperature_c.value | default: product_resource.metafields.editorial.brew_temperature_c
  assign brew_tea_grams = product_resource.metafields.editorial.brew_tea_grams.value | default: product_resource.metafields.editorial.brew_tea_grams
  assign brew_water_ml = product_resource.metafields.editorial.brew_water_ml.value | default: product_resource.metafields.editorial.brew_water_ml
  assign brew_time_seconds = product_resource.metafields.editorial.brew_time_seconds.value | default: product_resource.metafields.editorial.brew_time_seconds
  assign brew_resteeps = product_resource.metafields.editorial.brew_resteeps.value | default: product_resource.metafields.editorial.brew_resteeps

  assign has_content = false
  if brew_vessel != blank
    assign has_content = true
  elsif brew_temperature_c != blank
    assign has_content = true
  elsif brew_tea_grams != blank
    assign has_content = true
  elsif brew_water_ml != blank
    assign has_content = true
  elsif brew_time_seconds != blank
    assign has_content = true
  elsif brew_resteeps != blank
    assign has_content = true
  endif
%}

{% if has_content or request.visual_preview_mode %}
  <div
    class="editorial-brewing-guide-summary spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {% if block_settings.heading != blank %}
      <p class="editorial-brewing-guide-summary__heading">{{ block_settings.heading | escape }}</p>
    {% endif %}

    <dl class="editorial-brewing-guide-summary__list">
      {% if brew_vessel != blank or request.visual_preview_mode %}
        <div class="editorial-brewing-guide-summary__item">
          <dt>Vessel</dt>
          <dd>{{ brew_vessel | default: 'Brewing vessel' }}</dd>
        </div>
      {% endif %}

      {% if brew_temperature_c != blank or request.visual_preview_mode %}
        <div class="editorial-brewing-guide-summary__item">
          <dt>Temperature</dt>
          <dd>{{ brew_temperature_c | default: 90 }}{% if brew_temperature_c != blank or request.visual_preview_mode %}C{% endif %}</dd>
        </div>
      {% endif %}

      {% if brew_tea_grams != blank or request.visual_preview_mode %}
        <div class="editorial-brewing-guide-summary__item">
          <dt>Tea</dt>
          <dd>{{ brew_tea_grams | default: '5' }}g</dd>
        </div>
      {% endif %}

      {% if brew_water_ml != blank or request.visual_preview_mode %}
        <div class="editorial-brewing-guide-summary__item">
          <dt>Water</dt>
          <dd>{{ brew_water_ml | default: 120 }}ml</dd>
        </div>
      {% endif %}

      {% if brew_time_seconds != blank or request.visual_preview_mode %}
        <div class="editorial-brewing-guide-summary__item">
          <dt>Steep</dt>
          <dd>{{ brew_time_seconds | default: 20 }}s</dd>
        </div>
      {% endif %}

      {% if brew_resteeps != blank or request.visual_preview_mode %}
        <div class="editorial-brewing-guide-summary__item">
          <dt>Resteeps</dt>
          <dd>{{ brew_resteeps | default: 5 }}</dd>
        </div>
      {% endif %}
    </dl>
  </div>
{% endif %}

{% stylesheet %}
  .editorial-brewing-guide-summary {
    width: 100%;
  }

  .editorial-brewing-guide-summary__heading {
    margin: 0 0 var(--padding-sm);
    font-size: var(--font-paragraph-small--size);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .editorial-brewing-guide-summary__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-sm) var(--gap-md);
    margin: 0;
  }

  .editorial-brewing-guide-summary__item {
    min-width: 0;
  }

  .editorial-brewing-guide-summary__item dt {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    margin: 0 0 var(--padding-3xs);
  }

  .editorial-brewing-guide-summary__item dd {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial brewing summary",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Specs grid from editorial.* metafields. For Hot/Cold tabs and step cards, use Add block - Brewing tabs, then add Brewing step blocks inside it."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brewing guide"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Editorial brewing summary",
      "category": "Product"
    }
  ]
}
{% endschema %}
