

{%- assign block_settings = block.settings -%}
{%- assign plain_text = block_settings.text | strip_newlines | strip_html | strip -%}
{%- assign block_index = section.blocks | find_index: 'id', block.id -%}

{%- unless plain_text == '' -%}
  <slideshow-slide
    ref="slides[]"
    class="
      announcement-bar__slide
      text-block
      text-block--{{ block.id }}
      text-block--align-center
      text-block--full-width
      custom-typography
      {% if block_settings.font_size != "" %}custom-font-size{% endif %}
      {% if block_settings.weight != "" %}custom-font-weight{% endif %}
    "
    style="
      {% render 'typography-style', settings: block_settings, preset: 'custom' %}
      --width: 100%;
      --text-align: center;
      --line-height: 1;
    "
    {{ block.shopify_attributes }}
    aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  >
    {% if block.settings.enable_shipping_progress_bar %}
      <p class="announcement-bar__text" data-shipping-progress data-shipping-text="{{ block.settings.shipping_progress_text }}" data-country="{{ localization.country.currency.iso_code }}"
        {% if localization.country.currency.iso_code == 'CLP' %}
          data-shipping-min="{{ block.settings.shipping_minimum_value  | times: 1000}}"
        {% else %}
          data-shipping-min="{{ block.settings.shipping_minimum_value}}"
        {% endif %}
      data-how-far="{{ block.settings.shipping_progress_text_how_far }}" data-eligible="{{ block.settings.shipping_progress_text_eligible }}">
        {{ block.settings.shipping_progress_text | replace: "__value__" , block.settings.shipping_minimum_value}}
      </p>
    {% endif %}
    
    {% if block.settings.enable_shipping_progress_bar == false%}
      <p class="announcement-bar__text">
        {{ block.settings.text }}
      </p>

      {% if block_settings.link != blank %}
        <a
          class="announcement-bar__link"
          href="{{ block_settings.link }}"
        >
          <span class="visually-hidden">
            {{ block_settings.text | strip_html }}
          </span>
        </a>
      {% endif %}
    {% endif %}
  </slideshow-slide>
{%- endunless -%}

{% stylesheet %}
  .text-block:not(.text-block--full-width).rte,
  .text-block:not(.text-block--full-width).paragraph {
    /* Safari doesn't support pretty, so fallback to balance */
    text-wrap: balance;
    text-wrap: pretty;
  }

  .text-block:not(.text-block--full-width).h1,
  .text-block:not(.text-block--full-width).h2,
  .text-block:not(.text-block--full-width).h3,
  .text-block:not(.text-block--full-width).h4,
  .text-block:not(.text-block--full-width).h5,
  .text-block:not(.text-block--full-width).h6 {
    text-wrap: balance;
  }

  /* Hide underline unless text is using paragraph styles. */
  .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) a {
    text-decoration-color: transparent;
  }

  .text-block h1,
  .text-block.h1 > * {
    margin-block: var(--font-h1--spacing);
  }

  .text-block h2,
  .text-block.h2 > * {
    margin-block: var(--font-h2--spacing);
  }

  .text-block h3,
  .text-block.h3 > * {
    margin-block: var(--font-h3--spacing);
  }

  .text-block h4,
  .text-block.h4 > * {
    margin-block: var(--font-h4--spacing);
  }

  .text-block h5,
  .text-block.h5 > * {
    margin-block: var(--font-h5--spacing);
  }

  .text-block h6,
  .text-block.h6 > * {
    margin-block: var(--font-h6--spacing);
  }

  .text-block > *:first-child {
    margin-block-start: 0;
  }

  .text-block > *:last-child {
    margin-block-end: 0;
  }

  .text-block--align-center,
  .text-block--align-center > * {
    margin-inline: auto;
  }

  .text-block--align-right,
  .text-block--align-right > * {
    margin-inline-start: auto;
  }
{% endstylesheet %}


{% javascript %}
  (function () {
    function formatShippingMoney(cents, currency) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function' && window.theme?.moneyFormat) {
        return Shopify.formatMoney(cents, window.theme.moneyFormat);
      }
      return new Intl.NumberFormat(document.documentElement.lang || 'en', {
        style: 'currency',
        currency: currency || 'USD'
      }).format(cents / 100);
    }

    function updateShippingTextDrawer(value = "") {
      console.log(value)
      setTimeout(() => {
        document.querySelectorAll(".ecom-shipping").forEach((el) => {
          el.innerHTML = `<span>${value}</span>`
        });
      }, 1500);
    }

    function updateShippingProgress(cart) {
      if (!cart) return;

      if(cart.item_count == 0 ) {
        const shippingElem = document.querySelector('[data-shipping-progress]');
        return updateShippingTextDrawer(shippingElem.textContent);
      }

      document.querySelectorAll('[data-shipping-progress]').forEach((el) => {
        const minValue = parseFloat(el.dataset.shippingMin);
        if (isNaN(minValue)) return;

        const minCents = minValue * 100;
        const remainingCents = minCents - cart.total_price;

        if (remainingCents > 0) {
          const formatted = formatShippingMoney(remainingCents, cart.currency);
          el.textContent = (el.dataset.howFar || '').replace('__value__', formatted);
          updateShippingTextDrawer((el.dataset.howFar || '').replace('__value__', '<b>'+formatted+'</b>'));
        } else {
          el.textContent = el.dataset.eligible || '';
          updateShippingTextDrawer(el.textContent);
        }
      });
    }

    function initShippingProgress() {
      // Skip the fetch entirely if no shipping progress element is on the page
      if (!document.querySelector('[data-shipping-progress]')) return;

      const cartUrl = `${window.Shopify?.routes?.root || '/'}cart.js`;

      fetch(cartUrl, { headers: { 'Content-Type': 'application/json' } })
        .then((response) => {
          if (!response.ok) throw new Error('Failed to fetch cart');
          return response.json();
        })
        .then((cart) => updateShippingProgress(cart))
        .catch((error) => {
          console.error('Shipping progress bar: could not load cart on init', error);
        });
    }

    document.addEventListener('cart:update', (event) => {
      updateShippingProgress(event.detail?.resource);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShippingProgress);
    } else {
      initShippingProgress();
    }
  })();
{% endjavascript %}

