{% doc %}
  Button block that now uses the shared `snippets/button.liquid` component.
  Schema is retained so existing instances keep working.
{% enddoc %}

{% render 'button', block: block, link: block.settings.link %}

{% schema %}
{
  "name": "Icon button",
  "tag": null,
  "class": "icon-button-block-root",
  "settings": [
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "width_mode",
      "label": "Button width",
      "options": [
        {
          "value": "auto",
          "label": "Auto (fit content)"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "percent",
          "label": "Percentage of row"
        }
      ],
      "default": "percent",
      "info": "Auto sizes to the label and icon. Full spans the block. Percentage sets a fixed share of the row (desktop)."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ block.settings.width_mode == 'percent' }}"
    },
    {
      "type": "checkbox",
      "id": "full_width_mobile_tablet",
      "label": "Full width on mobile and tablet (≤989px)",
      "default": true,
      "visible_if": "{{ block.settings.width_mode == 'auto' or block.settings.width_mode == 'percent' }}",
      "info": "When on, the button spans the row on small screens. Turn off to keep Auto or the same percentage at every size."
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "paragraph",
      "content": "Uses the same icon set as the Icon block (snippets/icon.liquid). Upload a custom image below to override."
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "arrow", "label": "Arrow" },
        { "value": "heart", "label": "Heart" },
        { "value": "star", "label": "Star" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "plant", "label": "Plant" },
        { "value": "box", "label": "Box" },
        { "value": "price_tag", "label": "Price tag" },
        { "value": "truck", "label": "Truck" },
        { "value": "return", "label": "Return" },
        { "value": "chat_bubble", "label": "Chat" },
        { "value": "check_box", "label": "Check" },
        { "value": "question_mark", "label": "Question" },
        { "value": "lock", "label": "Lock" },
        { "value": "map_pin", "label": "Map pin" },
        { "value": "plane", "label": "Plane" },
        { "value": "recycle", "label": "Recycle" }
      ],
      "default": "arrow"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom icon image",
      "info": "Optional. Replaces the selected icon when set."
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Space between icon and label",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "Button colors",
      "options": [
        {
          "value": "primary_button",
          "label": "Primary button (theme)"
        },
        {
          "value": "secondary_button",
          "label": "Secondary button (theme)"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "primary_button",
      "info": "Theme options use the color scheme in this section (or the scheme selected above when “Inherit color scheme” is off)."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#121212",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#121212",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "hover_background",
      "label": "Hover background",
      "default": "#333333",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "Hover text",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "hover_border_color",
      "label": "Hover border",
      "default": "#333333",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Icon button",
      "category": "t:categories.basic",
      "settings": {
        "label": "Shop now",
        "icon": "arrow",
        "inherit_color_scheme": true,
        "color_mode": "primary_button",
        "width_mode": "percent",
        "full_width_mobile_tablet": true
      }
    }
  ]
}
{% endschema %}
