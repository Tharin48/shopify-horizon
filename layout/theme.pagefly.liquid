{% comment %}
This file is auto-generated by PageFly. The content can be overridden when publish page in PageFly. Please do not update this file directly.
If you plan to remove PageFly, please see the guide in our help center first: https://help.pagefly.io/.
{% endcomment %}
<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'seo-title-description' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} View-transition render blocker: product pages only so homepage hard refresh is not delayed. {% endcomment %}
    {% if settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% elsif settings.transition_to_main_product and template.name == 'product' %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'critical-inline-css' -%}
    {%- render 'fonts' -%}
    {%- render 'stylesheets' -%}
    {%- render 'color-schemes' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'theme-font-faces-primary' -%}
    {%- render 'critical-stylesheets' -%}
    {%- render 'importmap' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}
  {% include 'pagefly-app-header' %}</head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}"><div class="pagefly-container">
              {{ content_for_layout }}
            </div></body>
</html>
